"""
Manage Dagger modules and module clients that use the Go SDK.
"""
type GoSdk {
  """Runtime SDK override, independent of a target's schema version. Unified outputs default to a published immutable runtime; legacy outputs retain their schema pin."""
  clientVersion: String! = ""

  """
  Reuse dagger.io/dagger/core types and one lazy shared session. Unset uses
  unified clients for new entrypoint modules, while retaining the mode of
  existing embedded and standalone packages. Explicit false keeps
  embedded bindings; explicit true migrates them to shared core types.
  Migrating embedded bindings also requires dangEntrypoint = true.
  """
  unifiedClients: Boolean

  """
  Generate the module's global `dag` for author code that still needs it.
  It is omitted by default. Unified modules use core constructors such as
  core.NewContainer() and dependency client constructors such as
  mydep.New(); embedded bindings use dagger.Connect().
  This setting applies to Dang entrypoints. Legacy runtime codegen keeps
  its existing global API.
  """
  globalClient: Boolean
  """
  Starter template used when a new module scope is initialized.

  Valid values are `default`, `empty`, and `legacy`.
  """
  template: String! = "default"

  """
  Generate a fat module that also writes the legacy dagger.json manifest.
  The SDK-module interface requires Dagger v1.0.0-beta.12 or later.
  """
  fat: Boolean! = false

  """Write selected dependency commits to the module manifests."""
  lock: Boolean! = false

  """
  In module scopes, generate each client two times: one for the module and
  one standalone. Non-module scopes always generate standalone clients.

  Temporary: this setting will be removed when the two clients become one.
  """
  dualClients: Boolean! = false

  """
  Generate a Dang entrypoint and a static dispatch command, so the engine
  loads the module's types without running it. Supports package main and
  importable packages with a go.mod in the module directory. The entrypoint
  needs Dagger v1.0.0-beta.18 or later; older engines refuse it at load with
  `field "types": missing argument "workspace" required by interface`.
  Unset enables entrypoints for new modules and keeps the runner of existing
  modules. Explicit true migrates a supported existing module; false keeps the
  Go runtime. A migrated module whose code uses the global `dag` also needs
  globalClient = true.

  The entrypoint's sources function returns what the build reads: the module
  directory and the files outside it that reach the build through the local
  replace directives of go.mod. Generation finds the go.mod of each replace
  target the module requires, the Go files of each package it imports from
  one, and the files those packages embed, and writes their patterns into
  sources. The engine calls sources when it loads the module and reuses
  function results until a file that sources returns changes; exported
  functions need no workspace argument for the build. Generation computes the
  patterns, so run `dagger generate` again after changing the replace
  directives, the imports from a replace target, or the embeds of an imported
  package. Other files outside the module directory are not available when a
  function runs: reading one fails with `open ../x: no such file or
  directory`. Local replace targets must stay inside the workspace. See
  docs/outside-files.md for an example.
  """
  dangEntrypoint: Boolean

  """Find the nearest Go module root from Workspace.cwd. Return null if no go.mod exists."""
  findClientRoot(ws: Workspace!): String {
    # A host-backed workspace's findUp stats the host. A new go.mod can
    # exist only in the workspace edits until those edits are applied.
    if (exists(ws, "go.mod")) {
      return normalizePath(ws.cwd)
    }
    let goMod = ws.findUp("go.mod")
    if (goMod == null) {
      null
    } else {
      configDir(goMod, "go.mod")
    }
  }

  """
  Generate the complete module and client state for one SDK scope.

  Module scopes use the built-in Go module generator. With dualClients, they
  also generate standalone clients in their nearest Go scope. Non-module
  scopes always generate standalone clients. With dangEntrypoint, module
  scopes get a Dang entrypoint and a manifest that names it instead of a
  runtime.
  """
  generateScope(
    ws: Workspace!,
    isModule: Boolean!,
    name: String!,
    clients: [ModuleSource!]!,
  ): Workspace! {
    let hadManifest = exists(ws, "dagger-module.toml") or exists(ws, "dagger.json")
    let entrypoint = isModule and usesEntrypoint(ws, hadManifest)
    let unified = usesUnifiedModule(ws, entrypoint)
    if (isModule and !entrypoint and globalClient == false) {
      raise "globalClient = false requires dangEntrypoint = true; legacy Go runtime codegen retains its global client"
    }
    if (isModule and !entrypoint and unified and !hasCustomRunner(ws)) {
      raise "unifiedClients = true requires dangEntrypoint = true for embedded module bindings; built-in Go runtime codegen cannot generate shared core types"
    }
    let initialized = if (isModule and !hadManifest and !hasGoSource(ws)) {
      ws.withDirectory(".", renderedTemplate(ws, name, template, entrypoint, unified))
    } else {
      ws
    }
    if (isModule) {
      checkEntrypointScope(initialized, hadManifest, clients, entrypoint, unified)
    }

    if (isModule and entrypoint) {
      let withClients = if (unified) {
        generateStandaloneClients(initialized, clients, true)
      } else { initialized }
      entrypointModule(withClients, name, unified)
    } else if (isModule and hasCustomRunner(initialized)) {
      # A runtime or entrypoint the user chose remains theirs. Only explicitly
      # requested standalone clients are generated beside it.
      if (clients.length == 0) { initialized } else {
        generateStandaloneClients(initialized, clients, false)
      }
    } else if (isModule) {
      let configured = generatedManifest(initialized, name, clients)
      let generated = configured.withDirectory(".", generatedModuleCode(configured))
      # generatedModuleCode excludes manifests, so the configured ones survive
      # the merge. Rewriting them here would repeat the same workspace edit.
      if (dualClients) {
        generateStandaloneClients(generated, clients, false)
      } else {
        generated
      }
    } else {
      # Standalone clients are the only output here, so dualClients does not apply.
      generateStandaloneClients(initialized, clients, false)
    }
  }

  """Choose the new layout for fresh modules and retain existing runners."""
  let usesEntrypoint(ws: Workspace!, hadManifest: Boolean!): Boolean! {
    if (dangEntrypoint != null) {
      dangEntrypoint ?? false
    } else if (hadManifest) {
      hasGeneratedEntrypoint(ws)
    } else {
      !fat and template != "legacy"
    }
  }

  """
  Go files in the scope directory. A starter template written over them
  would replace the author's code.
  """
  let hasGoSource(ws: Workspace!): Boolean! {
    ws.directory(".", include: ["*.go"]).glob(pattern: "*.go").length > 0
  }

  """Existing embedded bindings keep their API unless migration is requested."""
  let usesUnifiedModule(ws: Workspace!, entrypoint: Boolean!): Boolean! {
    if (unifiedClients != null) { return unifiedClients ?? false }
    if (!entrypoint) { return false }
    if (exists(ws, "internal/dagger/dagger.gen.go")) {
      ws.file("internal/dagger/dagger.gen.go").contents.contains("dagger.DefaultGraphQLClient(")
    } else { true }
  }

  """The SDK's generated entrypoint, rather than a runner chosen by the user."""
  let hasGeneratedEntrypoint(ws: Workspace!): Boolean! {
    let optionalManifest = decodedManifest(ws)
    if (optionalManifest == null) { return false }
    let manifest = optionalManifest :: Dagger.JSONValue!
    if (manifest.fields.contains("entrypoint") == false) { return false }
    let entrypoint = manifest.field(["entrypoint"])
    stringField(entrypoint, "kind") == "dang" and
      normalizePath(stringField(entrypoint, "source")) == entrypointPath and
      ownsEntrypoint(ws)
  }

  let ownsEntrypoint(ws: Workspace!): Boolean! {
    let path = entrypointPath + "/main.dang"
    if (exists(ws, path)) {
      # A user replacing the file takes precedence over old ownership.
      return ws.file(path).contents.hasPrefix("# Code generated by dagger. Do not edit.\n")
    }
    if (!exists(ws, ".dagger-generated.json")) { return false }
    let ownership = Dagger.json.withContents(ws.file(".dagger-generated.json").contents :: Dagger.JSON!)
    ownership.fields.contains("files") and ownership.field(["files"]).fields.contains(path)
  }

  """A custom runtime or entrypoint remains unchanged by automatic selection."""
  let hasCustomRunner(ws: Workspace!): Boolean! {
    let optionalManifest = if (exists(ws, "dagger-module.toml")) {
      decodedManifest(ws)
    } else if (exists(ws, "dagger.json")) {
      Dagger.json.withContents(ws.file("dagger.json").contents :: Dagger.JSON!)
    } else { null }
    if (optionalManifest == null) { return false }
    let manifest = optionalManifest :: Dagger.JSONValue!
    let fields = manifest.fields
    if (fields.contains("entrypoint") and !hasGeneratedEntrypoint(ws)) { return true }
    let key = if (fields.contains("runtime")) { "runtime" } else if (fields.contains("sdk")) { "sdk" } else { "" }
    if (key == "") { return false }
    let source = runtimeSource(manifest.field([key]))
    source != "" and source != "go"
  }

  """Unified generation uses a published runtime independently of engine/schema versions."""
  let runtimeVersion(unified: Boolean!): String! {
    if (clientVersion != "") { clientVersion } else if (unified) {
      "v1.0.0-beta.17"
    } else { "" }
  }

  let normalizePath(p: String!): String! {
    let trimmed = p.trimPrefix("/").trimPrefix("./").trimSuffix("/")
    if (trimmed == "") { "." } else { trimmed }
  }

  let configDir(foundPath: String!, marker: String!): String! {
    normalizePath(foundPath.trimPrefix("/").trimSuffix(marker))
  }

  let exists(ws: Workspace!, path: String!): Boolean! {
    ws.directory(".", include: [path]).exists(path)
  }

  """Generate standalone clients at the nearest Go scope without changing cwd."""
  let generateStandaloneClients(
    ws: Workspace!,
    clients: [ModuleSource!]!,
    moduleUnified: Boolean!,
  ): Workspace! {
    let originalScope = normalizePath(ws.cwd)
    let goScope = findClientRoot(ws)
    if (goScope == null) {
      if (clients.length == 0) { return ws }
      raise "cannot generate Go clients without a go.mod"
    } else {
      let scoped = ws.withWorkdir(goScope)
      let base = clientCodegenBase(scoped.file("go.mod")).withDirectory(
        "/out",
        scoped.directory(".", exclude: ["**/.git"]),
      ).withNewFile("/removed-clients.txt", "")
      # Keep prior client outputs and go.mod updates in the same container.
      # Only the completed batch needs to be merged into the workspace.
      let generated = clients.reduce(base) { current, target =>
        generateStandaloneClient(current, target, moduleUnified, ws)
      }
      let pruned = generated.withExec([
        "dagger-go-sdk-codegen", "prune-clients",
        "--root", "/out/internal/dagger/clients",
        "--keep", clients.map { target => target.moduleOriginalName }.join(","),
        "--removed-list", "/removed-clients.txt",
        "--prefix", "internal/dagger/clients",
      ])
      # An entrypoint's author source already imports its module client,
      # which the next step has not generated yet. Its bootstrap and final
      # tidies run after that package exists; keep pruning here for empty batches.
      let completed = if (moduleUnified) { pruned } else {
        pruned.withWorkdir("/out").withExec(["go", "mod", "tidy"])
      }
      let merged = scoped.withDirectory(".", completed.directory("/out"))
      let removed = pruned.file("/removed-clients.txt").contents.split("\n").filter { p => p != "" }
      removed.reduce(merged) { current, p => current.withoutFile(p) }.withWorkdir(originalScope)
    }
  }

  """
  Create the module manifests from the scope inputs and SDK defaults.

  Fields of an existing manifest that the scope does not set are kept.
  """
  let generatedManifest(
    ws: Workspace!,
    name: String!,
    clients: [ModuleSource!]!,
  ): Workspace! {
    sdkHelpers.loadModuleManifest(ws)
      .withName(name)
      .withLegacyGoRuntime
      .withLegacyRuntimeDependencies(modules: clients)
      .generate(ws, lock: lock, legacyJson: fat)
  }

  """Run built-in Go codegen and discard its manifest files."""
  let generatedModuleCode(ws: Workspace!): Directory! {
    let scopePath = normalizePath(ws.cwd)
    let sourcePath = if (scopePath == ".") { "/" } else { "/" + scopePath }
    let source = ws
      .withWorkdir(".")
      .moduleSource(sourcePath)
    let generatedRoot = source.generatedContextDirectory
    let generated = if (scopePath == ".") {
      generatedRoot
    } else {
      generatedRoot.directory(scopePath)
    }
    # Keep source navigation stable between Git and Directory workspaces without
    # reconstructing the workspace or changing its resolved dependencies.
    let stable = if (source.kind == GIT_SOURCE) {
      codegenBuilder
        .withDirectory("/out", generated)
        .withFile("/schema.json", source.introspectionSchemaJSON)
        .withExec([
          "dagger-go-sdk-codegen", "normalize-source-links",
          "--introspection-json-path", "/schema.json",
          "--output", "/out",
          "--scope", scopePath,
          "--workspace-repo-url", source.htmlRepoURL,
          "--workspace-pin", source.pin,
        ])
        .directory("/out")
    } else {
      generated
    }
    let withoutTOML = if (stable.exists("dagger-module.toml")) {
      stable.withoutFile("dagger-module.toml")
    } else {
      stable
    }
    if (withoutTOML.exists("dagger.json")) {
      withoutTOML.withoutFile("dagger.json")
    } else {
      withoutTOML
    }
  }

  """
  Refuse what a Dang entrypoint cannot carry, before anything is written.

  Without dangEntrypoint, refuse a module generated with one: the Go runtime
  cannot load the importable package it uses.
  """
  let checkEntrypointScope(ws: Workspace!, hadManifest: Boolean!, clients: [ModuleSource!]!, entrypoint: Boolean!, unified: Boolean!): Void {
    if (entrypoint) {
      let enclosingRoot = findClientRoot(ws)
      if (enclosingRoot != null and enclosingRoot != normalizePath(ws.cwd)) {
        raise "Dang entrypoints need a go.mod in the module directory; keep dangEntrypoint = false for modules using a parent go.mod"
      }
      if (clients.length > 0 and !unified) {
        raise "a Dang entrypoint cannot use other modules yet: a manifest with an entrypoint has no dependencies; set dangEntrypoint = false"
      }
      if (!hadManifest and template == "legacy") {
        raise "the legacy template is not available with a Dang entrypoint; choose another template or set dangEntrypoint = false"
      }
      if (fat) {
        raise "a fat module is not available with a Dang entrypoint: dagger.json would point older engines at the Go runtime, which cannot load an importable package; set fat = false or dangEntrypoint = false"
      }
      let clientNames = clients.map { client => client.moduleOriginalName }
      let clientSources = clients.map { client => client.asString }
      refuseManifestSettings("dagger-module.toml", decodedManifest(ws), "runtime", clientNames, clientSources)
      let legacyJSON = if (exists(ws, "dagger.json")) {
        Dagger.json.withContents(ws.file("dagger.json").contents :: Dagger.JSON!)
      } else {
        null
      }
      refuseManifestSettings("dagger.json", legacyJSON, "sdk", clientNames, clientSources)
    } else if (hasGeneratedEntrypoint(ws)) {
      raise "this module is generated with a Dang entrypoint, and the Go runtime cannot load its importable package; set dangEntrypoint = true, or change the package to main and remove the [entrypoint] table from dagger-module.toml"
    }
    null
  }

  """
  Refuse what a manifest sets that a manifest with an entrypoint drops:
  sdk-helpers writes that manifest from the name and the entrypoint only.
  """
  let refuseManifestSettings(fileName: String!, manifest: Dagger.JSONValue, runtimeKey: String!, clientNames: [String!]!, clientSources: [String!]!): Void {
    if (manifest == null) {
      return null
    }
    let objections = manifestObjections(manifest, runtimeKey)
    if (objections.length > 0) {
      raise fileName + " has settings a Dang entrypoint cannot carry (" + objections.join(", ") + "); remove them or set dangEntrypoint = false"
    }
    let uncovered = uncoveredDependencies(fileName, manifest, clientNames, clientSources)
    if (uncovered.length > 0) {
      raise fileName + " depends on " + uncovered.join(", ") + ", which the scope's clients do not list; a Dang entrypoint reaches its dependencies through them: add them to the scope's clients in dagger.toml or set dangEntrypoint = false"
    }
    null
  }

  """
  The dependencies of a manifest that no client of the scope provides: by
  module name, or by source for a dependency without a name. The Go runtime
  generator writes one dependency per client, and the generated manifest
  drops them; a dependency the author added would be lost.
  """
  let uncoveredDependencies(fileName: String!, manifest: Dagger.JSONValue!, clientNames: [String!]!, clientSources: [String!]!): [String!]! {
    if (manifest.fields.contains("dependencies") == false) {
      return [] :: [String!]!
    }
    let entries = manifest.field(["dependencies"]).contents :: String!
    let missing = fileName + " has a dependency without name or source; remove it or set dangEntrypoint = false"
    # dagger.json also accepts a dependency as a bare source string. The form
    # is told apart before decoding, so a refusal is not rescued.
    let strings = ((JSON.decode(entries) :: [String!]!).length >= 0) rescue { err: Error => false }
    if (strings) {
      return (JSON.decode(entries) :: [String!]!).map { source =>
        if (source == "") { raise missing }
        if (clientSources.contains(source)) { "" } else { source }
      }.filter { label => label != "" }
    }
    let objects = ((JSON.decode(entries) :: [{{name: String, source: String}}!]!).length >= 0) rescue { err: Error => false }
    if (objects == false) {
      raise fileName + " mixes dependency strings and objects; write each dependency as an object with its name, or set dangEntrypoint = false"
    }
    (JSON.decode(entries) :: [{{name: String, source: String}}!]!).map { dependency =>
      let name = dependency.name ?? ""
      let source = dependency.source ?? ""
      if (name == "" and source == "") { raise missing }
      if (name != "") {
        if (clientNames.contains(name)) { "" } else { name }
      } else if (clientSources.contains(source)) { "" } else { source }
    }.filter { label => label != "" }
  }

  """
  The settings of a decoded manifest that a manifest with an entrypoint has
  no place for. runtimeKey is `runtime` in dagger-module.toml and `sdk` in
  dagger.json. A Go runtime is what dangEntrypoint replaces, so it is kept.
  The local replace directives of go.mod replace include, so generation drops
  it rather than refusing it: refusing would leave a module that neither
  runtime builds while the author removes it. For the same reason it drops
  codegen, which only the engine's runtime codegen reads, and the
  dependencies that the scope's clients provide.
  """
  let manifestObjections(manifest: Dagger.JSONValue!, runtimeKey: String!): [String!]! {
    let fields = manifest.fields
    let keys = ["disableDefaultFunctionCaching"].filter { key =>
      fields.contains(key)
    }
    # A module is rooted at its own directory, which is what `source = "."`
    # says. Any other source is what the manifest cannot carry.
    let source = if (fields.contains("source") and normalizePath(manifest.field(["source"]).asString) != ".") {
      ["source"]
    } else {
      [] :: [String!]!
    }
    let tables = ["clients"].filter { key =>
      fields.contains(key)
    }
    let runtime = if (fields.contains(runtimeKey) and runtimeSource(manifest.field([runtimeKey])) != "go") {
      [runtimeKey]
    } else {
      [] :: [String!]!
    }
    keys + source + tables + runtime
  }

  """
  dagger-module.toml parsed as TOML, the way sdk-helpers reads it, or null
  when the module has none.
  """
  let decodedManifest(ws: Workspace!): Dagger.JSONValue {
    if (exists(ws, "dagger-module.toml") == false) {
      return null
    }
    let contents = ws.file("dagger-module.toml").contents
    Dagger.json.withContents(JSON.encode(TOML.decode(contents)) :: Dagger.JSON!)
  }

  """The source of a runtime table or sdk field, which dagger.json may give as a string."""
  let runtimeSource(value: Dagger.JSONValue!): String! {
    value.asString rescue {
      err: Error => stringField(value, "source")
    }
  }

  """A string field of a JSON object, or empty when the field is missing."""
  let stringField(value: Dagger.JSONValue!, key: String!): String! {
    if (value.fields.contains(key)) { value.field([key]).asString } else { "" }
  }

  """
  Generate a module that the engine loads through a Dang entrypoint.

  The schema comes from a staged runtime manifest that does not reach the
  result. The generator writes the embedded client, the static dispatch
  command, and the entrypoint into the module's Go root. sdk-helpers then
  writes the manifest that names the entrypoint and removes dagger.json.
  """
  let entrypointModule(ws: Workspace!, name: String!, unified: Boolean!): Workspace! {
    let scopePath = normalizePath(ws.cwd)
    # A module whose manifest names an entrypoint and no dependencies loads
    # through that entrypoint, which is not generated yet. A fresh runtime
    # manifest gives the engine a module it can serve a schema for.
    let staged = sdkHelpers.moduleManifest
      .withName(name: name)
      .withLegacyGoRuntime
      .generate(ws, lock: false, legacyJson: false)
    let source = staged.withWorkdir(".").moduleSource(rootedPath(scopePath))
    let schemaVersion = source.engineVersion
    let moduleSourceID = toString(entrypointModuleSource(ws, name, scopePath).id)

    # The generator updates go.mod and go.sum at the Go root, which can be
    # above the module. Without one, it creates go.mod in the module.
    let goRoot = findClientRoot(ws) ?? scopePath
    let moduleRoot = moduleSubpath(goRoot, scopePath)
    let prefix = if (moduleRoot == ".") { "" } else { moduleRoot + "/" }
    let workspaceRoot = ws.withWorkdir(goRoot)
    let goVersion = if (exists(workspaceRoot, "go.mod")) {
      requiredGoVersion(workspaceRoot.file("go.mod"))
    } else { minimumGoVersion }
    let goImage = "golang:" + goVersion + "-alpine"
    let builder = moduleCodegenBuilder(goImage)
    let moduleSource = workspaceRoot.directory(".", exclude: ["**/.git"])
    let includes = moduleIncludes(ws, builder, moduleSource, goRoot, moduleRoot, scopePath)
    let included = lines(includes.file("include")).length > 0
    # A module with includes is generated where its build sees it: under its
    # anchor, beside the paths it includes.
    let buildRoot = if (included) { "/src/" + includes.file("module").contents } else { "/src" }
    let tree = if (included) { includedTree(ws, moduleSource, includes) } else { moduleSource }
    # The module source ID can outgrow an exec argument: it's passed in a file.
    let inputs = builder
      .withDirectory("/src", tree)
      .withFile("/schema.json", source.introspectionSchemaJSON)
      .withNewFile("/module-source-id", moduleSourceID)
    let goInputs = inputs.withEnvVariable("GOWORK", "off")
    let codegen = runTool(goInputs, [
      "module-codegen",
      "--module-root", buildRoot + "/" + moduleRoot,
      "--build-root", "/src",
      "--module-name", name,
      "--introspection-json-path", "/schema.json",
      "--schema-version", schemaVersion,
      "--module-source-id-file", "/module-source-id",
      "--go-image", goImage,
      "--dagger-version", if (unified) { runtimeVersion(true) } else { schemaVersion },
      "--unified=" + JSON.encode(unified),
      "--global-client=" + JSON.encode(globalClient ?? false),
      "--removed-list", "/removed.txt",
    ])
    let generated = runTool(codegen, [
      "entrypoint-contract",
      "--entrypoint-dir", buildRoot + "/" + prefix + entrypointPath,
      "--introspection-json-path", "/schema.json",
    ]).directory(buildRoot)
    # Merge only what the generator owns, so the user's files are not
    # written back.
    let owned = directory.withDirectory(".", generated, include: [
      "go.mod",
      "go.sum",
      prefix + "go.mod",
      prefix + "go.sum",
      prefix + "dagger.gen.go",
      prefix + "dagger.dispatch.gen.go",
      prefix + ".dagger-generated.json",
      prefix + "internal/dagger/**",
      prefix + "cmd/*-dispatch/**",
    ])
    let merged = ws
      .withWorkdir(goRoot)
      .withDirectory(".", owned)
      .withWorkdir(scopePath)
    # The merge only adds files. The generated files the generator removed
    # are removed here, relative to the module.
    let removed = codegen.file("/removed.txt").contents.split("\n").filter { p => p != "" }
    let pruned = removed.reduce(merged) { current, p => current.withoutFile(p) }
    sdkHelpers.moduleManifest
      .withName(name: name)
      .withDangEntrypoint(source: "./" + entrypointPath)
      .generate(pruned, lock: false, legacyJson: false)
  }

  """
  The module source the engine serves the module as: the module with the
  generated entrypoint, whose dang.toml decides the version the engine names
  its declarations by. The staged schema's source isn't it: the bindings' Go
  identifiers follow the schema, but the module's schema names come from this
  source's naming (ModuleSource.naming). Loading it needs no generated
  entrypoint.
  """
  let entrypointModuleSource(ws: Workspace!, name: String!, scopePath: String!): ModuleSource! {
    sdkHelpers.moduleManifest
      .withName(name: name)
      .withDangEntrypoint(source: "./" + entrypointPath)
      .generate(ws, lock: false, legacyJson: false)
      .withWorkdir(".")
      .moduleSource(rootedPath(scopePath))
  }

  """
  What the module's build reads outside its module directory, found from the
  local replace directives of go.mod: the files anchor and module, and the
  include list, with one JSON value per line. Paths are relative to the
  anchor, the directory that holds the module and every included path. The
  include list is empty for a module whose build reads nothing outside.
  """
  let moduleIncludes(ws: Workspace!, builder: Container!, moduleSource: Directory!, goRoot: String!, moduleRoot: String!, scopePath: String!): Directory! {
    let targets = runTool(builder.withDirectory("/src", moduleSource), [
      "module-codegen", "replaces",
      "--module-root", "/src/" + moduleRoot,
      "--workspace-path", scopePath,
    ]).stdout.split("\n").filter { p => p != "" }
    # The scan follows the module's imports into the replace targets, so it
    # reads their Go sources from the workspace. It refuses a target without
    # go.mod with the replace line, which reading the target here would not.
    let present = targets.filter { target =>
      ws.directory("/", include: [target + "/go.mod"]).exists(target + "/go.mod")
    }
    let tree = present.reduce(directory.withDirectory(goRoot, moduleSource)) { current, target =>
      current.withDirectory(target, ws.directory(rootedPath(target),
        include: ["**/go.mod", "**/*.go", "**/*.s", "**/*.h", "**/*.syso"], exclude: ["**/.git"]))
    }
    runTool(builder.withDirectory("/src", tree), [
      "module-codegen", "includes",
      "--module-root", "/src/" + scopePath,
      "--workspace-path", scopePath,
      "--output", "/includes",
    ]).directory("/includes")
  }

  let lines(file: File!): [String!]! {
    file.contents.split("\n").filter { line => line != "" }
  }

  let decoded(line: String!): Dagger.JSONValue! {
    Dagger.json.withContents(line :: Dagger.JSON!)
  }

  """
  The files of a directory. A directory whose files a filter removed is
  still listed, so it does not count.
  """
  let files(dir: Directory!): [String!]! {
    dir.glob(pattern: "**").filter { p => p.hasSuffix("/") == false }
  }

  """Where an include entry is written, for an error about it."""
  let includeLabel(line: String!): String! {
    let entry = decoded(line)
    stringField(entry, "position") + ": " + JSON.encode(stringField(entry, "path"))
  }

  """
  The module directory and the workspace paths its include list names, laid
  out under their anchor as the engine loads them with the module. Refuses a
  path that matches nothing or only ignored files.
  """
  let includedTree(ws: Workspace!, moduleSource: Directory!, includes: Directory!): Directory! {
    let anchor = rootedPath(includes.file("anchor").contents)
    let modulePath = includes.file("module").contents
    let entries = lines(includes.file("include"))
    let unmatched = entries.filter { line =>
      files(ws.directory(anchor, include: [stringField(decoded(line), "pattern")], exclude: ["**/.git"])).isEmpty
    }
    if (unmatched.length > 0) {
      raise includeLabel(unmatched[0] ?? "") + " matches nothing in the workspace"
    }
    let ignored = entries.filter { line =>
      files(ws.directory(anchor, include: [stringField(decoded(line), "pattern")], exclude: ["**/.git"], gitignore: true)).isEmpty
    }
    if (ignored.length > 0) {
      raise includeLabel(ignored[0] ?? "") + " matches only files ignored by .gitignore"
    }
    let patterns = entries.map { line => stringField(decoded(line), "pattern") }
    directory
      .withDirectory(".", ws.directory(anchor, include: patterns, exclude: [modulePath, "**/.git"], gitignore: true))
      .withDirectory(modulePath, moduleSource)
  }

  """
  Run one generator tool. A failure raises the tool's own message: an exec
  error reports only the exit code, and the message is what tells the user
  how to fix the module.

  The tool runs as a nested client of the session, as every v1 exec does:
  the generators ask the engine to name identifiers.
  """
  let runTool(ctr: Container!, args: [String!]!): Container! {
    let ran = ctr.withExec(args, expect: ReturnType.ANY)
    if (ran.exitCode != 0) {
      # Each tool prints its error last, after its name.
      let prefix = (args[0] ?? "") + ": "
      raise prefix + ran.stderr.split(prefix).reduce("") { last, part => part }.trimSpace
    }
    ran
  }

  """Directory of the generated Dang entrypoint, relative to the module."""
  let entrypointPath: String! = "internal/dagger/entrypoint"

  """Path of a module below its Go root, both relative to the workspace root."""
  let moduleSubpath(goRoot: String!, scopePath: String!): String! {
    if (goRoot == scopePath) {
      "."
    } else if (goRoot == ".") {
      scopePath
    } else {
      scopePath.trimPrefix(goRoot + "/")
    }
  }

  let rootedPath(p: String!): String! {
    if (p == ".") { "/" } else { "/" + p }
  }

  """
  Build the module generator and the entrypoint contract check.

  The contract check embeds Dang, whose parser needs cgo.
  """
  let moduleCodegenBuilder(goImage: String!): Container! {
    container
      .from(goImage)
      .withoutEntrypoint
      .withExec(["apk", "add", "--no-cache", "build-base"])
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withDirectory("/helpers", currentModule.source.directory("helpers"))
      .withDirectory("/cmd", currentModule.source.directory("cmd"))
      .withWorkdir("/helpers/entrypoint-contract")
      .withExec(["go", "build", "-o", "/usr/local/bin/entrypoint-contract", "."])
      .withWorkdir("/helpers/module-codegen")
      .withExec(["go", "build", "-o", "/usr/local/bin/module-codegen", "."])
  }

  """
  The generators' minimum Go version, which fresh modules declare. The
  helpers build on its image, so init and generate pull one Go image.
  """
  let minimumGoVersion: String! = "1.26.1"

  """
  Build the standalone client generator. It runs nested in the session, to
  format identifiers through the engine for schemas at or past
  v1.0.0-beta.22.
  """
  let codegenBuilder: Container! {
    container
      .from("golang:" + minimumGoVersion + "-alpine")
      .withoutEntrypoint
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withDirectory("/helper", currentModule.source.directory("cmd/dagger-go-sdk-codegen"))
      .withWorkdir("/helper")
      .withExec(["go", "build", "-o", "/usr/local/bin/dagger-go-sdk-codegen", "."])
  }

  """Use the newer of the consumer Go directives and the generator's minimum."""
  let requiredGoVersion(goMod: File!): String! {
    codegenBuilder.withFile("/consumer.go.mod", goMod)
      .withExec(["dagger-go-sdk-codegen", "go-version", "--go-mod", "/consumer.go.mod", "--minimum", minimumGoVersion])
      .stdout.trimSpace
  }

  let clientCodegenBase(goMod: File!): Container! {
    let goVersion = requiredGoVersion(goMod)
    container.from("golang:" + goVersion + "-alpine").withoutEntrypoint
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withFile("/usr/local/bin/dagger-go-sdk-codegen", codegenBuilder.file("/usr/local/bin/dagger-go-sdk-codegen"))
  }

  """Serialize the target-module location used by the generated bootstrap."""
  let boundModuleJSON(kindJSON: String!, path: String!, ref: String!, pin: String!): String! {
    "{\"kind\":" + kindJSON + ",\"path\":" + JSON.encode(path) + ",\"ref\":" + JSON.encode(ref) + ",\"pin\":" + JSON.encode(pin) + "}"
  }

  """
  The repository of a Git module and the Git workspace, which tell whether the
  module is part of that workspace.
  """
  let gitMetaJSON(target: ModuleSource!, ws: Workspace!): String! {
    if (target.kind != GIT_SOURCE) { return "" }
    let commit = ws.git.head.commit rescue { err: Error => "" }
    ",\"workspace\":{\"address\":" + JSON.encode(ws.address) + ",\"commit\":" + JSON.encode(commit) + "}" +
      ",\"git\":{\"cloneRef\":" + JSON.encode(target.cloneRef) + ",\"htmlRepoURL\":" + JSON.encode(target.htmlRepoURL) + "}"
  }

  """Generate one target client in the batch's Go module at /out."""
  let generateStandaloneClient(ctr: Container!, target: ModuleSource!, moduleUnified: Boolean!, ws: Workspace!): Container! {
    let targetName = target.moduleOriginalName
    let outputPath = "internal/dagger/clients/" + targetName
    # The existing package's transport tells auto whether it already uses
    # shared core. New packages beside a legacy app retain embedded bindings;
    # new entrypoint modules explicitly select their unified layout.
    let generatedPath = "/out/" + outputPath + "/dagger.gen.go"
    let existing = ctr.directory("/out").exists(outputPath + "/dagger.gen.go")
    let retained = if (existing) {
      ctr.file(generatedPath).contents.contains("dagger.ModuleGraphQLClient(")
    } else { false }
    let unified = unifiedClients ?? (moduleUnified or retained)
    let metaJSON = "{\"engineVersion\":" + JSON.encode(target.engineVersion) +
      ",\"clientVersion\":" + JSON.encode(runtimeVersion(unified)) +
      ",\"module\":" + boundModuleJSON(
        JSON.encode(target.kind),
        target.sourceRootSubpath,
        target.asString,
        target.pin,
      ) + gitMetaJSON(target, ws) + "}"
    ctr
      .withFile("/schema.json", target.clientSchemaIntrospectionJSON)
      .withNewFile("/meta.json", metaJSON)
      .withExec([
        "dagger-go-sdk-codegen", "client",
        "--introspection-json-path", "/schema.json",
        "--client-meta-path", "/meta.json",
        "--output", "/out/" + outputPath,
        "--module-root", "/out",
        "--unified=" + JSON.encode(unified),
        "--removed-list", "/removed-clients.txt",
      ])
  }

  """
  Render one templates/<name> starter for a new module.

  The Go runtime needs package main. A module with a Dang entrypoint is an
  importable package named after the module. A starter with the global dag
  calls it as before; the Go runtime always generates it. Without it,
  embedded bindings declare their own core types, so only unified bindings
  use core constructors.
  """
  let renderedTemplate(ws: Workspace!, name: String!, selected: String!, entrypoint: Boolean!, unified: Boolean!): Directory! {
    if (currentModule.source.exists("templates/" + selected) == false) {
      raise "unknown init template: " + selected
    } else {
      let builder = container
        .from("golang:" + minimumGoVersion + "-alpine")
        .withoutEntrypoint
        .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
        .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
        .withDirectory("/helper", currentModule.source.directory("helpers/render-template"))
        .withDirectory("/template", currentModule.source.directory("templates/" + selected))
        .withWorkdir("/helper")
        .withExec(["go", "build", "-o", "/usr/local/bin/render-template", "."])
      let rendered = if (entrypoint) {
        # A fresh entrypoint owns its Go root even when the project above
        # has go.mod. The starter and dispatcher must agree on this path.
        if (!exists(ws, "go.mod")) {
          builder.withExec(["render-template", "--importable-package", "--unified-clients=" + JSON.encode(unified), "--global-client=" + JSON.encode(globalClient ?? false), "--standalone-go-module", name, "/template", "/rendered"])
        } else {
          builder
            .withFile("/go.mod", ws.file("go.mod"))
            .withExec([
              "render-template", "--importable-package",
              "--unified-clients=" + JSON.encode(unified),
              "--global-client=" + JSON.encode(globalClient ?? false),
              "--go-mod", "/go.mod",
              "--module-subpath", ".",
              name, "/template", "/rendered",
            ])
        }
      } else {
        builder.withExec(["render-template", "--global-client", name, "/template", "/rendered"])
      }
      rendered.directory("/rendered")
    }
  }
}
