// Client is the Dagger Engine Client
type Client struct {
	{{- /*  The standalone client in not dev mode needs to store the dagger client for the global client to work */ -}}
	*Query
	dag *dagger.Client
	client graphql.Client
	// ownsSession is set when this client opened the session itself (via
	// Connect) and is therefore the one allowed to close it. A client built
	// by NewClient borrows a session someone else owns.
	ownsSession bool
}

// ClientOpt holds a client option
type ClientOpt = dagger.ClientOpt

// Request contains all the values required to build queries executed by the graphql.Client
type Request = dagger.Request

// Response contains data returned by the GraphQL API
type Response = dagger.Response

// WithWorkdir sets the engine workdir
var WithWorkdir = dagger.WithWorkdir

// WithWorkspace sets the workspace binding for the engine session
var WithWorkspace = dagger.WithWorkspace

// WithLogOutput sets the progress writer
var WithLogOutput = dagger.WithLogOutput

// WithLoadWorkspaceModules opts this client into loading workspace modules
// based on the working directory when the session is created via the CLI.
var WithLoadWorkspaceModules = dagger.WithLoadWorkspaceModules

// WithConn sets the engine connection explicitly
var WithConn = dagger.WithConn

// WithVersionOverride requests a specific schema version from the engine
var WithVersionOverride = dagger.WithVersionOverride

// WithVerbosity sets the verbosity level for the progress output
var WithVerbosity = dagger.WithVerbosity

// WithRunnerHost sets the runner host URL
var WithRunnerHost = dagger.WithRunnerHost

// WithEnvironmentVariable sets an environment variable in the CLI subprocess
var WithEnvironmentVariable = dagger.WithEnvironmentVariable


// Connect opens a session of its own and returns a client bound to it. It is
// the one-line path when this is the only client in the program; use NewClient
// to put several clients on one session.
func Connect(ctx context.Context, opts ...ClientOpt) (*Client, error) {
	dag, err := dagger.Connect(ctx, opts...)
	if err != nil {
		return nil, err
	}

	c, err := NewClient(ctx, dag)
	if err != nil {
		dag.Close()
		return nil, err
	}
	c.ownsSession = true

	return c, nil
}

// NewClient serves the bound module into an already-open session and returns a
// client sharing it. Object IDs belong to the session that made them, so this
// is what lets two generated clients exchange objects:
//
//	dag, err := dagger.Connect(ctx)
//	engine, err := enginedev.NewClient(ctx, dag)
//	cli, err := clidev.NewClient(ctx, dag)
//
// The session stays the caller's to close: Close on the returned client is a
// no-op.
func NewClient(ctx context.Context, dag *dagger.Client) (*Client, error) {
	c := &Client{
		Query: &Query{
			query: dag.QueryBuilder(),
		},
		client: dag.GraphQLClient(),
		dag:    dag,
	}

	if err := serveBoundModule(ctx, c); err != nil {
		return nil, err
	}

	return c, nil
}

{{/*  The standalone client in not dev mode needs to expose a close method for the global client to work */ -}}
// Close closes the session, but only if this client opened it. Closing a
// borrowed session would pull it out from under whoever else is on it.
func (c *Client) Close() error {
	if !c.ownsSession {
		return nil
	}
	return c.dag.Close()
}

// GraphQLClient returns the underlying graphql.Client
func (c *Client) GraphQLClient() graphql.Client {
	return c.client
}

// QueryBuilder returns the underlying query builder
func (c *Client) QueryBuilder() *querybuilder.Selection {
	return c.Query.query
}

// Do executes a raw GraphQL request using the client's session
func (c *Client) Do(ctx context.Context, req *Request, resp *Response) error {
	return c.dag.Do(ctx, req, resp)
}

{{- $mod := BoundModule }}
{{- /* Serve the one module these bindings are bound to before Connect
returns, so `dag.<module>()` resolves. The client schema is core + the bound
module only, so there are no dependencies to serve. */}}
// serveBoundModule serves the single module this client is bound to into the
// session, so its constructor resolves on the schema.
func serveBoundModule(ctx context.Context, client *Client) error {
{{- if eq $mod.Kind "GIT_SOURCE" }}
	{{- /* A git module's identity is a location that resolves from anywhere:
	serve the canonical ref + pin directly. This survives being shipped away
	from the project tree. */}}
	return client.
		ModuleSource("{{ $mod.Ref }}", ModuleSourceOpts{RefPin: "{{ $mod.Pin }}"}).
		AsModule().
		Serve(ctx)
{{- else if $mod.Kind }}
	{{- /* A local module is resolved against the workspace (discovered by
	find-up from the session cwd — a stable reference point anywhere in the
	project tree) by its workspace-root-relative path, not the client's cwd. */}}
	return client.
		CurrentWorkspace().
		ModuleSource("{{ $mod.Path }}").
		AsModule().
		Serve(ctx)
{{- else }}
	{{- /* No bound module metadata was supplied (bindings for core only):
	nothing to serve. */}}
	return nil
{{- end }}
}
