package {{ .ModulePackage }}
{{ $pkg := "dagger" }}{{ if .UnifiedClients }}{{ $pkg = "core" }}{{ end }}
import (
{{- if .UnifiedClients }}
	"dagger.io/dagger/core"
{{- else }}
	"{{ .ModuleImport }}/internal/dagger"
{{- end }}
)

type {{ .ModuleType }} struct {
	// Image the build runs on.
	BaseImageAddress string

	// +private
	Source *{{ $pkg }}.Directory
}

func New(
	ws *{{ $pkg }}.Workspace,
	// +default="alpine:3.21"
	baseImageAddress string,
) *{{ .ModuleType }} {
	return &{{ .ModuleType }}{
		BaseImageAddress: baseImageAddress,
		Source: ws.Directory("/", {{ $pkg }}.WorkspaceDirectoryOpts{
			Exclude: []string{"**/.git", "**/.dagger", "**/vendor"},
		}),
	}
}

// A container with the source mounted, ready to build on.
func (m *{{ .ModuleType }}) Container() *{{ $pkg }}.Container {
{{- if .GlobalClient }}
	return dag.Container().
{{- else if .UnifiedClients }}
	return core.NewContainer().
{{- else }}
	return dagger.Connect().Container().
{{- end }}
		From(m.BaseImageAddress).
		WithDirectory("/src", m.Source).
		WithWorkdir("/src")
}
