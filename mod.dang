"""
A Dagger module that uses the Go SDK.
"""
type Mod {
  """
  Workspace-root-relative path of this module root — the module's stable
  identity, independent of where the client is invoked from.
  """
  rootPath: String!

  """
  Workspace containing this module.
  """
  let ws: Workspace!

  """
  Marker filename that skips generate when found at or above this module root.
  """
  let skipGenerateFilename: String!

  """
  Marker filename that keeps generate on the engine's codegen when found at or
  above this module root.
  """
  let engineCodegenFilename: String!

  """
  This module root relative to the client's current location: "." when the cwd is
  the module itself, "sub/mod" for a module beneath it, ".." for an enclosing one.
  A cwd-relative view of rootPath, so listings read the way a shell user would.
  """
  path: String! {
    let cwd = ws.cwd.trimPrefix("/").trimSuffix("/")
    if (rootPath == cwd) {
      "."
    } else if (cwd == "") {
      rootPath
    } else if (rootPath.trimPrefix(cwd + "/") != rootPath) {
      rootPath.trimPrefix(cwd + "/")
    } else if (rootPath == "." or cwd.trimPrefix(rootPath + "/") != cwd) {
      let rootDepth = if (rootPath == ".") { 0 } else { rootPath.split("/").length }
      cwd.split("/").dropFirst(rootDepth).map { segment => ".." }.join("/")
    } else {
      rootPath
    }
  }

  """
  Whether this module or an ancestor contains the configured generate skip marker.
  """
  skipGenerate(ws: Workspace!): Boolean! {
    hasMarker(ws, skipGenerateFilename)
  }

  """
  Whether this module or an ancestor contains the engine-codegen marker, which
  keeps a dagger-module.toml module on the engine's own Go codegen.
  """
  engineCodegen(ws: Workspace!): Boolean! {
    hasMarker(ws, engineCodegenFilename)
  }

  """
  Whether this module root or an ancestor contains a marker filename.
  """
  let hasMarker(ws: Workspace!, filename: String!): Boolean! {
    let markerPath = ws.findUp(name: filename, from: rootPath)
    markerPath != null
  }

  """
  Whether this module uses the 1.0 dagger-module.toml config.
  """
  let isModern(ws: Workspace!): Boolean! {
    let configPath = if (rootPath == ".") { "dagger-module.toml" } else { rootPath + "/dagger-module.toml" }
    ws.directory("/", include: [configPath]).exists(configPath)
  }

  """
  Generate this module.
  If the generate skip marker is present, the changeset is empty.
  """
  generate(ws: Workspace!): Changeset! {
    generated(ws).changes(ws)
  }

  """
  `ws` with this module's generated files staged onto it.

  Returning the staged workspace rather than only the changeset lets a caller
  generating several modules feed each one the edits the previous ones made to
  files they share, such as a common go.work.
  """
  generated(ws: Workspace!): Workspace! {
    if (skipGenerate(ws)) {
      ws
    } else {
      # Stage the local dependency closure so this module's codegen sees
      # up-to-date dependency bindings. It is only an input to resolving the
      # module source, never the diff baseline, so the dependencies' codegen
      # does not ride along.
      let stagedWs = ws.withChanges(
        ws.moduleSource("/" + rootPath).generateLocalDependencies(ws),
      )

      if (isModern(ws) and engineCodegen(ws) == false) {
        # A dagger-module.toml module is generated here, by this SDK's own
        # code generator.
        generatedWorkspace(ws, stagedWs)
      } else {
        # A pre-1.0 module keeps being generated by the runtime its dagger.json
        # names, which is the engine's builtin Go SDK; so does a module that
        # opted back into the engine's codegen with the marker.
        let generated = stagedWs
          .moduleSource("/" + rootPath)
          .generatedContextDirectory
          .directory(rootPath)

        # The generated context holds only generated files, so it layers onto the
        # module rather than standing in for it. Workspace.changes then reports
        # just the difference, rooted at the caller's cwd.
        ws.withDirectory("/" + rootPath, generated)
      }
    }
  }

  """
  Run this SDK's own module codegen and return the workspace with its output
  staged onto it.

  Two engine-free passes of the codegen helper around one in-engine merge: pass
  A bootstraps the module (go.mod, base bindings, go get + go mod tidy) and
  emits the module's own types as introspection JSON; the engine's
  schema().merge() folds them into the dependency schema — the single
  implementation every SDK shares — and pass B renders the bindings from the
  merged schema. The container works on the module's whole context at /src,
  in the module's source subpath, exactly as the engine's codegen does, so a
  parent go.work, a `replace ../lib` and a nested `source` all resolve.
  """
  let generatedWorkspace(ws: Workspace!, stagedWs: Workspace!): Workspace! {
    let src = stagedWs.moduleSource("/" + rootPath)
    let subpath = normalizePath(src.sourceSubpath)
    let rootSubpath = normalizePath(src.sourceRootSubpath)
    let parentPath = if (subpath == ".") { "." } else { subpath.split("/").map { segment => ".." }.join("/") }
    let moduleName = src.moduleOriginalName
    let depsSchema = src.introspectionSchemaJSON
    let commonArgs = [
      "--output", "/src",
      "--module-source-path", subpath,
      "--module-parent-path", parentPath,
      "--module-root-path", rootSubpath,
      "--module-name", moduleName,
      "--lib-version", goSDKLibVersion,
    ]

    # The stale dispatcher is dropped before pass A, as the engine does: it
    # would not compile against a changed schema.
    let context = src.contextDirectory.withoutFile(joinPath(subpath, "dagger.gen.go"))

    let bootstrapped = codegenBuilder
      .withMountedFile("/deps.json", depsSchema)
      .withMountedDirectory("/src", context)
      .withWorkdir("/src")
      .withExec(["codegen", "module-types", "--introspection-json-path", "/deps.json", "--module-types-out", "/types.json"] + commonArgs)

    # An empty types file means the schema view predates self types: nothing
    # to merge, the dependency schema is the final one.
    let typesJSON = bootstrapped.file("/types.json").contents
    let mergedSchema = if (typesJSON == "") {
      depsSchema
    } else {
      let merged = schema(json: depsSchema.contents :: Dagger.JSON!)
        .merge(moduleTypes: typesJSON :: Dagger.JSON!, moduleName: moduleName)
        .contents
      directory.withNewFile("merged.json", toString(merged)).file("merged.json")
    }

    let generated = bootstrapped
      .withMountedFile("/merged.json", mergedSchema)
      .withExec(["codegen", "generate-module", "--introspection-json-path", "/merged.json", "--stale-out", "/stale.txt", "--gowork-out", "/gowork.txt"] + commonArgs)

    let out = generated.directory("/src")
    let moduleRoot = if (rootSubpath == ".") { out } else { out.directory(rootSubpath) }

    # Layer the generated module root onto the workspace — a merge, never a
    # replace, so a file the workspace view does not carry is never reported
    # as removed — then drop the dependency bindings that went stale.
    let stale = generated.file("/stale.txt").contents.trimSpace.split("\n").filter { line => line != "" }
    let withModule = stale.reduce(ws.withDirectory("/" + rootPath, moduleRoot)) { acc, path =>
      acc.withoutFile("/" + contextToWorkspace(rootSubpath, path))
    }

    # `go work use .` enrols the module in an enclosing go.work, which lives
    # outside the module root. Carry it (and its sum) back when the caller's
    # cwd cone allows it; a changeset may only touch paths under the cwd.
    let gowork = generated.file("/gowork.txt").contents.trimSpace
    let withGoWork = if (gowork == "") {
      withModule
    } else {
      let contextDir = src.contextDirectory
      let goworkPath = contextToWorkspace(rootSubpath, gowork)
      let sumPath = gowork + ".sum"
      # `go work use` and `go work edit -replace` change go.work; `go mod tidy`
      # under a workspace can change only go.work.sum. Either one counts.
      let sumChanged = if (out.exists(sumPath) == false) {
        false
      } else if (contextDir.exists(sumPath) == false) {
        true
      } else {
        out.file(sumPath).contents != contextDir.file(sumPath).contents
      }
      let changed = out.file(gowork).contents != contextDir.file(gowork).contents or sumChanged
      if (pathContains(normalizePath(ws.cwd), goworkPath) == false) {
        if (changed) {
          raise "generating " + rootPath + " changed " + goworkPath + ", which is outside the current directory: run `dagger generate` from the workspace root"
        } else {
          withModule
        }
      } else {
        let withWork = withModule.withNewFile("/" + goworkPath, out.file(gowork).contents)
        if (out.exists(sumPath)) {
          withWork.withNewFile("/" + goworkPath + ".sum", out.file(sumPath).contents)
        } else {
          withWork
        }
      }
    }

    withGoWork
  }

  """
  Map a path relative to the module's context root to a workspace-root
  relative path. The module root is `rootPath` in the workspace and
  `rootSubpath` in the context, so the context root is the workspace prefix
  left once the latter is stripped from the former.
  """
  let contextToWorkspace(rootSubpath: String!, path: String!): String! {
    let prefix = if (rootSubpath == ".") {
      rootPath
    } else if (rootPath == rootSubpath) {
      "."
    } else {
      normalizePath(rootPath.trimSuffix("/" + rootSubpath))
    }
    joinPath(prefix, path)
  }

  let joinPath(base: String!, path: String!): String! {
    if (base == "." or base == "") { path } else { base + "/" + path }
  }

  let normalizePath(p: String!): String! {
    let trimmed = p.trimPrefix("./").trimPrefix("/").trimSuffix("/")
    if (trimmed == "") { "." } else { trimmed }
  }

  let pathContains(base: String!, p: String!): Boolean! {
    base == "." or p == base or p.hasPrefix(base + "/")
  }
}
