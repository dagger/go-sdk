"""
Checks the Go SDK against the Dagger development engine.
"""
type EngineE2e {
  """
  Commit of release v1.0.0-beta.18, shared by engine-dev and the target
  engine. Keep it aligned with the dependency in dagger-module.toml.
  """
  let engineCommit: String! = "249edbd646e63c5181053c8af72623ed9bdf030d"

  """
  Commit of release v1.0.0-beta.12, shared by the runtime-floor-engine-dev
  dependency and the engine of the runtime floor check. Runtime-mode modules
  support no older engine.
  """
  let runtimeFloorCommit: String! = "4932411ff7a9b0771dd53779d9a085406cefb531"

  """
  Commit of release v1.0.0-beta.16, shared by the entrypoint-floor-engine-dev
  dependency and the engine of the client baseline check. The full entrypoint
  and unified-client floors must be validated after their engine and runtime
  SDK prerequisites are integrated.
  """
  let entrypointFloorCommit: String! = "2d95ef98b6824c5aaca4a43eb172c9a057c18619"

  """
  Commit of release v1.0.0-beta.17, shared by the beta17-engine-dev
  dependency and the engine of the sources guard check. It is the last
  release that does not call an entrypoint's sources function.
  """
  let beta17Commit: String! = "0da36c8da9cb6a682c7d27eca9bd2c125de5ed09"

  let daggerSource(commit: String!): Workspace! {
    git("https://github.com/dagger/dagger").ref(commit).asWorkspace
  }

  """Use the pinned engine unless a caller supplies a local source directory."""
  let selectedEngineSource(source: Directory): Workspace! {
    if (source == null) { daggerSource(engineCommit) } else { source.asWorkspace }
  }

  let clientBase: Container! {
    container
      .from("alpine:3.22")
      .withExec(["apk", "add", "--no-cache", "git"])
      .withEnvVariable("HOME", "/root")
      .withWorkdir("/root")
  }

  let sdkClient(
    ws: Workspace!,
    engineClient: Container!,
    engineCommit: String!,
  ): Container! {
    let sdkSource = ws
      .directory("/", exclude: [".git"])
      .withFile("dagger.toml", ws.file("/.dagger/modules/engine-e2e/workspace.toml"))
      # Older engines reject the root lockfile's query-aware entries.
      .withFile("dagger.lock", ws.file("/.dagger/modules/engine-e2e/nested.lock"))
      # Tell shared checks which SDK source belongs to the engine under test.
      .withNewFile(".dagger/modules/e2e/engine-commit", engineCommit)
    assert("Go SDK workspace source has no dagger.toml") {
      sdkSource.exists("dagger.toml")
    }

    let client = engineClient
      .withMountedDirectory("./go-sdk", sdkSource)
      .withWorkdir("./go-sdk")
      .withExec(["git", "init", "--quiet"])
    assert("nested client has no dagger.toml") {
      client.directory(".").exists("dagger.toml")
    }
    client
  }

  let runChecks(client: Container!, checks: [String!]!): Void {
    # One check per run: dagger check passes when any of its patterns
    # matches, so a stale name among several would be skipped silently.
    checks.each { check =>
      client
        .withExec([
          "env", "-u", "DAGGER_SESSION_PORT", "-u", "DAGGER_SESSION_TOKEN",
          "dagger", "check", check,
        ])
        .sync
    }
    null
  }

  """A check's pass field returns false on failure without a failing exit code."""
  let runModuleCheck(client: Container!, args: [String!]!): Void {
    let checked = client.withExec(args)
    let result = checked.stdout.trimSpace
    assert("nested check failed: " + args.join(" ") + "\n" + result + checked.stderr) {
      result == "true"
    }
    null
  }

  """
  Validate the complete engine/runtime contribution stack before publishing
  its immutable pin. Unlike standalone-client floor checks, these execute
  entrypoint modules and shared core handles on the supplied engine source.
  """
  integratedSdkCheck(ws: Workspace!, engineSource: Directory = null): Void @check {
    let source = selectedEngineSource(engineSource)
    let client = sdkClient(
      ws,
      engineDev(ws: source).installClient(client: clientBase),
      engineCommit,
    ).withMountedDirectory("/integrated-runtime-sdk", source.directory("/sdk/go"))
    let boundary = ["env", "-u", "DAGGER_SESSION_PORT", "-u", "DAGGER_SESSION_TOKEN", "dagger"]
    ["module-init-check", "generate-check", "global-client-compatibility-check"].each { check =>
      runModuleCheck(client, boundary + [
        "-m", ".dagger/modules/e2e", "call", "entrypoint", check, "--ws", ".", "pass",
      ])
    }
    ["calls-check", "changed-target-check", "stale-target-check", "removed-client-check", "git-calls-check", "shortcut-calls-check"].each { check =>
      runModuleCheck(client, boundary + [
        "-m", ".dagger/modules/e2e", "call", "unified",
        "--runtime-sdk", "/integrated-runtime-sdk", "--legacy-version", "v0.21.7",
        check, "--ws", ".", "pass",
      ])
    }
    ["v0.20.8", "v0.18.0", "v0.16.0", "v0.15.0"].each { version =>
      runModuleCheck(client, boundary + [
        "-m", ".dagger/modules/e2e", "call", "unified",
        "--runtime-sdk", "/integrated-runtime-sdk", "--legacy-version", version,
        "calls-check", "--ws", ".", "pass",
      ])
    }
    runModuleCheck(client, boundary + [
      "-m", ".dagger/modules/e2e", "call", "unified",
      "--runtime-sdk", "/integrated-runtime-sdk", "--package-main",
      "calls-check", "--ws", ".", "pass",
    ])
    null
  }

  """Run selected older target versions without repeating the complete suite."""
  integratedLegacyClientsCheck(
    ws: Workspace!,
    engineSource: Directory = null,
    versions: [String!]! = ["v0.16.0", "v0.15.0"],
  ): Void @check {
    let source = selectedEngineSource(engineSource)
    let client = sdkClient(ws, engineDev(ws: source).installClient(client: clientBase), engineCommit)
      .withMountedDirectory("/integrated-runtime-sdk", source.directory("/sdk/go"))
    versions.each { version =>
      runModuleCheck(client, [
        "env", "-u", "DAGGER_SESSION_PORT", "-u", "DAGGER_SESSION_TOKEN",
        "dagger", "-m", ".dagger/modules/e2e", "call", "unified",
        "--runtime-sdk", "/integrated-runtime-sdk", "--legacy-version", version,
        "calls-check", "--ws", ".", "pass",
      ])
    }
    null
  }

  """
  Generate and call a Go module on the released beta.16 engine, then migrate
  its frozen files with this SDK on the complete supplied engine stack.
  """
  beta16MigrationCheck(ws: Workspace!, engineSource: Directory = null): Void @check {
    let source = selectedEngineSource(engineSource)
    let boundary = ["env", "-u", "DAGGER_SESSION_PORT", "-u", "DAGGER_SESSION_TOKEN", "dagger"]
    let released = entrypointFloorEngineDev(ws: daggerSource(entrypointFloorCommit))
      .installClient(client: clientBase)
      .withFile("/beta16-frozen/main.go", ws.file("/.dagger/modules/e2e/fixtures/beta16/main.go"))
      .withNewFile("/beta16-frozen/go.mod", "module example.com/beta16-frozen\n\ngo 1.26.1\n")
      .withNewFile("/beta16-frozen/dagger-module.toml", "name = \"beta16-frozen\"\nengineVersion = \"v1.0.0-beta.16\"\n\n[runtime]\nsource = \"go\"\n")
      .withWorkdir("/beta16-frozen")
      .withExec(boundary + ["query"],
        stdin: "{moduleSource(refString:\".\"){generatedContextDirectory{export(path:\".\")}}}")
      .withExec(boundary + ["-m", ".", "call", "message"])
    assert("the released beta.16 fixture failed before migration: " + released.stdout) {
      released.stdout.trimSpace == "beta16 generated global"
    }
    let frozen = released.directory(".")
    assert("the released fixture already has split bindings") {
      frozen.exists("internal/dagger/core") == false
    }
    let client = sdkClient(
      ws,
      engineDev(ws: source).installClient(client: clientBase),
      engineCommit,
    ).withMountedDirectory("/beta16-frozen", frozen)
      .withMountedDirectory("/integrated-runtime-sdk", source.directory("/sdk/go"))
    let unchanged = client.withWorkdir("/beta16-frozen")
      .withExec(boundary + ["-m", ".", "call", "message"])
    assert("the unchanged beta.16 module failed on the new engine: " + unchanged.stdout) {
      unchanged.stdout.trimSpace == "beta16 generated global"
    }
    ["main.go", "go.mod", "dagger-module.toml", "dagger.gen.go", "internal/dagger/dagger.gen.go"].each { path =>
      assert("loading the unchanged beta.16 module rewrote " + path) {
        unchanged.file(path).contents == frozen.file(path).contents
      }
    }
    runModuleCheck(client, boundary + [
      "-m", ".dagger/modules/e2e", "call", "beta-16",
      "--frozen", "/beta16-frozen", "--runtime-sdk", "/integrated-runtime-sdk",
      "migration-check", "--ws", ".", "pass",
    ])
    null
  }

  """
  On an engine that calls sources, the module builds from its context,
  reuses results across sessions until an included file changes, and runs
  from anywhere. engineSource replaces the pinned engine with a dagger
  checkout.
  """
  sourcesCheck(ws: Workspace!, engineSource: Directory = null): Void @check {
    sourcesCalls(sdkClient(
      ws,
      engineDev(ws: selectedEngineSource(engineSource)).installClient(client: clientBase),
      engineCommit,
    ))
  }

  """
  On beta.17, which does not call sources and passes a workspace to types
  and call, a generated module fails at load, with or without files outside
  its directory, and the error shows the release it needs.
  """
  sourcesGuardCheck(ws: Workspace!): Void @check {
    # beta.17 cannot generate the fixture: the caller's client loads
    # include-app, which beta.17 refuses.
    let generator = sdkClient(
      ws,
      engineDev(ws: daggerSource(engineCommit)).installClient(client: clientBase),
      engineCommit,
    )
    let exported = runDagger(generator, generator.workdir, [
      "-m", ".dagger/modules/e2e", "call", "sources", "fixture", "--ws", ".", "export", "--path", "/repo",
    ])
    succeeded(exported)
    let repo = sdkClient(
      ws,
      beta17EngineDev(ws: daggerSource(beta17Commit)).installClient(client: clientBase),
      beta17Commit,
    )
      .withDirectory("/repo", exported.directory("/repo"))
      .withExec(["git", "-C", "/repo", "init", "-q"])
    [["-m", "app", "call", "greeting"], ["-m", "control", "call", "nonce"]].each { args =>
      let refused = runDagger(repo, "/repo", args)
      assert("beta.17 did not refuse " + args.join(" ") + " with the release it needs:\n" + refused.stdout + refused.stderr) {
        refused.exitCode != 0 and
          refused.stderr.contains("missing argument \"workspace\" required by interface") and
          refused.stderr.contains("Needs Dagger v1.0.0-beta.18 or later")
      }
    }
    null
  }

  """Run one dagger command in the client, from dir."""
  let runDagger(client: Container!, dir: String!, args: [String!]!): Container! {
    client.withWorkdir(dir).withExec(
      ["env", "-u", "DAGGER_SESSION_PORT", "-u", "DAGGER_SESSION_TOKEN", "dagger"] + args,
      expect: ReturnType.ANY,
    )
  }

  let succeeded(run: Container!): String! {
    if (run.exitCode != 0) {
      raise "dagger failed:\n" + run.stdout + run.stderr
    }
    run.stdout.trimSpace
  }

  """
  Call the generated include fixture: the module builds from its context, a
  file embedded at build time, a file read at call time, a file the build
  does not read, the module API, a result reused by a second session and
  computed again after an included file changes but not after an unrelated
  one, calls from another repository, a subdirectory, by path and from a git
  source, a caller that reaches the module through a generated client, a
  module without files outside its directory, and a build that misses a file
  that sources does not return.
  """
  let sourcesCalls(client: Container!): Void {
    let sdkDir = client.workdir
    let exported = runDagger(client, sdkDir, [
      "-m", ".dagger/modules/e2e", "call", "sources", "fixture", "--ws", ".", "export", "--path", "/repo",
    ])
    succeeded(exported)
    let ready = exported
      .withNewFile("/repo/dagger.toml",
        "[modules.include-app]\nsource = \"app\"\n\n[modules.include-caller]\nsource = \"caller\"\n\n[modules.include-control]\nsource = \"control\"\n")
      .withExec(["git", "-C", "/repo", "init", "-q"])
    let entrypoint = ready.file("/repo/app/internal/dagger/entrypoint/main.dang").contents
    assert("the entrypoint does not declare sources:\n" + entrypoint) {
      entrypoint.contains("pub sources(workspace: Workspace!): Directory!")
    }

    let outside = runDagger(ready.withExec(["git", "init", "-q", "/other"]), "/other", ["-m", "/repo/app", "call", "greeting"])
    assert("the module failed from another repository: " + succeeded(outside)) { succeeded(outside) == "one" }

    let greeting = ["call", "include-app", "greeting"]
    let nonce = ["call", "include-app", "nonce"]
    let built = runDagger(outside, "/repo", greeting)
    assert("the build did not embed the included file: " + succeeded(built)) {
      succeeded(built) == "one"
    }
    let runtime = runDagger(built, "/repo", ["call", "include-app", "runtime"])
    assert("the function did not read the included file at call time: " + succeeded(runtime)) {
      succeeded(runtime) == "one"
    }
    let excluded = runDagger(runtime, "/repo", ["call", "include-app", "excluded"])
    assert("lib/greet/testdata, which the build does not read, reached the module") { succeeded(excluded) == "false" }

    let functions = runDagger(excluded, "/repo", ["-m", "app", "functions"])
    let api = succeeded(functions)
    assert("the module API is not greeting, runtime, excluded and nonce:\n" + api) {
      api.contains("greeting") and api.contains("runtime") and api.contains("excluded") and api.contains("nonce") and api.contains("sources") == false
    }
    let greetingHelp = succeeded(runDagger(functions, "/repo", ["call", "include-app", "greeting", "--help"]))
    assert("greeting takes a workspace argument:\n" + greetingHelp) { greetingHelp.contains("--ws") == false }

    let firstNonce = runDagger(functions, "/repo", nonce)
    let secondNonce = runDagger(firstNonce, "/repo", nonce)
    assert("a second session did not reuse the result: " + succeeded(firstNonce) + " then " + succeeded(secondNonce)) {
      succeeded(secondNonce) == succeeded(firstNonce)
    }
    let unrelated = runDagger(secondNonce.withNewFile("/repo/lib/unrelated.txt", "unrelated"), "/repo", nonce)
    assert("a file outside sources invalidated the result: " + succeeded(unrelated)) {
      succeeded(unrelated) == succeeded(firstNonce)
    }
    let changed = runDagger(unrelated.withNewFile("/repo/lib/greet/greeting.txt", "two"), "/repo", greeting)
    assert("a new session returned a stale result after an included file changed: " + succeeded(changed)) {
      succeeded(changed) == "two"
    }
    let freshNonce = runDagger(changed, "/repo", nonce)
    assert("the result was not computed again after an included file changed: " + succeeded(freshNonce)) {
      succeeded(freshNonce).hasPrefix("two ") and succeeded(freshNonce) != succeeded(firstNonce)
    }

    let fromSubdirectory = runDagger(freshNonce, "/repo/lib", greeting)
    let byPath = runDagger(fromSubdirectory, "/repo/lib", ["-m", "../app", "call", "greeting"])
    assert("the module failed from a subdirectory of its workspace") {
      succeeded(fromSubdirectory) == "two" and succeeded(byPath) == "two"
    }

    let callerGreeting = ["call", "include-caller", "greeting"]
    let sibling = runDagger(byPath, "/repo", callerGreeting)
    assert("the caller did not build with its own and the app's included files: " + succeeded(sibling)) {
      succeeded(sibling) == "two two"
    }
    let siblingChanged = runDagger(sibling.withNewFile("/repo/lib/greet/greeting.txt", "three"), "/repo", callerGreeting)
    assert("the caller returned a stale result after an included file changed: " + succeeded(siblingChanged)) {
      succeeded(siblingChanged) == "three three"
    }
    let control = runDagger(siblingChanged, "/repo", ["call", "include-control", "nonce"])
    let controlAgain = runDagger(control, "/repo", ["call", "include-control", "nonce"])
    assert("a module without files outside its directory did not reuse its result") {
      succeeded(controlAgain) == succeeded(control)
    }
    # Greeting starts importing a package that the generated sources do not return.
    let appMain = controlAgain.file("/repo/app/main.go").contents
      .replace("\"example.com/lib/greet\"\n", "\"example.com/lib/greet\"\n\t\"example.com/lib/words\"\n")
      .replace("{ return greet.Greeting() }", "{ return greet.Greeting() + words.Word() }")
    let stale = runDagger(controlAgain.withNewFile("/repo/app/main.go", appMain), "/repo", greeting)
    assert("a build that misses a file did not say to generate again:\n" + stale.stderr) {
      stale.exitCode != 0 and stale.stderr.contains("run dagger generate")
    }

    succeeded(runDagger(byPath, sdkDir, [
      "-m", ".dagger/modules/e2e", "call", "sources", "git-source-call", "--ws", ".", "--cli", "/.dagger-cli",
    ]))
    null
  }

  """
  Build the pinned main engine and use this checkout as its Go SDK.
  """
  devSdkCheck(ws: Workspace!, checks: [String!]! = []): Void @check {
    let client = sdkClient(
      ws,
      engineDev(ws: daggerSource(engineCommit)).installClient(client: clientBase),
      engineCommit,
    )

    # The outer engine injects session credentials when the exec starts.
    # Clear them at the process boundary so these commands use the pinned
    # development engine configured by installClient.
    let listed = client.withExec([
      "env", "-u", "DAGGER_SESSION_PORT", "-u", "DAGGER_SESSION_TOKEN",
      "dagger", "sdk", "list",
    ])

    assert("development Go SDK was not listed") {
      listed.stdout.contains("go")
    }

    let checkCommand = [
      "env", "-u", "DAGGER_SESSION_PORT", "-u", "DAGGER_SESSION_TOKEN",
      "dagger", "check",
    ]
    # A check invocation succeeds when any pattern matches. Run selected
    # patterns separately so a missing check cannot hide behind another one.
    let checked = if (checks.isEmpty) {
      listed.withExec(checkCommand)
    } else {
      checks.reduce(listed) { current, check => current.withExec(checkCommand + [check]) }
    }

    let initialized = checked
      .withExec([
        "env", "-u", "DAGGER_SESSION_PORT", "-u", "DAGGER_SESSION_TOKEN",
        "dagger", "--auto-apply", "module", "init", "go",
        "--name", "sdk-smoke",
        "--path", ".dagger/modules/sdk-smoke",
        "--dang-entrypoint=false", "--unified-clients=false",
      ])
      .withExec(["test", "-f", ".dagger/modules/sdk-smoke/dagger-module.toml"])
      .withExec(["test", "!", "-e", ".dagger/modules/sdk-smoke/dagger.json"])
      .withExec(["test", "-f", ".dagger/modules/sdk-smoke/dagger.gen.go"])
      .withExec(["test", "-f", ".dagger/modules/sdk-smoke/internal/dagger/dagger.gen.go"])
      .withExec(["grep", "-qF", "dag.Container().", ".dagger/modules/sdk-smoke/main.go"])

    let fat = initialized
      .withExec([
        "env", "-u", "DAGGER_SESSION_PORT", "-u", "DAGGER_SESSION_TOKEN",
        "dagger", "--auto-apply", "module", "init", "go",
        "--name", "sdk-smoke",
        "--path", ".dagger/modules/sdk-smoke",
        "--dang-entrypoint=false", "--unified-clients=false",
        "--fat",
      ])
      .withExec(["test", "-f", ".dagger/modules/sdk-smoke/dagger.json"])

    let thin = fat
      .withExec([
        "env", "-u", "DAGGER_SESSION_PORT", "-u", "DAGGER_SESSION_TOKEN",
        "dagger", "--auto-apply", "module", "init", "go",
        "--name", "sdk-smoke",
        "--path", ".dagger/modules/sdk-smoke",
        "--dang-entrypoint=false", "--unified-clients=false",
        "--fat=false",
      ])
      .withExec(["test", "!", "-e", ".dagger/modules/sdk-smoke/dagger.json"])

    let release = thin
      .withExec([
        "env", "-u", "DAGGER_SESSION_PORT", "-u", "DAGGER_SESSION_TOKEN",
        "dagger", "-m", ".dagger/modules/sdk-smoke",
        "call", "container", "file",
        "--path", "/etc/alpine-release",
        "contents",
      ])
      .stdout

    assert("generated module did not run") {
      release.trimSpace != ""
    }

    let entrypointPath = ".dagger/modules/sdk-entrypoint"
    let entrypoint = thin
      .withExec([
        "env", "-u", "DAGGER_SESSION_PORT", "-u", "DAGGER_SESSION_TOKEN",
        "dagger", "--auto-apply", "module", "init", "go",
        "--name", "sdk-entrypoint",
        "--path", entrypointPath,
      ])
      .withExec(["grep", "-qx", "\\[entrypoint\\]", entrypointPath + "/dagger-module.toml"])
      .withExec(["test", "!", "-e", entrypointPath + "/dagger.json"])
      .withExec(["test", "-f", entrypointPath + "/internal/dagger/entrypoint/main.dang"])
      .withExec(["test", "-f", entrypointPath + "/cmd/sdk-entrypoint-dispatch/main.go"])
      .withExec(["grep", "-qF", "core.NewContainer().", entrypointPath + "/main.go"])
      .withExec([
        "env", "-u", "DAGGER_SESSION_PORT", "-u", "DAGGER_SESSION_TOKEN",
        "dagger", "-m", entrypointPath,
        "call", "container", "file",
        "--path", "/etc/alpine-release",
        "contents",
      ])
      .stdout

    assert("module with a Dang entrypoint did not run") {
      entrypoint.trimSpace != ""
    }

    let global = starterRelease(thin, "sdk-global", ["--global-client=true"], "dag.Container().")
    let embedded = starterRelease(thin, "sdk-embedded", ["--unified-clients=false"], "dagger.Connect().Container().")
    assert("a starter with the global dag or embedded bindings did not run") {
      global.trimSpace != "" and embedded.trimSpace != ""
    }
    null
  }

  """Initialize a module from the default starter, check its client call, and run it."""
  let starterRelease(client: Container!, name: String!, settings: [String!]!, call: String!): String! {
    let path = ".dagger/modules/" + name
    client
      .withExec([
        "env", "-u", "DAGGER_SESSION_PORT", "-u", "DAGGER_SESSION_TOKEN",
        "dagger", "--auto-apply", "module", "init", "go",
        "--name", name,
        "--path", path,
      ] + settings)
      .withExec(["grep", "-qF", call, path + "/main.go"])
      .withExec([
        "env", "-u", "DAGGER_SESSION_PORT", "-u", "DAGGER_SESSION_TOKEN",
        "dagger", "-m", path,
        "call", "container", "file",
        "--path", "/etc/alpine-release",
        "contents",
      ])
      .stdout
  }

  """
  Run the runtime-mode checks on the runtime floor engine.
  """
  runtimeFloorCheck(ws: Workspace!): Void @check {
    let engine = runtimeFloorEngineDev(ws: daggerSource(runtimeFloorCommit))
    runChecks(sdkClient(
      ws,
      engine.installClient(client: clientBase),
      runtimeFloorCommit,
    ), [
      "e-2-e:module-init-check",
      "e-2-e:module-client-check",
      "e-2-e:manifest:local-client-check",
      "e-2-e:manifest:git-client-check",
    ])
  }

  """
  Run the client checks on the entrypoint floor engine.
  """
  entrypointFloorCheck(ws: Workspace!): Void @check {
    let engine = entrypointFloorEngineDev(ws: daggerSource(entrypointFloorCommit))
    runChecks(sdkClient(
      ws,
      engine.installClient(client: clientBase),
      entrypointFloorCommit,
    ), [
      "dag://e-2-e/find-client-root-check",
      "dag://e-2-e/standalone-client-check",
      "dag://e-2-e/standalone-client-compiles-check",
      "dag://e-2-e/standalone-client-preservation-check",
    ])
  }
}
