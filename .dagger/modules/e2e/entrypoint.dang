"""
Run the Go SDK with dangEntrypoint.
"""
type EntrypointChecks {
  let fixtureRoot: String! = ".dagger/modules/e2e/fixtures"
  let outputRoot: String! = ".dagger/modules/e2e/out"
  # A Go module without a manifest. Each check writes the manifest it needs.
  let appPath: String! = fixtureRoot + "/generate/app"
  let clientTargetPath: String! = fixtureRoot + "/client/dep"
  let goScopePath: String! = fixtureRoot + "/go-scope"
  let dangConfigPath: String! = "internal/dagger/entrypoint/dang.toml"

  """The release this Go SDK is built for: defaultTarget in go-sdk.dang."""
  let sdkTarget: String! = "v1.0.0-beta.24"

  let exists(ws: Workspace!, path: String!): Boolean! {
    ws.directory(".", include: [path]).exists(path)
  }

  let dangConfig(ws: Workspace!): Dagger.JSONValue! {
    Dagger.json.withContents(JSON.encode(TOML.decode(ws.file(dangConfigPath).contents)) :: Dagger.JSON!)
  }

  let configures(ws: Workspace!, release: String!): Boolean! {
    let config = dangConfig(ws)
    config.field(["dang"]).asString == "2.1" and
      config.field(["imports", "Dagger", "dagger"]).asString == release
  }

  """
  The manifest dangEntrypoint writes for a module that reads nothing outside
  its directory: the name, an empty include, and the entrypoint.
  """
  let entrypointManifest(name: String!): String! {
    "name = " + JSON.encode(name) +
      "\ninclude = []\n\n[entrypoint]\n  kind = \"dang\"\n  source = \"./internal/dagger/entrypoint\"\n"
  }

  """
  Explicit unifiedClients = true is refused with the Go runtime. Unset
  unifiedClients preserves its embedded bindings.
  """
  unifiedRequiresEntrypointCheck(ws: Workspace!): Void @check {
    let input = ws
      .withNewFile(appPath + "/dagger-module.toml", "name = \"generate-app\"\n\n[runtime]\n  source = \"go\"\n")
      .withWorkdir(appPath)
    [goSdk(dangEntrypoint: false, unifiedClients: true)].map { sdk =>
      let refused = sdk.generateScope(
        ws: input,
        isModule: true,
        name: "generate-app",
        clients: [],
      ).file("dagger.gen.go").contents rescue { err: Error => err.message }
      assert("unifiedClients was silently ignored by legacy runtime generation: " + firstLine(refused)) {
        refused.contains("unifiedClients = true requires dangEntrypoint = true") and
          refused.contains("set unifiedClients = false in the scope's settings in dagger.toml to keep the Go runtime")
      }
    }
    null
  }

  """
  A new module gets an importable starter, the entrypoint manifest, the
  shared-core client without a global dag, the dispatch command, and the Dang
  entrypoint. It compiles against the published runtime without replacements.
  Regeneration reads the entrypoint manifest and changes nothing.
  """
  moduleInitCheck(ws: Workspace!): Void @check {
    let scopePath = outputRoot + "/entrypoint-init"
    let input = ws
      .withNewFile(scopePath + "/user.txt", "keep me\n")
      .withWorkdir(scopePath)
    let generated = goSdk.generateScope(
      ws: input,
      isModule: true,
      name: "entrypoint-init",
      clients: [],
    )

    assert("the manifest is not the entrypoint manifest") {
      generated.file("dagger-module.toml").contents == entrypointManifest("entrypoint-init")
    }
    assert("dagger.json was created") {
      exists(generated, "dagger.json") == false
    }
    assert("the starter is not an importable package") {
      generated.file("main.go").contents.hasPrefix("package entrypoint_init\n")
    }
    assert("go.mod was not created") {
      exists(generated, "go.mod")
    }
    assert("the module dispatcher was not generated") {
      generated.file("dagger.gen.go").contents.contains("func DaggerDispatch(")
    }
    assert("a new module has a global client") {
      generated.file("dagger.gen.go").contents.contains("var dag ") == false and
      generated.file("internal/dagger/dagger.gen.go").contents.contains("var dag ") == false
    }
    assert("the starter uses the removed global client") {
      generated.file("main.go").contents.contains("dag.") == false
    }
    assert("the module client was not generated") {
      exists(generated, "internal/dagger/dagger.gen.go")
    }
    assert("the module client was generated twice") {
      exists(generated, "internal/dagger/internal") == false
    }
    assert("the dispatch command was not generated") {
      exists(generated, "cmd/entrypoint-init-dispatch/main.go")
    }
    assert("the Dang entrypoint was not generated") {
      generated.file("internal/dagger/entrypoint/main.dang").contents.contains("type Entrypoint implements ModuleEntrypoint")
    }
    assert("an existing file was not preserved") {
      generated.file("user.txt").contents == "keep me\n"
    }
    assert("generation changed the current directory") {
      generated.cwd == input.cwd
    }

    let regenerated = goSdk.generateScope(
      ws: generated,
      isModule: true,
      name: "entrypoint-init",
      clients: [],
    )
    assert("regeneration was not stable") {
      regenerated.changes(generated).isEmpty
    }

    let recovered = goSdk.generateScope(
      ws: generated.withoutFile("internal/dagger/entrypoint/main.dang"),
      isModule: true, name: "entrypoint-init", clients: [],
    )
    assert("automatic regeneration did not recover its deleted entrypoint") {
      recovered.changes(generated).isEmpty
    }

    # A binding an earlier schema generated is removed from the workspace. A
    # user file next to it is not generated code, so it stays.
    let userBinding = "package dagger\n\nfunc userHelper() {}\n"
    let seeded = generated
      .withNewFile("internal/dagger/obsolete.gen.go", "// Code generated by dagger. DO NOT EDIT.\n\npackage dagger\n\nfunc obsoleteBinding() {}\n")
      .withNewFile("internal/dagger/user.gen.go", userBinding)
    let pruned = goSdk(dangEntrypoint: true).generateScope(
      ws: seeded,
      isModule: true,
      name: "entrypoint-init",
      clients: [],
    )
    assert("an obsolete generated file was kept") {
      exists(pruned, "internal/dagger/obsolete.gen.go") == false
    }
    assert("a user file next to the generated client was removed") {
      pruned.file("internal/dagger/user.gen.go").contents == userBinding
    }
    assert("removing an obsolete file changed anything else") {
      pruned.withoutFile("internal/dagger/user.gen.go").changes(generated).isEmpty
    }
    null
  }

  """
  generated-imports.txt lists exactly the packages outside the standard
  library that a new module's generated code imports. Engines pre-warm the
  builds of the packages it lists, so a package the generator adds or drops
  must be added to it or dropped from it too.
  """
  generatedImportsCheck(ws: Workspace!): Void @check {
    let scopePath = outputRoot + "/generated-imports"
    let generated = goSdk.generateScope(
      ws: ws.withNewDirectory(scopePath, directory).withWorkdir(scopePath),
      isModule: true,
      name: "generated-imports",
      clients: [],
    )
    # main.go is the starter, the author's code: every other Go file is
    # generated. A package's imports are read from its files without building
    # it, so the root package without its starter still lists them.
    let compared = container.from("golang:1.27-alpine").withoutEntrypoint
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withDirectory("/module", generated.directory(".").withoutFile("main.go"))
      .withFile("/listed.txt", ws.file("/generated-imports.txt"))
      .withWorkdir("/module")
      .withExec(["sh", "-ec",
        "mod=$(go list -m)\n" +
        "go list -e -f '{{join .Imports \"\\n\"}}' ./... | sort -u > /imports\n" +
        "go list std | sort -u > /std\n" +
        "comm -23 /imports /std | grep -v -e \"^$mod\\$\" -e \"^$mod/\" > /generated || true\n" +
        "grep -v -e '^#' -e '^$' /listed.txt | sort -u > /listed\n" +
        "diff -u /listed /generated\n",
      ], expect: ReturnType.ANY)
    assert("generated-imports.txt (-) differs from what a new module's generated code imports (+):\n" + compared.stdout + compared.stderr) {
      compared.exitCode == 0
    }
    null
  }

  """
  An existing Go runtime module moves to a Dang entrypoint. The entrypoint
  describes its types, and the dispatch command serves the requests the
  entrypoint sends, in engine mode and in developer mode.
  """
  generateCheck(ws: Workspace!): Void @check {
    let legacyJSON = "{\n  \"name\": \"generate-app\",\n  \"engineVersion\": \"v1.0.0-beta.14\",\n  \"sdk\": {\n    \"source\": \"go\"\n  }\n}\n"
    # A Go runtime and the module's own source are what the new manifest
    # replaces, so they are not refused, in either quote style.
    let legacyTOML = "name = \"generate-app\"\nsource = './'\n\n[runtime]\n  source = 'go'\n"
    let input = ws
      .withNewFile(appPath + "/dagger.json", legacyJSON)
      .withNewFile(appPath + "/dagger-module.toml", legacyTOML)
      .withWorkdir(appPath)
    let generated = goSdk(dangEntrypoint: true, globalClient: true).generateScope(
      ws: input,
      isModule: true,
      name: "generate-app",
      clients: [],
    )

    assert("the manifest is not the entrypoint manifest") {
      generated.file("dagger-module.toml").contents == entrypointManifest("generate-app")
    }
    assert("dagger.json was not removed") {
      exists(generated, "dagger.json") == false
    }
    assert("the module source changed") {
      generated.file("main.go").contents == input.file("main.go").contents
    }
    assert("migration removed the legacy module's global client") {
      generated.file("dagger.gen.go").contents.contains("var dag ")
    }
    assert("the new go.mod does not declare Go 1.27") {
      generated.file("go.mod").contents.contains("\ngo 1.27\n")
    }
    let compatibilityRepeated = goSdk(dangEntrypoint: true, globalClient: true).generateScope(
      ws: generated, isModule: true, name: "generate-app", clients: [],
    )
    assert("explicit compatibility regeneration changed the module") {
      compatibilityRepeated.changes(generated).isEmpty
    }

    let entrypoint = generated.file("internal/dagger/entrypoint/main.dang").contents
    assert("the entrypoint does not take fnArgs as a JSON object") {
      entrypoint.contains("fnArgs: JSON!,")
    }
    assert("the entrypoint does not pass fnArgs to the dispatch command") {
      entrypoint.contains("fnArgs: fnArgs,")
    }
    assert("the entrypoint still uses the argument list") {
      entrypoint.contains("FunctionCallArgValue") == false
    }
    assert("the constructor does not use the empty function name") {
      entrypoint.contains("function(\"\", typeDef.withObject(\"GenerateApp\"))")
    }
    assert("the default value is not JSON text") {
      entrypoint.contains("defaultValue: (\"\\\"Hello\\\"\" :: Dagger.JSON!)")
    }
    assert("the entrypoint does not build the dispatch command in the module") {
      entrypoint.contains("go build -o /tmp/dispatch ./cmd/generate-app-dispatch ")
    }
    assert("the dispatch compiler does not match the new go.mod") {
      entrypoint.contains("golang:1.27-alpine@sha256:")
    }

    let dispatcher = container
      .from("golang:1.27-alpine")
      .withoutEntrypoint
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withDirectory("/module", generated.directory("."))
      .withWorkdir("/module")
      .withExec(["go", "vet", "./..."])
      .withExec(["go", "build", "-o", "/usr/local/bin/dispatch", "./cmd/generate-app-dispatch"])

    let developer = dispatcher
      .withExec(["dispatch", "call", "repeat", "--value", "x", "--count", "2"])
      .stdout
    assert("developer mode returned " + developer) {
      developer == "[\"x\",\"x\"]\n"
    }
    let developerReceiver = dispatcher
      .withExec(["dispatch", "call", "greet", "--name", "World", "--receiver-json", "{\"Prefix\":\"Hey\"}"])
      .stdout
    assert("developer mode with a receiver returned " + developerReceiver) {
      developerReceiver == "Hey, World\n"
    }

    let engine = container
      .from("alpine:3.22")
      .withFile("/usr/local/bin/dispatch", dispatcher.file("/usr/local/bin/dispatch"), permissions: 755)
    let constructed = engineCall(engine, "", null, "{\"prefix\":\"Hi\"}")
    assert("the constructor returned " + constructed) {
      constructed == "{\"Prefix\":\"Hi\"}"
    }
    let greeted = engineCall(engine, "Greet", constructed, "{\"name\":\"World\"}")
    assert("the receiver state was not used: " + greeted) {
      greeted == "\"Hi, World\""
    }
    let repeated = engineCall(engine, "Repeat", "{}", "{\"value\":\"x\",\"count\":2}")
    assert("the list codec returned " + repeated) {
      repeated == "[\"x\",\"x\"]"
    }
    let optional = engineCall(engine, "Optional", "{}", "{\"value\":null}")
    assert("the optional codec returned " + optional) {
      optional == "null"
    }
    let status = engineCall(engine, "Status", "{}", "{}")
    assert("the enum codec returned " + status) {
      status == "\"Ready\""
    }
    let voided = engineCall(engine, "Void", "{}", "{}")
    assert("the void codec returned " + voided) {
      voided == "null"
    }
    let echoed = engineCall(engine, "DaggerEcho", "{}", "{\"value\":\"nested\"}")
    assert("the nested Dagger call returned " + echoed) {
      echoed == "\"nested\""
    }
    let containerID = engineCall(engine, "Container", "{}", "{\"value\":\"resource\"}")
    let read = engineCall(engine, "ReadContainer", "{}", "{\"container\":" + containerID + "}")
    assert("the core object ID did not round trip: " + read) {
      read == "\"resource\""
    }

    let failed = engine.withExec(
      ["dispatch", "engine-call"],
      stdin: callRequest("Fail", "{}", "{}"),
      experimentalPrivilegedNesting: true,
      expect: ReturnType.ANY,
    )
    assert("a Go error did not fail the call") {
      failed.exitCode != 0
    }
    assert("the Go error was not reported") {
      failed.stderr.contains("fixture failure")
    }
    null
  }

  """
  Global compatibility is explicitly opt-in. The SDK keeps author source
  unchanged when removing the global would leave it uncompilable, and the
  default migration names the setting that keeps the global.
  """
  globalClientCompatibilityCheck(ws: Workspace!): Void @check {
    let input = ws
      .withNewFile(appPath + "/dagger-module.toml", "name = \"generate-app\"\n\n[runtime]\nsource = \"go\"\n")
      .withWorkdir(appPath)
    let refused = goSdk(dangEntrypoint: true, globalClient: false).generateScope(
      ws: input, isModule: true, name: "generate-app", clients: [],
    ).file("dagger.gen.go").contents rescue { err: Error => err.message }
    assert("unmigrated author code unexpectedly compiled without dag: " + refused) {
      refused.contains("undefined: dag")
    }
    let defaulted = goSdk(dangEntrypoint: true).generateScope(
      ws: input, isModule: true, name: "generate-app", clients: [],
    ).file("dagger.gen.go").contents rescue { err: Error => err.message }
    assert("the default migration did not name globalClient: " + defaulted) {
      defaulted.contains("undefined: dag") and defaulted.contains("set globalClient = true in the scope's settings in dagger.toml")
    }
    let migratedSource = input.file("main.go").contents.replace("dag.", "dagger.Connect().")
    let noGlobal = goSdk(dangEntrypoint: true, globalClient: false).generateScope(
      ws: input.withNewFile("main.go", migratedSource), isModule: true, name: "generate-app", clients: [],
    )
    assert("explicit false kept the legacy global") {
      noGlobal.file("dagger.gen.go").contents.contains("var dag ") == false
    }
    assert("generation changed migrated author source") {
      noGlobal.file("main.go").contents == migratedSource
    }
    let repeated = goSdk(dangEntrypoint: true, globalClient: false).generateScope(
      ws: noGlobal, isModule: true, name: "generate-app", clients: [],
    )
    assert("explicit global removal was not stable") {
      repeated.changes(noGlobal).isEmpty
    }
    let built = container.from("golang:1.27-alpine").withoutEntrypoint
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withDirectory("/module", repeated.directory(".")).withWorkdir("/module")
      .withExec(["go", "build", "-o", "/usr/local/bin/dispatch", "./cmd/generate-app-dispatch"])
    let echoed = engineCall(built, "DaggerEcho", "{}", "{\"value\":\"without-global\"}")
    assert("explicit clients failed after removing the global: " + echoed) {
      echoed == "\"without-global\""
    }
    let legacyRefused = goSdk(dangEntrypoint: false, unifiedClients: false, globalClient: false).generateScope(
      ws: input, isModule: true, name: "generate-app", clients: [],
    ).file("dagger.gen.go").contents rescue { err: Error => err.message }
    assert("legacy runtime silently ignored explicit false: " + legacyRefused) {
      legacyRefused.contains("globalClient = false requires dangEntrypoint = true")
    }
    null
  }

  """
  A function's error reaches its caller with its text, not as the
  dispatcher's exit code: the dispatcher of a module with a Dang entrypoint
  ends its stderr with the error of the module it calls, on the marker line
  the entrypoint raises. The called module is a fixture of this repository,
  since a generated client loads its target from the host.
  """
  errorTextCheck(ws: Workspace!): Void @check {
    let relayPath = outputRoot + "/error-relay"
    let staged = ws.withDirectory(relayPath, ws.directory("/" + fixtureRoot + "/error/relay"))
      .withNewFile(relayPath + "/go.mod", "module example.com/error-relay\n\ngo 1.26.1\n")
      .withNewFile(relayPath + "/dagger-module.toml", "name = \"error-relay\"\n")
    let relay = goSdk(dangEntrypoint: true, globalClient: true, unifiedClients: true).generateScope(
      ws: staged.withWorkdir(relayPath), isModule: true, name: "error-relay",
      clients: [staged.withWorkdir(".").moduleSource("/" + fixtureRoot + "/error/leaf")],
    )
    let dispatcher = container.from("golang:1.26-alpine").withoutEntrypoint
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withDirectory("/module", relay.directory(".")).withWorkdir("/module")
      .withExec(["go", "build", "-o", "/usr/local/bin/dispatch", "."])
    let ran = dispatcher.withExec(
      ["dispatch", "engine-call"],
      stdin: JSON.encode({{ receiverType: "ErrorRelay", receiverValue: "{}", fnName: "RelayCheck", fnArgs: "{}" }}),
      experimentalPrivilegedNesting: true,
      expect: ReturnType.ANY,
    )
    let message = ran.stderr.split("::dagger-function-error::")[1] ?? ""
    assert("the relayed error lost its text: " + ran.stderr) {
      ran.exitCode != 0 and message.contains("error-leaf failed: boom") and message.contains("exit code") == false
    }
    null
  }

  """
  Unset settings preserve a Go runtime module and existing embedded or
  unified entrypoint bindings. Explicit true requests migration, and the
  migrated entrypoint gets a dang.toml that declares the target. Custom
  runners and their dang.toml stay unchanged unless migration is requested
  (and refused). A remote entrypoint is replaced with the generated one,
  which gets a dang.toml that keeps the settings already at its path.
  """
  defaultCompatibilityCheck(ws: Workspace!): Void @check {
    let legacyManifest = "name = 'generate-app'\n[runtime]\nsource = 'go'\n"
    let input = ws.withWorkdir(appPath).withNewFile("dagger-module.toml", legacyManifest)
    let legacy = goSdk(dangEntrypoint: false, unifiedClients: false).generateScope(ws: input, isModule: true, name: "generate-app", clients: [])
    assert("explicit false migrated an existing runtime module") {
      legacy.file("dagger-module.toml").contents.contains("[runtime]") and
        exists(legacy, "internal/dagger/entrypoint/main.dang") == false and
        exists(legacy, dangConfigPath) == false
    }
    assert("explicit false removed the legacy API global") {
      legacy.file("dagger.gen.go").contents.contains("var dag ")
    }
    let retainedRuntime = goSdk.generateScope(ws: legacy, isModule: true, name: "generate-app", clients: [])
    assert("unset settings changed the generated runtime module") {
      retainedRuntime.changes(legacy).isEmpty
    }
    let migratedManifest = input.withNewFile("dagger-module.toml", "disableDefaultFunctionCaching = true\n" + legacyManifest)
    let preservedSettings = goSdk.generateScope(ws: migratedManifest, isModule: true, name: "generate-app", clients: [])
    assert("unset settings migrated a manifest with legacy-only settings") {
      preservedSettings.file("dagger-module.toml").contents.contains("disableDefaultFunctionCaching = true") and
        preservedSettings.file("dagger-module.toml").contents.contains("[runtime]") and
        preservedSettings.file("dagger.gen.go").contents.contains("var dag ")
    }
    let migrated = goSdk(dangEntrypoint: true, globalClient: true).generateScope(ws: input, isModule: true, name: "generate-app", clients: [])
    assert("explicit migration did not select the entrypoint with unified bindings") {
      migrated.file("dagger-module.toml").contents == entrypointManifest("generate-app") and
        migrated.file("internal/dagger/dagger.gen.go").contents.contains("dagger.io/dagger/core")
    }
    assert("the default migration changed the module source") {
      migrated.file("main.go").contents == input.file("main.go").contents
    }
    assert("the migrated entrypoint's dang.toml does not declare the target:\n" + migrated.file(dangConfigPath).contents) {
      configures(migrated, sdkTarget)
    }
    let embedded = goSdk(dangEntrypoint: true, unifiedClients: false, globalClient: true).generateScope(
      ws: input, isModule: true, name: "generate-app", clients: [],
    )
    assert("unifiedClients = false did not migrate the runtime module to embedded entrypoint bindings") {
      embedded.file("dagger-module.toml").contents == entrypointManifest("generate-app") and
        embedded.file("internal/dagger/entrypoint/main.dang").contents.contains("  pub sources(workspace: Workspace!): Directory! {\n") and
        embedded.file("internal/dagger/dagger.gen.go").contents.contains("GraphQLClient() graphql.Client") and
        configures(embedded, sdkTarget)
    }
    let retainedEmbedded = goSdk(globalClient: true).generateScope(
      ws: embedded, isModule: true, name: "generate-app", clients: [],
    )
    assert("unset unifiedClients changed embedded entrypoint bindings") {
      retainedEmbedded.changes(embedded).isEmpty
    }
    let unifiedAgain = goSdk(unifiedClients: true, globalClient: true).generateScope(
      ws: embedded, isModule: true, name: "generate-app", clients: [],
    )
    assert("explicit unifiedClients did not migrate embedded entrypoint bindings") {
      unifiedAgain.file("internal/dagger/dagger.gen.go").contents.contains("dagger.io/dagger/core")
    }
    let customs = [
      "name = 'generate-app'\n[runtime]\nsource = 'example.com/custom/go@v1'\n",
      "name = 'generate-app'\n[entrypoint]\nkind = 'dang'\nsource = './custom-entrypoint'\n",
      "name = 'generate-app'\n[entrypoint]\nkind = 'dang'\nsource = './internal/dagger/entrypoint'\n",
    ]
    customs.each { manifest =>
      let custom = input
        .withNewFile("dagger-module.toml", manifest)
        .withNewFile("internal/dagger/entrypoint/main.dang", "# User-authored runner, even at the SDK's usual path.\n")
        .withNewFile(dangConfigPath, "# User-authored settings.\ndang = \"2.0\"\n\n[imports.Dagger]\ndagger = \"v1.0.0-beta.18\"\n")
      [goSdk(dangEntrypoint: true, globalClient: true)].each { sdk =>
        let refused = sdk.generateScope(ws: custom, isModule: true, name: "generate-app", clients: [])
          .file("dagger-module.toml").contents rescue { err: Error => err.message }
        assert("generation replaced a custom runner: " + firstLine(refused)) {
          refused.contains("module \"generate-app\" uses a runtime or a local entrypoint that the Go SDK did not generate") and
            refused.contains("set dangEntrypoint = false")
        }
      }
      [goSdk, goSdk(dangEntrypoint: false)].each { sdk =>
        let retained = sdk.generateScope(ws: custom, isModule: true, name: "generate-app", clients: [])
        assert("automatic or explicit false generation changed a custom runner or its dang.toml") {
          retained.changes(custom).isEmpty
        }
      }
    }
    let customRuntime = input
      .withNewFile("dagger-module.toml", customs[0] ?? "")
      .withNewFile("go.mod", "module example.com/generate-app\n\ngo 1.25\n")
    let dep = [ws.moduleSource("/" + clientTargetPath)]
    let clientPath = "internal/dagger/clients/client-dep/dagger.gen.go"
    let newClient = goSdk(dangEntrypoint: false).generateScope(ws: customRuntime, isModule: true, name: "generate-app", clients: dep)
    assert("unset unifiedClients gave a new client beside a custom runtime unified bindings") {
      newClient.file(clientPath).contents.contains("dagger.ModuleGraphQLClient(") == false
    }
    let explicitUnified = goSdk(dangEntrypoint: false, unifiedClients: true).generateScope(ws: newClient, isModule: true, name: "generate-app", clients: dep)
    assert("unifiedClients = true did not migrate the client beside a custom runtime") {
      explicitUnified.file(clientPath).contents.contains("dagger.ModuleGraphQLClient(")
    }
    let keptUnified = goSdk(dangEntrypoint: false).generateScope(ws: explicitUnified, isModule: true, name: "generate-app", clients: dep)
    assert("unset unifiedClients changed the unified client beside a custom runtime") {
      keptUnified.changes(explicitUnified).isEmpty
    }
    let remotes = [
      "name = 'generate-app'\n[entrypoint]\nkind = 'dang'\nsource = 'github.com/example/sdk/entrypoint@v1'\n",
      "name = 'generate-app'\n[entrypoint]\nkind = 'dang'\nsource = 'https://example.com/sdk.git#main:entrypoint'\n",
    ]
    remotes.map { manifest =>
      let remote = input
        .withNewFile("dagger-module.toml", manifest)
        .withNewFile(dangConfigPath, "[imports.Extra]\npath = \"../extra\"\n")
      let replaced = goSdk(globalClient: true).generateScope(ws: remote, isModule: true, name: "generate-app", clients: [])
      assert("automatic generation kept a remote entrypoint:\n" + replaced.file("dagger-module.toml").contents) {
        replaced.file("dagger-module.toml").contents == entrypointManifest("generate-app") and
          replaced.file("internal/dagger/entrypoint/main.dang").contents.contains("type Entrypoint implements ModuleEntrypoint")
      }
      assert("the replaced entrypoint's dang.toml does not declare the target or keep its settings:\n" + replaced.file(dangConfigPath).contents) {
        configures(replaced, sdkTarget) and
          dangConfig(replaced).field(["imports", "Extra", "path"]).asString == "../extra"
      }
      let regenerated = goSdk(globalClient: true).generateScope(ws: replaced, isModule: true, name: "generate-app", clients: [])
      assert("generating the replaced entrypoint again changed files") { regenerated.changes(replaced).isEmpty }
      let explicitFalse = goSdk(dangEntrypoint: false, globalClient: true).generateScope(ws: remote, isModule: true, name: "generate-app", clients: [])
      assert("dangEntrypoint = false changed remote entrypoint replacement") {
        explicitFalse.changes(replaced).isEmpty
      }
      assert("replacing the remote entrypoint changed the module source") {
        explicitFalse.file("main.go").contents == remote.file("main.go").contents
      }
    }
    null
  }

  """A module sharing its parent's Go root stays on the legacy runtime."""
  goRootCheck(ws: Workspace!): Void @check {
    let scopePath = goScopePath + "/entrypoint-nested"
    let input = ws.withNewFile(scopePath + "/user.txt", "keep me\n").withWorkdir(scopePath)
    let nested = goSdk(template: "empty").generateScope(
      ws: input, isModule: true, name: "entrypoint-nested", clients: [],
    )
    assert("a fresh nested module did not get its own Go root") {
      nested.file("go.mod").contents.contains("module dagger/entrypoint-nested")
    }
    assert("a fresh nested module kept the API global") {
      nested.file("dagger.gen.go").contents.contains("var dag ") == false
    }
    assert("initializing the nested module changed its parent's Go module") {
      nested.file("/" + goScopePath + "/go.mod").contents == ws.file("/" + goScopePath + "/go.mod").contents
    }
    let existing = input
      .withNewFile("dagger-module.toml", "name = 'entrypoint-nested'\n[runtime]\nsource = 'go'\n")
      .withNewFile("main.go", "package main\n\ntype EntrypointNested struct{}\n")
    let refused = goSdk(dangEntrypoint: true, template: "empty").generateScope(
      ws: existing, isModule: true, name: "entrypoint-nested", clients: [],
    ).file("dagger.gen.go").contents rescue { err: Error => err.message }
    assert("parent go.mod was accepted: " + firstLine(refused)) {
      refused.contains("a go.mod in the module directory")
    }
    assert("the author file changed") { input.file("user.txt").contents == "keep me\n" }
    null
  }

  """An independent Go module below a parent Go tree gets an importable starter."""
  goRootDefaultTemplateCheck(ws: Workspace!): Void @check {
    let scopePath = goScopePath + "/mods/entrypoint-starter"
    let input = ws.withNewFile(scopePath + "/go.mod", "module example.com/entrypoint-starter\n\ngo 1.26\n").withWorkdir(scopePath)
    assert("root discovery ignored the module's pending go.mod") {
      goSdk.findClientRoot(input) == scopePath
    }
    let generated = goSdk(dangEntrypoint: true).generateScope(
      ws: input, isModule: true, name: "entrypoint-starter", clients: [],
    )
    assert("the starter does not import its own module client") {
      generated.file("main.go").contents.contains("\"example.com/entrypoint-starter/internal/dagger\"")
    }
    assert("the parent go.mod changed") {
      generated.withWorkdir(goScopePath).file("go.mod").contents == input.withWorkdir(goScopePath).file("go.mod").contents
    }
    let repeated = goSdk.generateScope(
      ws: generated, isModule: true, name: "entrypoint-starter", clients: [],
    )
    assert("regeneration changed the starter's compiler or files") {
      repeated.changes(generated).isEmpty
    }
    let built = container.from("golang:1.26-alpine").withoutEntrypoint
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withDirectory("/workspace", generated.directory(".")).withWorkdir("/workspace")
      .withExec(["go", "vet", "./..."], expect: ReturnType.ANY)
    assert("the starter did not build: " + built.stderr) { built.exitCode == 0 }
    null
  }

  """Generation and the emitted dispatcher honor full Go/toolchain patch versions."""
  compilerVersionCheck(ws: Workspace!): Void @check {
    let name = "compiler-version"
    let scopePath = outputRoot + "/" + name
    let source = "package compiler_version\n\nimport \"runtime\"\n\ntype CompilerVersion struct{}\nfunc (m *CompilerVersion) Version() string { return runtime.Version() }\n"
    let directives = ["go 1.26.8\n", "go 1.26.7\ntoolchain go1.26.8\n"]
    directives.each { directive =>
      let input = ws.withWorkdir(scopePath)
        .withNewFile("go.mod", "module example.com/compiler-version\n\n" + directive)
        .withNewFile("dagger-module.toml", "name = 'compiler-version'\n[runtime]\nsource = 'go'\n")
        .withNewFile("main.go", source)
      let generated = goSdk(dangEntrypoint: true).generateScope(
        ws: input, isModule: true, name: name, clients: [],
      )
      assert("generation changed the author's source") { generated.file("main.go").contents == source }
      let generatedDirectives = generated.file("go.mod").contents.split("\n")
      directive.trimSpace.split("\n").each { expected =>
        assert("generation changed the author's requirement: " + expected) {
          generatedDirectives.contains(expected)
        }
      }
      let entrypoint = generated.file("internal/dagger/entrypoint/main.dang").contents
      assert("the emitted dispatch compiler lost the selected patch version") {
        entrypoint.contains("golang:1.26.8-alpine@sha256:")
      }
      let dispatcher = container.from("golang:1.26.8-alpine").withoutEntrypoint
        .withEnvVariable("CGO_ENABLED", "0")
        .withEnvVariable("GOTOOLCHAIN", "local")
        .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
        .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
        .withDirectory("/module", generated.directory(".")).withWorkdir("/module")
        .withExec(["go", "build", "-buildvcs=false", "-o", "/usr/local/bin/dispatch", "./cmd/compiler-version-dispatch"])
      let version = dispatcher.withExec(
        ["dispatch", "engine-call"],
        stdin: JSON.encode({{
          receiverType: "CompilerVersion",
          receiverValue: "{}",
          fnName: "Version",
          fnArgs: "{}",
        }}),
        experimentalPrivilegedNesting: true,
      ).stdout.trimSpace
      assert("the generated dispatcher ran on " + version) {
        version == "\"go1.26.8\""
      }
    }
    null
  }

  """
  Generation reads a module on Go 1.27, whose compiler writes export data
  that the generator's package loader must decode to see the context
  parameter as context.Context.
  """
  go127Check(ws: Workspace!): Void @check {
    let name = "go-127"
    let scopePath = outputRoot + "/" + name
    let source = "package go_127\n\nimport \"context\"\n\ntype Go127 struct{}\n\nfunc (m *Go127) Echo(ctx context.Context, value string) string { return value }\n"
    let input = ws.withWorkdir(scopePath)
      .withNewFile("go.mod", "module example.com/go-127\n\ngo 1.27\n")
      .withNewFile("dagger-module.toml", "name = 'go-127'\n[runtime]\nsource = 'go'\n")
      .withNewFile("main.go", source)
    let generated = goSdk(dangEntrypoint: true).generateScope(
      ws: input, isModule: true, name: name, clients: [],
    )
    let entrypoint = generated.file("internal/dagger/entrypoint/main.dang").contents
    assert("the emitted dispatch compiler is not Go 1.27") {
      entrypoint.contains("golang:1.27-alpine@sha256:")
    }
    assert("the function lost its argument") {
      entrypoint.contains(".withArg(\"value\"")
    }
    assert("the context parameter became an argument") {
      entrypoint.contains(".withArg(\"ctx\"") == false
    }
    null
  }

  """
  The entrypoint names the Go image by the tag generation asks for, after the
  session resolved another tag of the same image, which an engine can report
  in its place.
  """
  goImageTagCheck(ws: Workspace!): Void @check {
    let name = "go-image-tag"
    let scopePath = outputRoot + "/" + name
    # The e2e checks share a session, so the module declares a Go version no
    # other check uses: the session resolves golang:1.27.0-alpine only here.
    # Its digest is read on another platform, which the engine keeps apart.
    let digest = container(platform: "linux/s390x").from("golang:1.27.0-alpine").imageRef.split("@")[1] ?? ""
    let other = "docker.io/library/golang:another-tag@" + digest
    assert("the image's other tag did not resolve") {
      container.from(other).imageRef == other
    }
    let input = ws.withWorkdir(scopePath)
      .withNewFile("go.mod", "module example.com/go-image-tag\n\ngo 1.27.0\n")
      .withNewFile("dagger-module.toml", "name = 'go-image-tag'\n[runtime]\nsource = 'go'\n")
      .withNewFile("main.go", "package go_image_tag\n\ntype GoImageTag struct{}\n\nfunc (m *GoImageTag) Echo(value string) string { return value }\n")
    let generated = goSdk(dangEntrypoint: true).generateScope(
      ws: input, isModule: true, name: name, clients: [],
    )
    let entrypoint = generated.file("internal/dagger/entrypoint/main.dang").contents
    assert("the entrypoint does not name golang:1.27.0-alpine by its digest") {
      entrypoint.contains(".from(\"golang:1.27.0-alpine@" + digest + "\")")
    }
    null
  }

  """
  dangEntrypoint refuses what a manifest with an entrypoint cannot carry,
  and a module with a Dang entrypoint is not moved back to the Go runtime.
  """
  refusalsCheck(ws: Workspace!): Void @check {
    let app = ws.withWorkdir(appPath)
    let remoteManifest = "name = 'generate-app'\n[entrypoint]\nkind = 'dang'\nsource = 'github.com/example/sdk/entrypoint@v1'\n"
    let remote = app.withNewFile("dagger-module.toml", remoteManifest)

    let withClient = goSdk(dangEntrypoint: false, unifiedClients: false).generateScope(
      ws: remote,
      isModule: true,
      name: "generate-app",
      clients: [ws.moduleSource("/" + clientTargetPath)],
    ).file("dagger.gen.go").contents rescue {
      err: Error => err.message
    }
    assert("a client was accepted: " + firstLine(withClient)) {
      withClient.contains("set unifiedClients = true in the scope's settings in dagger.toml")
    }

    let legacyPath = outputRoot + "/entrypoint-legacy"
    let legacy = goSdk(template: "legacy").generateScope(
      ws: ws.withNewDirectory(legacyPath, directory).withWorkdir(legacyPath),
      isModule: true,
      name: "entrypoint-legacy",
      clients: [],
    ).file("dagger.gen.go").contents rescue {
      err: Error => err.message
    }
    assert("the legacy template was accepted on default settings: " + firstLine(legacy)) {
      legacy.contains("legacy template") and legacy.contains("set dangEntrypoint = false and unifiedClients = false")
    }

    # Package main uses a dispatcher in the author package.
    let mainPath = outputRoot + "/entrypoint-main"
    let packageMain = goSdk(dangEntrypoint: true).generateScope(
      ws: ws
        .withNewFile(mainPath + "/dagger-module.toml", "name = \"entrypoint-main\"\n")
        .withNewFile(mainPath + "/main.go", "package main\n\ntype EntrypointMain struct{}\n")
        .withWorkdir(mainPath),
      isModule: true,
      name: "entrypoint-main",
      clients: [],
    ).file("dagger.dispatch.gen.go").contents
    assert("package main dispatcher was not generated") {
      packageMain.contains("package main") and packageMain.contains("func main()")
    }

    # Settings a manifest with an entrypoint would drop are refused, before
    # anything is written.
    let droppedTOML = "name = \"generate-app\"\ninclude = [\"extra\"]\ndisableDefaultFunctionCaching = true\nsource = \"src\"\n\n" +
      "[runtime]\n  source = \"python\"\n\n[codegen]\n  automaticGitignore = false\n\n" +
      "[[clients]]\n  generator = \"go\"\n  directory = \"client\"\n\n" +
      "[[dependencies]]\n  name = \"dep\"\n  source = \"../dep\"\n\n" +
      "[entrypoint]\n  kind = 'dang'\n  source = 'github.com/example/sdk/entrypoint@v1'\n"
    let dropped = goSdk(dangEntrypoint: false).generateScope(
      ws: app.withNewFile("dagger-module.toml", droppedTOML),
      isModule: true,
      name: "generate-app",
      clients: [],
    ).file("dagger.gen.go").contents rescue {
      err: Error => err.message
    }
    assert("dropped manifest settings were accepted: " + firstLine(dropped)) {
      dropped.contains("dagger-module.toml has settings a Dang entrypoint cannot carry (disableDefaultFunctionCaching, source, clients, runtime); remove them before generating")
    }

    let droppedJSON = "{\"name\": \"generate-app\", \"sdk\": \"go\", \"dependencies\": [{\"name\": \"dep\", \"source\": \"../dep\"}]}\n"
    let droppedLegacy = goSdk(dangEntrypoint: false).generateScope(
      ws: remote.withNewFile("dagger.json", droppedJSON),
      isModule: true,
      name: "generate-app",
      clients: [],
    ).file("dagger.gen.go").contents rescue {
      err: Error => err.message
    }
    assert("dropped dagger.json settings were accepted: " + firstLine(droppedLegacy)) {
      droppedLegacy.contains("dagger.json depends on dep, which the scope's clients do not list")
    }

    let nestedPath = goScopePath + "/remote-entrypoint"
    let nested = ws
      .withNewFile(nestedPath + "/dagger-module.toml", remoteManifest)
      .withNewFile(nestedPath + "/main.go", "package generate_app\n\ntype GenerateApp struct{}\n")
      .withWorkdir(nestedPath)
    let parentGoMod = goSdk(dangEntrypoint: false).generateScope(
      ws: nested, isModule: true, name: "generate-app", clients: [],
    ).file("dagger.gen.go").contents rescue { err: Error => err.message }
    assert("parent go.mod refusal lacks a usable remedy: " + firstLine(parentGoMod)) {
      parentGoMod.contains("create a go.mod there before generating")
    }
    let independent = goSdk(dangEntrypoint: false).generateScope(
      ws: nested.withNewFile("go.mod", "module example.com/remote-entrypoint\n\ngo 1.26.1\n"),
      isModule: true, name: "generate-app", clients: [],
    )
    assert("creating a module-local go.mod did not allow remote entrypoint migration") {
      independent.file("dagger-module.toml").contents == entrypointManifest("generate-app") and
        independent.file("internal/dagger/entrypoint/main.dang").contents.contains("type Entrypoint implements ModuleEntrypoint")
    }
    [withClient, dropped, droppedLegacy, parentGoMod].map { refusal =>
      assert("a remote entrypoint refusal recommends an ineffective opt-out: " + firstLine(refusal)) {
        refusal.contains("dangEntrypoint = false") == false
      }
    }

    # Any local Dang entrypoint keeps the module off the Go runtime, however
    # the TOML spells it.
    let entrypointTables = [
      entrypointManifest("generate-app"),
      "name = 'generate-app'\n\n[entrypoint]\n  kind = 'dang'\n  source = './internal/dagger/entrypoint'\n",
      "name = \"generate-app\"\nentrypoint = { kind = \"dang\", source = \"internal/dagger/entrypoint\" }\n",
    ]
    entrypointTables.map { manifest =>
      let switched = goSdk(dangEntrypoint: false).generateScope(
        ws: app
          .withNewFile("dagger-module.toml", manifest)
          .withNewFile("internal/dagger/entrypoint/main.dang", "# Code generated by dagger. Do not edit.\n"),
        isModule: true,
        name: "generate-app",
        clients: [],
      ).file("dagger.gen.go").contents rescue {
        err: Error => err.message
      }
      assert("a Dang entrypoint module was moved to the Go runtime: " + firstLine(switched) + "\n" + manifest) {
        switched.contains("set dangEntrypoint = true")
      }
    }
    null
  }

  let firstLine(text: String!): String! {
    text.split("\n")[0] ?? ""
  }

  """A call request as the generated entrypoint encodes it."""
  let callRequest(fnName: String!, receiverValue: String, fnArgs: String!): String! {
    JSON.encode({{
      receiverType: "GenerateApp",
      receiverValue: receiverValue,
      fnName: fnName,
      fnArgs: fnArgs,
    }})
  }

  """Run one engine-mode call and return its JSON result."""
  let engineCall(ctr: Container!, fnName: String!, receiverValue: String, fnArgs: String!): String! {
    ctr
      .withExec(
        ["dispatch", "engine-call"],
        stdin: callRequest(fnName, receiverValue, fnArgs),
        experimentalPrivilegedNesting: true,
      )
      .stdout
      .trimSuffix("\n")
  }
}
