"""
Run the Go SDK with dangEntrypoint.
"""
type EntrypointChecks {
  let fixtureRoot: String! = ".dagger/modules/e2e/fixtures"
  let outputRoot: String! = ".dagger/modules/e2e/out"
  # A Go module without a manifest. Each check writes the manifest it needs.
  let appPath: String! = fixtureRoot + "/generate/app"
  let clientTargetPath: String! = fixtureRoot + "/client/dep"
  let goScopePath: String! = fixtureRoot + "/go-scope"

  let exists(ws: Workspace!, path: String!): Boolean! {
    ws.directory(".", include: [path]).exists(path)
  }

  """The manifest dangEntrypoint writes: the name and the entrypoint only."""
  let entrypointManifest(name: String!): String! {
    "name = " + JSON.encode(name) +
      "\n\n[entrypoint]\n  kind = \"dang\"\n  source = \"./internal/dagger/entrypoint\"\n"
  }

  """
  A new module gets an importable starter, the entrypoint manifest, the
  shared-core client without a global dag, the dispatch command, and the Dang
  entrypoint. It compiles against the published runtime without replacements.
  Regeneration reads the entrypoint manifest and changes nothing.
  """
  moduleInitCheck(ws: Workspace!): Void @check {
    let scopePath = outputRoot + "/entrypoint-init"
    let input = ws
      .withNewFile(scopePath + "/user.txt", "keep me\n")
      .withWorkdir(scopePath)
    let generated = goSdk.generateScope(
      ws: input,
      isModule: true,
      name: "entrypoint-init",
      clients: [],
    )

    assert("the manifest is not the entrypoint manifest") {
      generated.file("dagger-module.toml").contents == entrypointManifest("entrypoint-init")
    }
    assert("dagger.json was created") {
      exists(generated, "dagger.json") == false
    }
    assert("the starter is not an importable package") {
      generated.file("main.go").contents.hasPrefix("package entrypoint_init\n")
    }
    assert("go.mod was not created") {
      exists(generated, "go.mod")
    }
    assert("the module dispatcher was not generated") {
      generated.file("dagger.gen.go").contents.contains("func DaggerDispatch(")
    }
    assert("a new module has a global client") {
      generated.file("dagger.gen.go").contents.contains("var dag ") == false and
      generated.file("internal/dagger/dagger.gen.go").contents.contains("var dag ") == false
    }
    assert("the starter uses the removed global client") {
      generated.file("main.go").contents.contains("dag.") == false
    }
    assert("the module client was not generated") {
      exists(generated, "internal/dagger/dagger.gen.go")
    }
    assert("the module client was generated twice") {
      exists(generated, "internal/dagger/internal") == false
    }
    assert("the dispatch command was not generated") {
      exists(generated, "cmd/entrypoint-init-dispatch/main.go")
    }
    assert("the Dang entrypoint was not generated") {
      generated.file("internal/dagger/entrypoint/main.dang").contents.contains("type Entrypoint implements ModuleEntrypoint")
    }
    assert("an existing file was not preserved") {
      generated.file("user.txt").contents == "keep me\n"
    }
    assert("generation changed the current directory") {
      generated.cwd == input.cwd
    }

    let regenerated = goSdk.generateScope(
      ws: generated,
      isModule: true,
      name: "entrypoint-init",
      clients: [],
    )
    assert("regeneration was not stable") {
      regenerated.changes(generated).isEmpty
    }

    let recovered = goSdk.generateScope(
      ws: generated.withoutFile("internal/dagger/entrypoint/main.dang"),
      isModule: true, name: "entrypoint-init", clients: [],
    )
    assert("automatic regeneration did not recover its deleted entrypoint") {
      recovered.changes(generated).isEmpty
    }

    # A binding an earlier schema generated is removed from the workspace. A
    # user file next to it is not generated code, so it stays.
    let userBinding = "package dagger\n\nfunc userHelper() {}\n"
    let seeded = generated
      .withNewFile("internal/dagger/obsolete.gen.go", "// Code generated by dagger. DO NOT EDIT.\n\npackage dagger\n\nfunc obsoleteBinding() {}\n")
      .withNewFile("internal/dagger/user.gen.go", userBinding)
    let pruned = goSdk(dangEntrypoint: true).generateScope(
      ws: seeded,
      isModule: true,
      name: "entrypoint-init",
      clients: [],
    )
    assert("an obsolete generated file was kept") {
      exists(pruned, "internal/dagger/obsolete.gen.go") == false
    }
    assert("a user file next to the generated client was removed") {
      pruned.file("internal/dagger/user.gen.go").contents == userBinding
    }
    assert("removing an obsolete file changed anything else") {
      pruned.withoutFile("internal/dagger/user.gen.go").changes(generated).isEmpty
    }
    null
  }

  """
  An existing Go runtime module moves to a Dang entrypoint. The entrypoint
  describes its types, and the dispatch command serves the requests the
  entrypoint sends, in engine mode and in developer mode.
  """
  generateCheck(ws: Workspace!): Void @check {
    let legacyJSON = "{\n  \"name\": \"generate-app\",\n  \"engineVersion\": \"v1.0.0-beta.14\",\n  \"sdk\": {\n    \"source\": \"go\"\n  }\n}\n"
    # A Go runtime and the module's own source are what the new manifest
    # replaces, so they are not refused, in either quote style.
    let legacyTOML = "name = \"generate-app\"\nsource = './'\n\n[runtime]\n  source = 'go'\n"
    let input = ws
      .withNewFile(appPath + "/dagger.json", legacyJSON)
      .withNewFile(appPath + "/dagger-module.toml", legacyTOML)
      .withWorkdir(appPath)
    let generated = goSdk(dangEntrypoint: true).generateScope(
      ws: input,
      isModule: true,
      name: "generate-app",
      clients: [],
    )

    assert("the manifest is not the entrypoint manifest") {
      generated.file("dagger-module.toml").contents == entrypointManifest("generate-app")
    }
    assert("dagger.json was not removed") {
      exists(generated, "dagger.json") == false
    }
    assert("the module source changed") {
      generated.file("main.go").contents == input.file("main.go").contents
    }
    assert("migration removed the legacy module's global client") {
      generated.file("dagger.gen.go").contents.contains("var dag ")
    }
    let compatibilityRepeated = goSdk(dangEntrypoint: true).generateScope(
      ws: generated, isModule: true, name: "generate-app", clients: [],
    )
    assert("migration did not preserve its compatibility decision") {
      compatibilityRepeated.changes(generated).isEmpty
    }

    let entrypoint = generated.file("internal/dagger/entrypoint/main.dang").contents
    assert("the entrypoint does not take fnArgs as a JSON object") {
      entrypoint.contains("fnArgs: JSON!,")
    }
    assert("the entrypoint does not pass fnArgs to the dispatch command") {
      entrypoint.contains("fnArgs: fnArgs,")
    }
    assert("the entrypoint still uses the argument list") {
      entrypoint.contains("FunctionCallArgValue") == false
    }
    assert("the constructor does not use the empty function name") {
      entrypoint.contains("function(\"\", typeDef.withObject(\"GenerateApp\"))")
    }
    assert("the default value is not JSON text") {
      entrypoint.contains("defaultValue: (\"\\\"Hello\\\"\" :: Dagger.JSON!)")
    }
    assert("the entrypoint does not build the dispatch command in the module") {
      entrypoint.contains("\"./cmd/generate-app-dispatch\"")
    }

    let dispatcher = container
      .from("golang:1.26-alpine")
      .withoutEntrypoint
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withDirectory("/module", generated.directory("."))
      .withWorkdir("/module")
      .withExec(["go", "vet", "./..."])
      .withExec(["go", "build", "-o", "/usr/local/bin/dispatch", "./cmd/generate-app-dispatch"])

    let developer = dispatcher
      .withExec(["dispatch", "call", "repeat", "--value", "x", "--count", "2"])
      .stdout
    assert("developer mode returned " + developer) {
      developer == "[\"x\",\"x\"]\n"
    }
    let developerReceiver = dispatcher
      .withExec(["dispatch", "call", "greet", "--name", "World", "--receiver-json", "{\"Prefix\":\"Hey\"}"])
      .stdout
    assert("developer mode with a receiver returned " + developerReceiver) {
      developerReceiver == "Hey, World\n"
    }

    let engine = container
      .from("alpine:3.22")
      .withFile("/usr/local/bin/dispatch", dispatcher.file("/usr/local/bin/dispatch"), permissions: 755)
    let constructed = engineCall(engine, "", null, "{\"prefix\":\"Hi\"}")
    assert("the constructor returned " + constructed) {
      constructed == "{\"Prefix\":\"Hi\"}"
    }
    let greeted = engineCall(engine, "Greet", constructed, "{\"name\":\"World\"}")
    assert("the receiver state was not used: " + greeted) {
      greeted == "\"Hi, World\""
    }
    let repeated = engineCall(engine, "Repeat", "{}", "{\"value\":\"x\",\"count\":2}")
    assert("the list codec returned " + repeated) {
      repeated == "[\"x\",\"x\"]"
    }
    let optional = engineCall(engine, "Optional", "{}", "{\"value\":null}")
    assert("the optional codec returned " + optional) {
      optional == "null"
    }
    let status = engineCall(engine, "Status", "{}", "{}")
    assert("the enum codec returned " + status) {
      status == "\"Ready\""
    }
    let voided = engineCall(engine, "Void", "{}", "{}")
    assert("the void codec returned " + voided) {
      voided == "null"
    }
    let echoed = engineCall(engine, "DaggerEcho", "{}", "{\"value\":\"nested\"}")
    assert("the nested Dagger call returned " + echoed) {
      echoed == "\"nested\""
    }
    let containerID = engineCall(engine, "Container", "{}", "{\"value\":\"resource\"}")
    let read = engineCall(engine, "ReadContainer", "{}", "{\"container\":" + containerID + "}")
    assert("the core object ID did not round trip: " + read) {
      read == "\"resource\""
    }

    let failed = engine.withExec(
      ["dispatch", "engine-call"],
      stdin: callRequest("Fail", "{}", "{}"),
      experimentalPrivilegedNesting: true,
      expect: ReturnType.ANY,
    )
    assert("a Go error did not fail the call") {
      failed.exitCode != 0
    }
    assert("the Go error was not reported") {
      failed.stderr.contains("fixture failure")
    }
    null
  }

  """
  Explicit removal overrides legacy detection. The SDK keeps author source
  unchanged on failure, and remembers the choice after the author migrates.
  """
  globalClientCompatibilityCheck(ws: Workspace!): Void @check {
    let input = ws
      .withNewFile(appPath + "/dagger-module.toml", "name = \"generate-app\"\n\n[runtime]\nsource = \"go\"\n")
      .withWorkdir(appPath)
    let refused = goSdk(dangEntrypoint: true, globalClient: false).generateScope(
      ws: input, isModule: true, name: "generate-app", clients: [],
    ).file("dagger.gen.go").contents rescue { err: Error => err.message }
    assert("unmigrated author code unexpectedly compiled without dag: " + refused) {
      refused.contains("undefined: dag")
    }
    let migratedSource = input.file("main.go").contents.replace("dag.", "dagger.Connect().")
    let noGlobal = goSdk(dangEntrypoint: true, globalClient: false).generateScope(
      ws: input.withNewFile("main.go", migratedSource), isModule: true, name: "generate-app", clients: [],
    )
    assert("explicit false kept the legacy global") {
      noGlobal.file("dagger.gen.go").contents.contains("var dag ") == false
    }
    assert("generation changed migrated author source") {
      noGlobal.file("main.go").contents == migratedSource
    }
    let repeated = goSdk(dangEntrypoint: true).generateScope(
      ws: noGlobal, isModule: true, name: "generate-app", clients: [],
    )
    assert("automatic regeneration forgot explicit false") {
      repeated.changes(noGlobal).isEmpty
    }
    let built = container.from("golang:1.26-alpine").withoutEntrypoint
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withDirectory("/module", repeated.directory(".")).withWorkdir("/module")
      .withExec(["go", "build", "-o", "/usr/local/bin/dispatch", "./cmd/generate-app-dispatch"])
    let echoed = engineCall(built, "DaggerEcho", "{}", "{\"value\":\"without-global\"}")
    assert("explicit clients failed after removing the global: " + echoed) {
      echoed == "\"without-global\""
    }
    let legacyRefused = goSdk(globalClient: false).generateScope(
      ws: input, isModule: true, name: "generate-app", clients: [],
    ).file("dagger.gen.go").contents rescue { err: Error => err.message }
    assert("legacy runtime silently ignored explicit false: " + legacyRefused) {
      legacyRefused.contains("globalClient = false requires dangEntrypoint = true")
    }
    null
  }

  """Automatic mode preserves existing legacy and custom runners."""
  defaultCompatibilityCheck(ws: Workspace!): Void @check {
    let legacyManifest = "name = 'generate-app'\n[runtime]\nsource = 'go'\n"
    let input = ws.withWorkdir(appPath).withNewFile("dagger-module.toml", legacyManifest)
    let legacy = goSdk.generateScope(ws: input, isModule: true, name: "generate-app", clients: [])
    assert("automatic generation migrated an existing runtime module") {
      legacy.file("dagger-module.toml").contents.contains("[runtime]") and
        exists(legacy, "internal/dagger/entrypoint/main.dang") == false
    }
    assert("automatic generation removed the legacy API global") {
      legacy.file("dagger.gen.go").contents.contains("var dag ")
    }
    let embedded = goSdk(dangEntrypoint: true, unifiedClients: false).generateScope(
      ws: input, isModule: true, name: "generate-app", clients: [],
    )
    let retainedEmbedded = goSdk.generateScope(
      ws: embedded, isModule: true, name: "generate-app", clients: [],
    )
    assert("automatic regeneration changed existing embedded entrypoint bindings") {
      retainedEmbedded.changes(embedded).isEmpty and
        retainedEmbedded.file("internal/dagger/dagger.gen.go").contents.contains("GraphQLClient() graphql.Client")
    }
    let customs = [
      "name = 'generate-app'\n[runtime]\nsource = 'example.com/custom/go@v1'\n",
      "name = 'generate-app'\n[entrypoint]\nkind = 'dang'\nsource = './custom-entrypoint'\n",
      "name = 'generate-app'\n[entrypoint]\nkind = 'dang'\nsource = './internal/dagger/entrypoint'\n",
    ]
    customs.map { manifest =>
      let custom = input
        .withNewFile("dagger-module.toml", manifest)
        .withNewFile("internal/dagger/entrypoint/main.dang", "# User-authored runner, even at the SDK's usual path.\n")
      let retained = goSdk.generateScope(ws: custom, isModule: true, name: "generate-app", clients: [])
      assert("automatic generation replaced a custom runner") {
        retained.changes(custom).isEmpty
      }
    }
    null
  }

  """A module sharing its parent's Go root stays on the legacy runtime."""
  goRootCheck(ws: Workspace!): Void @check {
    let scopePath = goScopePath + "/entrypoint-nested"
    let input = ws.withNewFile(scopePath + "/user.txt", "keep me\n").withWorkdir(scopePath)
    let nested = goSdk(template: "empty").generateScope(
      ws: input, isModule: true, name: "entrypoint-nested", clients: [],
    )
    assert("a fresh nested module did not get its own Go root") {
      nested.file("go.mod").contents.contains("module dagger/entrypoint-nested")
    }
    assert("a fresh nested module kept the API global") {
      nested.file("dagger.gen.go").contents.contains("var dag ") == false
    }
    assert("initializing the nested module changed its parent's Go module") {
      nested.file("/" + goScopePath + "/go.mod").contents == ws.file("/" + goScopePath + "/go.mod").contents
    }
    let existing = input
      .withNewFile("dagger-module.toml", "name = 'entrypoint-nested'\n[runtime]\nsource = 'go'\n")
      .withNewFile("main.go", "package main\n\ntype EntrypointNested struct{}\n")
    let refused = goSdk(dangEntrypoint: true, template: "empty").generateScope(
      ws: existing, isModule: true, name: "entrypoint-nested", clients: [],
    ).file("dagger.gen.go").contents rescue { err: Error => err.message }
    assert("parent go.mod was accepted: " + firstLine(refused)) {
      refused.contains("a go.mod in the module directory")
    }
    assert("the author file changed") { input.file("user.txt").contents == "keep me\n" }
    null
  }

  """An independent Go module below a parent Go tree gets an importable starter."""
  goRootDefaultTemplateCheck(ws: Workspace!): Void @check {
    let scopePath = goScopePath + "/mods/entrypoint-starter"
    let input = ws.withNewFile(scopePath + "/go.mod", "module example.com/entrypoint-starter\n\ngo 1.26\n").withWorkdir(scopePath)
    assert("root discovery ignored the module's pending go.mod") {
      goSdk.findClientRoot(input) == scopePath
    }
    let generated = goSdk(dangEntrypoint: true).generateScope(
      ws: input, isModule: true, name: "entrypoint-starter", clients: [],
    )
    assert("the starter does not import its own module client") {
      generated.file("main.go").contents.contains("\"example.com/entrypoint-starter/internal/dagger\"")
    }
    assert("the parent go.mod changed") {
      generated.withWorkdir(goScopePath).file("go.mod").contents == input.withWorkdir(goScopePath).file("go.mod").contents
    }
    let built = container.from("golang:1.26-alpine").withoutEntrypoint
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withDirectory("/workspace", generated.directory(".")).withWorkdir("/workspace")
      .withExec(["go", "vet", "./..."], expect: ReturnType.ANY)
    assert("the starter did not build: " + built.stderr) { built.exitCode == 0 }
    null
  }

  """Generation and the emitted dispatcher honor full Go/toolchain patch versions."""
  compilerVersionCheck(ws: Workspace!): Void @check {
    let name = "compiler-version"
    let scopePath = outputRoot + "/" + name
    let source = "package compiler_version\n\nimport \"runtime\"\n\ntype CompilerVersion struct{}\nfunc (m *CompilerVersion) Version() string { return runtime.Version() }\n"
    let directives = ["go 1.26.8\n", "go 1.26.7\ntoolchain go1.26.8\n"]
    directives.each { directive =>
      let input = ws.withWorkdir(scopePath)
        .withNewFile("go.mod", "module example.com/compiler-version\n\n" + directive)
        .withNewFile("dagger-module.toml", "name = 'compiler-version'\n[runtime]\nsource = 'go'\n")
        .withNewFile("main.go", source)
      let generated = goSdk(dangEntrypoint: true).generateScope(
        ws: input, isModule: true, name: name, clients: [],
      )
      assert("generation changed the author's source") { generated.file("main.go").contents == source }
      let generatedDirectives = generated.file("go.mod").contents.split("\n")
      directive.trimSpace.split("\n").each { expected =>
        assert("generation changed the author's requirement: " + expected) {
          generatedDirectives.contains(expected)
        }
      }
      let entrypoint = generated.file("internal/dagger/entrypoint/main.dang").contents
      assert("the emitted dispatch compiler lost the selected patch version") {
        entrypoint.contains(".from(\"golang:1.26.8-alpine\")")
      }
      let dispatcher = container.from("golang:1.26.8-alpine").withoutEntrypoint
        .withEnvVariable("CGO_ENABLED", "0")
        .withEnvVariable("GOTOOLCHAIN", "local")
        .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
        .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
        .withDirectory("/module", generated.directory(".")).withWorkdir("/module")
        .withExec(["go", "build", "-buildvcs=false", "-o", "/usr/local/bin/dispatch", "./cmd/compiler-version-dispatch"])
      let version = dispatcher.withExec(
        ["dispatch", "engine-call"],
        stdin: JSON.encode({{
          receiverType: "CompilerVersion",
          receiverValue: "{}",
          fnName: "Version",
          fnArgs: "{}",
        }}),
        experimentalPrivilegedNesting: true,
      ).stdout.trimSpace
      assert("the generated dispatcher ran on " + version) {
        version == "\"go1.26.8\""
      }
    }
    null
  }

  """
  dangEntrypoint refuses what a manifest with an entrypoint cannot carry,
  and a module with a Dang entrypoint is not moved back to the Go runtime.
  """
  refusalsCheck(ws: Workspace!): Void @check {
    let app = ws.withWorkdir(appPath)

    let withClient = goSdk(dangEntrypoint: true, unifiedClients: false).generateScope(
      ws: app,
      isModule: true,
      name: "generate-app",
      clients: [ws.moduleSource("/" + clientTargetPath)],
    ).file("dagger.gen.go").contents rescue {
      err: Error => err.message
    }
    assert("a client was accepted: " + firstLine(withClient)) {
      withClient.contains("set dangEntrypoint = false")
    }

    let legacyPath = outputRoot + "/entrypoint-legacy"
    let legacy = goSdk(dangEntrypoint: true, template: "legacy").generateScope(
      ws: ws.withNewDirectory(legacyPath, directory).withWorkdir(legacyPath),
      isModule: true,
      name: "entrypoint-legacy",
      clients: [],
    ).file("dagger.gen.go").contents rescue {
      err: Error => err.message
    }
    assert("the legacy template was accepted: " + firstLine(legacy)) {
      legacy.contains("legacy template")
    }

    let fat = goSdk(dangEntrypoint: true, fat: true).generateScope(
      ws: app,
      isModule: true,
      name: "generate-app",
      clients: [],
    ).file("dagger.gen.go").contents rescue {
      err: Error => err.message
    }
    assert("a fat module was accepted: " + firstLine(fat)) {
      fat.contains("set fat = false")
    }

    # Package main uses a dispatcher in the author package.
    let mainPath = outputRoot + "/entrypoint-main"
    let packageMain = goSdk(dangEntrypoint: true).generateScope(
      ws: ws
        .withNewFile(mainPath + "/dagger-module.toml", "name = \"entrypoint-main\"\n")
        .withNewFile(mainPath + "/main.go", "package main\n\ntype EntrypointMain struct{}\n")
        .withWorkdir(mainPath),
      isModule: true,
      name: "entrypoint-main",
      clients: [],
    ).file("dagger.dispatch.gen.go").contents
    assert("package main dispatcher was not generated") {
      packageMain.contains("package main") and packageMain.contains("func main()")
    }

    # Settings a manifest with an entrypoint would drop are refused, before
    # anything is written.
    let droppedTOML = "name = \"generate-app\"\ninclude = [\"extra\"]\ndisableDefaultFunctionCaching = true\nsource = \"src\"\n\n" +
      "[runtime]\n  source = \"python\"\n\n[codegen]\n  automaticGitignore = false\n\n" +
      "[[clients]]\n  generator = \"go\"\n  directory = \"client\"\n\n" +
      "[[dependencies]]\n  name = \"dep\"\n  source = \"../dep\"\n"
    let dropped = goSdk(dangEntrypoint: true).generateScope(
      ws: app.withNewFile("dagger-module.toml", droppedTOML),
      isModule: true,
      name: "generate-app",
      clients: [],
    ).file("dagger.gen.go").contents rescue {
      err: Error => err.message
    }
    assert("dropped manifest settings were accepted: " + firstLine(dropped)) {
      dropped.contains("dagger-module.toml has settings a Dang entrypoint cannot carry (include, disableDefaultFunctionCaching, source, codegen, clients, dependencies, runtime); remove them or set dangEntrypoint = false")
    }

    let droppedJSON = "{\"name\": \"generate-app\", \"sdk\": \"go\", \"dependencies\": [{\"name\": \"dep\", \"source\": \"../dep\"}]}\n"
    let droppedLegacy = goSdk(dangEntrypoint: true).generateScope(
      ws: app.withNewFile("dagger.json", droppedJSON),
      isModule: true,
      name: "generate-app",
      clients: [],
    ).file("dagger.gen.go").contents rescue {
      err: Error => err.message
    }
    assert("dropped dagger.json settings were accepted: " + firstLine(droppedLegacy)) {
      droppedLegacy.contains("dagger.json has settings a Dang entrypoint cannot carry (dependencies)")
    }

    # Any local Dang entrypoint keeps the module off the Go runtime, however
    # the TOML spells it.
    let entrypointTables = [
      entrypointManifest("generate-app"),
      "name = 'generate-app'\n\n[entrypoint]\n  kind = 'dang'\n  source = './internal/dagger/entrypoint'\n",
      "name = \"generate-app\"\nentrypoint = { kind = \"dang\", source = \"internal/dagger/entrypoint\" }\n",
    ]
    entrypointTables.map { manifest =>
      let switched = goSdk(dangEntrypoint: false).generateScope(
        ws: app
          .withNewFile("dagger-module.toml", manifest)
          .withNewFile("internal/dagger/entrypoint/main.dang", "# Code generated by dagger. Do not edit.\n"),
        isModule: true,
        name: "generate-app",
        clients: [],
      ).file("dagger.gen.go").contents rescue {
        err: Error => err.message
      }
      assert("a Dang entrypoint module was moved to the Go runtime: " + firstLine(switched) + "\n" + manifest) {
        switched.contains("set dangEntrypoint = true")
      }
    }
    null
  }

  let firstLine(text: String!): String! {
    text.split("\n")[0] ?? ""
  }

  """A call request as the generated entrypoint encodes it."""
  let callRequest(fnName: String!, receiverValue: String, fnArgs: String!): String! {
    JSON.encode({{
      receiverType: "GenerateApp",
      receiverValue: receiverValue,
      fnName: fnName,
      fnArgs: fnArgs,
    }})
  }

  """Run one engine-mode call and return its JSON result."""
  let engineCall(ctr: Container!, fnName: String!, receiverValue: String, fnArgs: String!): String! {
    ctr
      .withExec(
        ["dispatch", "engine-call"],
        stdin: callRequest(fnName, receiverValue, fnArgs),
        experimentalPrivilegedNesting: true,
      )
      .stdout
      .trimSuffix("\n")
  }
}
