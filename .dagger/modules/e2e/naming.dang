"""
Generate and call a module whose schema names differ between the engine's
identifier naming rules and the legacy strcase rules: the bindings take the
module's schema names from the engine (ModuleSource.naming), and Go
identifiers are the engine's formatting at the version of the schema the
bindings are generated from.

It needs an engine at v1.0.0-beta.26 or later, so no check runs it yet. cli
is that engine's dagger CLI, which runs nested in this session:

  dagger -m .dagger/modules/e2e call naming --cli "$(command -v dagger)" calls-check --ws .
"""
type NamingChecks {
  cli: File

  let fixture: String! = ".dagger/modules/e2e/fixtures/naming"

  """
  The fixture generated as an embedded entrypoint module. Generation writes
  the target's v1.0.0-beta.26 dang.toml before asking for the module's names.
  With pinned, an existing pre-cut import is upgraded; without it, the
  generated import is new.
  """
  generated(ws: Workspace!, pinned: Boolean! = false): Directory! {
    generatedScope(ws, pinned).directory(".")
  }

  """
  The module is generated in a workspace of its own: this repository's
  .gitignore ignores dang.toml, which would hide the pin from the engine.
  """
  let generatedScope(ws: Workspace!, pinned: Boolean!): Workspace! {
    let module = ws.directory("/" + fixture)
    let source = if (pinned) {
      module.withNewFile("internal/dagger/entrypoint/dang.toml", "[imports.Dagger]\ndagger = \"v1.0.0-beta.25\"\n")
    } else { module }
    goSdk(dangEntrypoint: true, unifiedClients: false, globalClient: true).generateScope(
      ws: directory.withDirectory("naming-app", source).asWorkspace.withWorkdir("naming-app"),
      isModule: true, name: "naming-app", clients: [],
    )
  }

  """Call the generated module with the nested CLI: dagger call <args>."""
  let call(module: Directory!, args: String!): String! {
    if (cli == null) {
      raise "calls need --cli, the dagger CLI of the engine under test"
    }
    let called = container.from("alpine:3.22").withoutEntrypoint
      .withFile("/usr/local/bin/dagger", cli, permissions: 755)
      .withDirectory("/work", module)
      .withWorkdir("/work")
      .withExec(["sh", "-c", "dagger -m . call " + args],
        experimentalPrivilegedNesting: true, expect: ReturnType.ANY)
    if (called.exitCode != 0) {
      raise "dagger call " + args + " failed:\n" + called.stdout + called.stderr
    }
    called.stdout.trimSpace
  }

  """
  The interface bindings load a module interface and select its functions by
  the names the engine gives them at the generated target, both when adding
  dang.toml and when upgrading a pre-cut import. The module's functions answer
  by the engine's names, through the main object the entrypoint constructs.
  The bindings' Go identifiers are the engine's formatting either way
  (GitCommit.ShortSHA). The module calls itself only through a client added
  with dagger module client add ., generated from the schema the engine
  serves, so no bindings here predict its functions.
  """
  callsCheck(ws: Workspace!): Void {
    [
      {{pinned: false, fetcher: "\"NamingAppHTTPFetcher\"", field: "Select(\"e2eTest\")", peer: "InlineFragment(\"NamingAppHTTPFetcher\")", e2e: "e2e-test", arch: "ARM64"}},
      {{pinned: true, fetcher: "\"NamingAppHTTPFetcher\"", field: "Select(\"e2eTest\")", peer: "InlineFragment(\"NamingAppHTTPFetcher\")", e2e: "e2e-test", arch: "ARM64"}},
    ].each { want =>
      let generated = generatedScope(ws, want.pinned)
      let module = generated.directory(".")
      let label = if (want.pinned) { "the upgraded module" } else { "the new module" }
      assert(label + " does not declare the target") {
        module.file("internal/dagger/entrypoint/dang.toml").contents.contains("v1.0.0-beta.26")
      }
      let again = goSdk(dangEntrypoint: true, unifiedClients: false, globalClient: true).generateScope(
        ws: generated, isModule: true, name: "naming-app", clients: [],
      )
      assert(label + " changed on regeneration") { again.changes(generated).isEmpty }
      let bindings = module.file("dagger.gen.go").contents
      [want.fetcher, want.field, want.peer].each { name =>
        assert(label + "'s interface bindings lack " + name) { bindings.contains(name) }
      }
      assert(label + "'s core bindings are not styled by the engine") {
        module.file("internal/dagger/dagger.gen.go").contents.contains("func (r *GitCommit) ShortSHA(")
      }
      let e2e = call(module, want.e2e)
      assert(label + "'s " + want.e2e + " returned " + e2e) { e2e == "e2e" }
      let arch = call(module, "platform --arch " + want.arch)
      assert(label + "'s platform returned " + arch) { arch == "arm64" }
    }
    null
  }
}
