"""
Run the Go SDK against the helper under test.
"""
type ManifestChecks {
  """
  Generate a nested Go runtime module, its local client, and its runtime schema.
  """
  localClientCheck(ws: Workspace!): Void @check {
    let scope = ".dagger/modules/e2e/fixtures/manifest/nested/app"
    let input = ws.withNewFile(scope + "/keep.txt", "keep").withWorkdir(scope)
    let target = ws.moduleSource("/.dagger/modules/e2e/fixtures/manifest/dep")
    let generated = goSdk(dangEntrypoint: false, unifiedClients: false).generateScope(
      ws: input,
      isModule: true,
      name: "app",
      clients: [target],
    )
    let toml = generated.file("dagger-module.toml").contents
    assert("generation wrote the legacy manifest") {
      generated.directory(".").exists("dagger.json") == false
    }
    assert("TOML dependency path is wrong") {
      toml.contains("source = \"../../dep\"")
    }
    assert("TOML has a default pin") {
      !toml.contains("pin =")
    }
    assert("generation changed an existing file") {
      generated.file("keep.txt").contents == "keep"
    }
    assert("generation changed the current directory") {
      generated.cwd == input.cwd
    }
    assert("Go module adapter was not generated") {
      generated.directory(".").exists("dagger.gen.go")
    }
    assert("Go module client was not generated") {
      generated.directory(".").exists("internal/dagger/dep.gen.go")
    }
    assert("standalone client was generated without dualClients") {
      generated.directory(".").exists("internal/dagger/clients/dep/dep.gen.go") == false
    }

    let repeated = goSdk(dangEntrypoint: false, unifiedClients: false).generateScope(
      ws: generated,
      isModule: true,
      name: "app",
      clients: [target],
    )
    assert("repeated generation changed TOML") {
      repeated.file("dagger-module.toml").contents == toml
    }

    let runnable = repeated.withNewFile(
      "main.go",
      "package main\n\nimport \"context\"\n\ntype App struct{}\n\n"
        + "func (m *App) Hello(ctx context.Context) (string, error) { return dag.Dep().Hello(ctx) }\n",
    )
    let rebuilt = goSdk(dangEntrypoint: false, unifiedClients: false).generateScope(
      ws: runnable,
      isModule: true,
      name: "app",
      clients: [target],
    )
    let schema = rebuilt.withWorkdir(".").moduleSource("/" + scope).clientSchemaIntrospectionJSON.contents
    assert("generated Go module did not compile and expose its function") {
      schema.contains("\"hello\"")
    }
  }

  """
  The SDK passes the lock option and the selected Git commit to the helper,
  and migrates a legacy dagger.json with its pin into dagger-module.toml.
  """
  gitClientCheck(ws: Workspace!): Void @check {
    let commit = "64645f1967d3dba6fce951dd61ae4acd8d9b0861"
    let target = moduleSource("github.com/dagger/sdk-helpers@main", refPin: commit)
    let input = ws.withWorkdir(".dagger/modules/e2e/fixtures/manifest/git-app").withNewFile(
      "keep.txt",
      "keep",
    )
    # The commit check reads the standalone client, so enable dualClients.
    let unlocked = goSdk(dualClients: true, dangEntrypoint: false, unifiedClients: false).generateScope(
      ws: input,
      isModule: true,
      name: "git-app",
      clients: [target],
    )
    assert("the SDK wrote a default TOML pin") {
      !unlocked.file("dagger-module.toml").contents.contains("pin =")
    }
    assert("the SDK changed the Git source") {
      unlocked.file("dagger-module.toml").contents.contains("source = " + JSON.encode(target.asString))
    }
    assert("default output lost the generated client commit") {
      unlocked.file("internal/dagger/clients/sdk-helpers/dagger.gen.go").contents.contains("RefPin: \"" + commit + "\"")
    }
    let locked = goSdk(lock: true, dangEntrypoint: false, unifiedClients: false).generateScope(
      ws: unlocked,
      isModule: true,
      name: "git-app",
      clients: [target],
    )
    assert("the SDK did not write the selected TOML pin") {
      locked.file("dagger-module.toml").contents.contains("pin = " + JSON.encode(commit))
    }
    let unlockedAgain = goSdk(dangEntrypoint: false, unifiedClients: false).generateScope(
      ws: locked,
      isModule: true,
      name: "git-app",
      clients: [target],
    )
    assert("disabling lock retained a TOML pin") {
      !unlockedAgain.file("dagger-module.toml").contents.contains("pin =")
    }
    let legacyJSON = "{\"name\": \"git-app\", \"engineVersion\": \"v1.0.0-beta.20\", \"sdk\": {\"source\": \"go\"}, " +
      "\"dependencies\": [{\"name\": \"sdk-helpers\", \"source\": " + JSON.encode(target.asString) + ", \"pin\": " + JSON.encode(commit) + "}]}\n"
    let migrated = goSdk(lock: true, dangEntrypoint: false, unifiedClients: false).generateScope(
      ws: locked.withoutFile("dagger-module.toml").withNewFile("dagger.json", legacyJSON),
      isModule: true,
      name: "git-app",
      clients: [target],
    )
    let toml = migrated.file("dagger-module.toml").contents
    assert("migration retained dagger.json") {
      !migrated.directory(".").exists("dagger.json")
    }
    assert("migration lost the engineVersion, the Git source or its pin:\n" + toml) {
      toml.contains("engineVersion = \"v1.0.0-beta.20\"") and
        toml.contains("source = " + JSON.encode(target.asString)) and
        toml.contains("pin = " + JSON.encode(commit))
    }
    assert("migration changed an existing file") {
      migrated.file("keep.txt").contents == "keep"
    }
  }
}
