"""
Generate modules whose build reads files outside the module directory,
through the local replace directives of go.mod.
"""
type SourcesChecks {
  let root: String! = ".dagger/modules/e2e/fixtures/include"
  """The oldest release the generated entrypoint loads on: sourcesFloor in versions.toml."""
  let floor: String! = "v1.0.0-beta.18"
  let appPath: String! = root + "/app"

  let generated(ws: Workspace!): Workspace! {
    goSdk(dangEntrypoint: true).generateScope(
      ws: ws.withWorkdir(appPath), isModule: true, name: "include-app", clients: [],
    )
  }

  """
  The generated entrypoint returns the files the build reads outside the
  module from sources, and the manifest includes the same files, for an
  engine that reads include in place of sources. The entrypoint builds with
  dagger/go from the module context, and the module regenerates without
  changes. Generation writes no file outside the module.
  """
  generateCheck(ws: Workspace!): Void @check {
    let input = ws.withWorkdir(appPath)
    let ready = generated(ws)
    let entrypoint = ready.file("internal/dagger/entrypoint/main.dang").contents
    [
      "pub sources(workspace: Workspace!): Directory! {\n    directory\n      .withDirectory(workspace.cwd + \"/..\", workspace.directory(\"..\",\n        include: [\"lib/go.mod\", \"lib/greet/*.go\", \"lib/greet/*.h\", \"lib/greet/*.s\", \"lib/greet/*.syso\", \"lib/greet/greeting.txt\"],",
      "# Needs Dagger v1.0.0-beta.25 or later; engines before v1.0.0-beta.18 report a missing \"workspace\" argument.\ntype Entrypoint implements ModuleEntrypoint {",
      "pub types: [TypeDef!]! {",
      "pub call(\n    receiverType: String!,\n",
      ".withWorkdir(\"/workspace/\" + currentModule.sourceSubpath)",
      "go.module(ws, path: root, findUp: false).packages(ws).get(pkg)",
      ".withMountedDirectory(\"/workspace\", currentModule.contextDirectory)",
    ].each { literal =>
      assert("the entrypoint lacks " + literal) { entrypoint.contains(literal) }
    }
    [".glob(", "--inventory", "go-inputs", "Dagger.node", "resources", "workspace != null", "let source", "currentModule.source."].each { literal =>
      assert("the entrypoint mentions " + literal) { entrypoint.contains(literal) == false }
    }
    assert("generation vendored the discovery tool") {
      ready.directory("internal/dagger/entrypoint").exists("go-inputs") == false
    }
    assert("the manifest is not the entrypoint manifest with dagger/go") {
      ready.file("dagger-module.toml").contents.hasPrefix(
        "name = \"include-app\"\ninclude = [\"../lib/go.mod\", \"../lib/greet/*.go\", \"../lib/greet/*.h\", \"../lib/greet/*.s\", \"../lib/greet/*.syso\", \"../lib/greet/greeting.txt\", \"!../**/*_test.go\", \"**/*_test.go\"]\n\n[entrypoint]\n  kind = \"dang\"\n  source = \"./internal/dagger/entrypoint\"\n\n[[dependencies]]\n  name = \"go\"\n  source = \"github.com/dagger/go@")
    }
    assert("generation changed main.go") {
      ready.file("main.go").contents == input.file("main.go").contents
    }
    ["/" + root + "/lib/go.mod", "/" + root + "/lib/greet/greet.go"].each { path =>
      assert("generation changed " + path) {
        ready.file(path).contents == ws.file(path).contents
      }
    }
    let repeated = generated(ready.withWorkdir("."))
    assert("regeneration changed files") { repeated.changes(ready).isEmpty }
    null
  }

  """
  A module directory without a manifest keeps its Go source: generation
  adds the manifest, and sources returns the files the build reads outside
  the module.
  """
  existingSourceCheck(ws: Workspace!): Void @check {
    let ready = generated(ws.withoutFile("/" + appPath + "/dagger-module.toml"))
    assert("generation replaced main.go") {
      ready.file("main.go").contents == ws.file("/" + appPath + "/main.go").contents
    }
    assert("the entrypoint does not declare sources") {
      ready.file("internal/dagger/entrypoint/main.dang").contents.contains("pub sources(workspace: Workspace!): Directory!")
    }
    null
  }

  """
  A module with a collection prepares its runtime sources beside the
  included paths, and places them in the module context it builds from.
  """
  collectionCheck(ws: Workspace!): Void @check {
    let input = ws.withNewFile("/" + appPath + "/items.go",
      "package include_app\n\nimport \"example.com/lib/greet\"\n\n" +
      "func (*IncludeApp) Items() *Items { return &Items{Keys: []string{greet.Greeting()}} }\n\n" +
      "// +collection\ntype Items struct {\n\t// +keys\n\tKeys []string\n}\n\n" +
      "// +get\nfunc (items *Items) Lookup(key string) *Item { return &Item{Name: key} }\n\n" +
      "type Item struct{ Name string }\n")
    let entrypoint = generated(input).file("internal/dagger/entrypoint/main.dang").contents
    [
      ".withFile(currentModule.sourceSubpath + \"/items.go\", currentModule.contextDirectory.file(currentModule.sourceSubpath + \"/internal/dagger/entrypoint/runtime/items.go.src\"))",
      ".withMountedDirectory(\"/workspace\", collectionContext)",
    ].each { literal =>
      assert("the entrypoint lacks " + literal) { entrypoint.contains(literal) }
    }
    null
  }

  let withReplace(ws: Workspace!, target: String!): Workspace! {
    let goMod = "/" + appPath + "/go.mod"
    ws.withNewFile(goMod, ws.file(goMod).contents.replace("=> ../lib", "=> " + target))
  }

  let expectRefusal(input: Workspace!, want: String!): Void {
    let got = generated(input).file("dagger.gen.go").contents rescue { err: Error => err.message }
    assert("generation did not refuse with " + want + ": " + got) { got.contains(want) }
    null
  }

  """Every refusal of a file outside the module names the line to fix."""
  refusalsCheck(ws: Workspace!): Void @check {
    expectRefusal(withReplace(ws, "../../../../../../../x"),
      "go.mod:7: replace example.com/lib => ../../../../../../../x leaves the workspace root")
    expectRefusal(withReplace(ws, "../lbi"),
      "go.mod:7: replace example.com/lib => ../lbi reads ../lbi/go.mod, which is missing")
    expectRefusal(ws.withNewFile("/" + appPath + "/extra.go", "package include_app\n\nimport _ \"example.com/lib/missing\"\n"),
      "extra.go:3:8: package example.com/lib/missing is in ../lib (go.mod:7), but ../lib/missing has no Go files")
    # The engine applies .gitignore files from the host only, so the ignored
    # fixture module is committed rather than written as a workspace edit.
    expectRefusal(withReplace(ws, "../ignored"),
      "go.mod:7: \"../ignored/go.mod\" matches only files ignored by .gitignore")
    null
  }

  """
  Generation replaces the include list of a migrated manifest: the local
  replace directives of go.mod select the files outside the module directory.
  """
  manifestIncludeCheck(ws: Workspace!): Void @check {
    [
      ["dagger-module.toml", "name = \"include-app\"\ninclude = [\"../shared\", \"./data\"]\n\n[runtime]\n  source = \"go\"\n"],
      ["dagger.json", "{\"name\": \"include-app\", \"sdk\": \"go\", \"include\": [\"../shared\", \"./data\"]}\n"],
    ].each { file =>
      let ready = generated(ws.withNewFile("/" + appPath + "/" + (file[0] ?? ""), file[1] ?? ""))
      let manifest = ready.file("dagger-module.toml").contents
      assert((file[0] ?? "") + ": generation kept the old include, lacks the replace's, or lacks the entrypoint:\n" + manifest) {
        manifest.contains("../shared") == false and manifest.contains("./data") == false and
          manifest.contains("include = [\"../lib/go.mod\", \"../lib/greet/*.go\", \"../lib/greet/*.h\", \"../lib/greet/*.s\", \"../lib/greet/*.syso\", \"../lib/greet/greeting.txt\", \"!../**/*_test.go\", \"**/*_test.go\"]") and manifest.contains("[entrypoint]") and
          ready.directory(".").exists("dagger.json") == false
      }
    }
    null
  }

  """
  Generation drops the codegen settings and the dependencies that the
  scope's clients provide, and refuses a dependency they do not.
  """
  manifestDependenciesCheck(ws: Workspace!): Void @check {
    let app = goSdk(dangEntrypoint: true).generateScope(
      ws: ws.directory("/" + root).asWorkspace.withWorkdir("app"), isModule: true, name: "include-app", clients: [],
    )
    let legacy = "name = \"include-caller\"\n\n[runtime]\n  source = \"go\"\n\n" +
      "[[dependencies]]\n  name = \"include-app\"\n  source = \"../app\"\n\n[codegen]\n  automaticGitignore = false\n"
    let clients = [app.withWorkdir(".").moduleSource("/app")]
    let migrated = goSdk(dangEntrypoint: true, unifiedClients: true, globalClient: true).generateScope(
      ws: app.withWorkdir("caller").withNewFile("dagger-module.toml", legacy), isModule: true, name: "include-caller", clients: clients,
    ).file("dagger-module.toml").contents
    # The one dependency left is dagger/go, the entrypoint's own.
    assert("generation kept codegen or dependencies, or lacks the entrypoint:\n" + migrated) {
      migrated.contains("codegen") == false and migrated.contains("../app") == false and
        migrated.split("[[dependencies]]").length == 2 and migrated.contains("\"github.com/dagger/go@") and
        migrated.contains("[entrypoint]")
    }
    let uncovered = legacy + "\n[[dependencies]]\n  name = \"other\"\n  source = \"../other\"\n"
    let refused = goSdk(dangEntrypoint: true, unifiedClients: true, globalClient: true).generateScope(
      ws: app.withWorkdir("caller").withNewFile("dagger-module.toml", uncovered), isModule: true, name: "include-caller", clients: clients,
    ).file("dagger-module.toml").contents rescue {
      err: Error => err.message
    }
    assert("an uncovered dependency was not refused: " + refused) {
      refused.contains("dagger-module.toml depends on other, which the scope's clients do not list")
    }
    # dagger.json can name a dependency by its source only; a directory
    # client has no source string, so this one stays uncovered.
    let bySource = "{\"name\": \"include-caller\", \"sdk\": \"go\", \"dependencies\": [\"../elsewhere\"]}\n"
    let refusedSource = goSdk(dangEntrypoint: true, unifiedClients: true, globalClient: true).generateScope(
      ws: app.withWorkdir("caller").withNewFile("dagger.json", bySource), isModule: true, name: "include-caller", clients: clients,
    ).file("dagger-module.toml").contents rescue {
      err: Error => err.message
    }
    assert("an uncovered dependency source was not refused: " + refusedSource) {
      refusedSource.contains("dagger.json depends on ../elsewhere, which the scope's clients do not list")
    }
    let nameless = legacy + "\n[[dependencies]]\n  pin = \"0\"\n"
    let refusedNameless = goSdk(dangEntrypoint: true, unifiedClients: true, globalClient: true).generateScope(
      ws: app.withWorkdir("caller").withNewFile("dagger-module.toml", nameless), isModule: true, name: "include-caller", clients: clients,
    ).file("dagger-module.toml").contents rescue {
      err: Error => err.message
    }
    assert("a dependency without name or source was not refused: " + refusedNameless) {
      refusedNameless.contains("dagger-module.toml has a dependency without name or source")
    }
    let refusedEmpty = goSdk(dangEntrypoint: true, unifiedClients: true, globalClient: true).generateScope(
      ws: app.withWorkdir("caller").withNewFile("dagger.json", "{\"name\": \"include-caller\", \"sdk\": \"go\", \"dependencies\": [\"\"]}\n"),
      isModule: true, name: "include-caller", clients: clients,
    ).file("dagger-module.toml").contents rescue {
      err: Error => err.message
    }
    assert("an empty dependency string was not refused: " + refusedEmpty) {
      refusedEmpty.contains("dagger.json has a dependency without name or source")
    }
    let mixed = "{\"name\": \"include-caller\", \"sdk\": \"go\", \"dependencies\": [" + JSON.encode(clients[0].asString) +
      ", {\"name\": \"include-app\", \"source\": \"../app\"}]}\n"
    let refusedMixed = goSdk(dangEntrypoint: true, unifiedClients: true, globalClient: true).generateScope(
      ws: app.withWorkdir("caller").withNewFile("dagger.json", mixed), isModule: true, name: "include-caller", clients: clients,
    ).file("dagger-module.toml").contents rescue {
      err: Error => err.message
    }
    assert("a mixed dependency list was not refused: " + refusedMixed) {
      refusedMixed.contains("dagger.json mixes dependency strings and objects")
    }
    null
  }

  """
  A module three levels below the workspace root that replaces a module
  with the root itself reads the root's go.mod and the package it imports.
  """
  rootReplaceCheck: Void @check {
    let inputs = directory
      .withNewFile("go.mod", "module example.com/root\n\ngo 1.26.1\n")
      .withNewFile("greet/greet.go", "package greet\n\nfunc Greeting() string { return \"root\" }\n")
      .withNewFile("a/b/deep/dagger-module.toml", "name = \"deep\"\n")
      .withNewFile("a/b/deep/go.mod", "module example.com/deep\n\ngo 1.26.1\n\nrequire example.com/root v0.0.0\n\nreplace example.com/root => ../../..\n")
      .withNewFile("a/b/deep/main.go", "package deep\n\nimport \"example.com/root/greet\"\n\ntype Deep struct{}\n\nfunc (*Deep) Greeting() string { return greet.Greeting() }\n")
      .asWorkspace
    let entrypoint = goSdk(dangEntrypoint: true).generateScope(
      ws: inputs.withWorkdir("a/b/deep"), isModule: true, name: "deep", clients: [],
    ).file("internal/dagger/entrypoint/main.dang").contents
    assert("the entrypoint does not read the root's files:\n" + entrypoint) {
      entrypoint.contains(".withDirectory(workspace.cwd + \"/../../..\", workspace.directory(\"../../..\",\n        include: [\"go.mod\", \"greet/*.go\", \"greet/*.h\", \"greet/*.s\", \"greet/*.syso\"],")
    }
    null
  }

  """
  The generated fixture repository: the app and the files it includes, a
  caller that reaches the app through a generated client, and a control
  module without files outside its directory. They target the floor
  release.
  """
  fixture(ws: Workspace!): Directory! {
    # The fixture root is the workspace, so the caller's client names the app
    # by its path in the exported repository.
    let inputs = ws.directory("/" + root).asWorkspace
    let app = goSdk(dangEntrypoint: true, targetVersion: floor).generateScope(
      ws: inputs.withWorkdir("app"), isModule: true, name: "include-app", clients: [],
    )
    let control = goSdk(dangEntrypoint: true, targetVersion: floor).generateScope(
      ws: app.withWorkdir("control"), isModule: true, name: "include-control", clients: [],
    )
    goSdk(dangEntrypoint: true, unifiedClients: true, globalClient: true, targetVersion: floor).generateScope(
      ws: control.withWorkdir("caller"), isModule: true, name: "include-caller",
      clients: [control.withWorkdir(".").moduleSource("/app")],
    ).directory("/")
  }

  """
  The caller returns its own files outside its directory from sources. The
  control module, which reads nothing outside, gets the same entrypoint
  shape, and its sources returns its directory only.
  """
  familyCheck(ws: Workspace!): Void @check {
    let repo = fixture(ws)
    let caller = repo.file("caller/internal/dagger/entrypoint/main.dang").contents
    assert("the caller does not return its own files from sources:\n" + caller) {
      caller.contains("workspace.directory(\"..\",\n        include: [\"lib/go.mod\", \"lib/greet/*.go\", \"lib/greet/*.h\", \"lib/greet/*.s\", \"lib/greet/*.syso\", \"lib/greet/greeting.txt\"],")
    }
    let control = repo.file("control/internal/dagger/entrypoint/main.dang").contents
    assert("the control entrypoint does not return its own directory from sources:\n" + control) {
      control.contains("pub sources(workspace: Workspace!): Directory! {\n    directory\n      .withDirectory(workspace.cwd, workspace.directory(\".\", exclude: [\"**/.git\"], gitignore: true))\n  }") and
        control.contains("include:") == false
    }
    let app = repo.file("app/internal/dagger/entrypoint/main.dang").contents
    assert("the app and control entrypoints differ in call") {
      (app.split("  pub call(")[1] ?? "") == (control.split("  pub call(")[1] ?? "")
    }
    null
  }

  """
  A git source reads its files outside the module from its own commit. cli
  is this engine's dagger CLI: it runs nested in this session, where the git
  service is reachable.
  """
  gitSourceCall(ws: Workspace!, cli: File!): Void {
    let server = container.from("alpine:3.22").withoutEntrypoint
      .withExec(["apk", "add", "--no-cache", "git", "git-daemon"])
      .withDirectory("/srv/repo", fixture(ws))
      .withWorkdir("/srv/repo")
      .withExec(["git", "init", "-q", "-b", "main"])
      .withExec(["git", "config", "user.name", "SDK test"])
      .withExec(["git", "config", "user.email", "sdk-test@example.com"])
      .withExec(["git", "add", "."])
      .withExec(["git", "commit", "-q", "-m", "include fixture"])
      .withExec(["git", "clone", "-q", "--bare", ".", "/srv/repo.git"])
      .withExposedPort(9418)
      .withDefaultArgs(["git", "daemon", "--export-all", "--base-path=/srv", "/srv"])
      .asService
    let called = container.from("alpine:3.22").withoutEntrypoint
      .withFile("/usr/local/bin/dagger", cli, permissions: 755)
      .withServiceBinding(server.hostname, server)
      .withExec(["dagger", "-m", "git://" + server.hostname + "/repo.git#main:app", "call", "greeting"],
        experimentalPrivilegedNesting: true, expect: ReturnType.ANY)
    assert("a git module with files outside its directory failed:\n" + called.stdout + called.stderr) {
      called.exitCode == 0 and called.stdout.trimSpace == "one"
    }
    null
  }

  """
  Call the generated include fixture with the CLI of the engine running the
  check: the module builds from its context, a file embedded at build time,
  a file read at call time, a file the build does not read, the module API,
  a result reused by a second session and computed again after an included
  file changes but not after an unrelated one, calls from another
  repository, a subdirectory, by path and from a git source, a caller that
  reaches the module through a generated client, a module without files
  outside its directory, and a build that misses a file that sources does
  not return.
  """
  callsCheck(ws: Workspace!): Void @check {
    let cli = container.from("registry.dagger.io/engine:" + (version.split("+")[0] ?? version)).file("/usr/local/bin/dagger")
    let ready = container.from("alpine:3.22").withoutEntrypoint
      .withExec(["apk", "add", "--no-cache", "git"])
      .withFile("/usr/local/bin/dagger", cli)
      .withDirectory("/repo", fixture(ws))
      .withNewFile("/repo/dagger.toml",
        "[modules.include-app]\nsource = \"app\"\n\n[modules.include-caller]\nsource = \"caller\"\n\n[modules.include-control]\nsource = \"control\"\n")
      .withExec(["git", "-C", "/repo", "init", "-q"])
    let entrypoint = ready.file("/repo/app/internal/dagger/entrypoint/main.dang").contents
    assert("the entrypoint does not declare sources:\n" + entrypoint) {
      entrypoint.contains("pub sources(workspace: Workspace!): Directory!")
    }

    let outside = runDagger(ready.withExec(["git", "init", "-q", "/other"]), "/other", ["-m", "/repo/app", "call", "greeting"])
    assert("the module failed from another repository: " + succeeded(outside)) { succeeded(outside) == "one" }

    let greeting = ["call", "include-app", "greeting"]
    let nonce = ["call", "include-app", "nonce"]
    let built = runDagger(outside, "/repo", greeting)
    assert("the build did not embed the included file: " + succeeded(built)) {
      succeeded(built) == "one"
    }
    let runtime = runDagger(built, "/repo", ["call", "include-app", "runtime"])
    assert("the function did not read the included file at call time: " + succeeded(runtime)) {
      succeeded(runtime) == "one"
    }
    let excluded = runDagger(runtime, "/repo", ["call", "include-app", "excluded"])
    assert("lib/greet/testdata, which the build does not read, reached the module") { succeeded(excluded) == "false" }

    let functions = runDagger(excluded, "/repo", ["-m", "app", "functions"])
    let api = succeeded(functions)
    assert("the module API is not greeting, runtime, excluded and nonce:\n" + api) {
      api.contains("greeting") and api.contains("runtime") and api.contains("excluded") and api.contains("nonce") and api.contains("sources") == false
    }
    let greetingHelp = succeeded(runDagger(functions, "/repo", ["call", "include-app", "greeting", "--help"]))
    assert("greeting takes a workspace argument:\n" + greetingHelp) { greetingHelp.contains("--ws") == false }

    let firstNonce = runDagger(functions, "/repo", nonce)
    let secondNonce = runDagger(firstNonce, "/repo", nonce)
    assert("a second session did not reuse the result: " + succeeded(firstNonce) + " then " + succeeded(secondNonce)) {
      succeeded(secondNonce) == succeeded(firstNonce)
    }
    let unrelated = runDagger(secondNonce.withNewFile("/repo/lib/unrelated.txt", "unrelated"), "/repo", nonce)
    assert("a file outside sources invalidated the result: " + succeeded(unrelated)) {
      succeeded(unrelated) == succeeded(firstNonce)
    }
    let changed = runDagger(unrelated.withNewFile("/repo/lib/greet/greeting.txt", "two"), "/repo", greeting)
    assert("a new session returned a stale result after an included file changed: " + succeeded(changed)) {
      succeeded(changed) == "two"
    }
    let freshNonce = runDagger(changed, "/repo", nonce)
    assert("the result was not computed again after an included file changed: " + succeeded(freshNonce)) {
      succeeded(freshNonce).hasPrefix("two ") and succeeded(freshNonce) != succeeded(firstNonce)
    }

    let fromSubdirectory = runDagger(freshNonce, "/repo/lib", greeting)
    let byPath = runDagger(fromSubdirectory, "/repo/lib", ["-m", "../app", "call", "greeting"])
    assert("the module failed from a subdirectory of its workspace") {
      succeeded(fromSubdirectory) == "two" and succeeded(byPath) == "two"
    }

    let callerGreeting = ["call", "include-caller", "greeting"]
    let sibling = runDagger(byPath, "/repo", callerGreeting)
    assert("the caller did not build with its own and the app's included files: " + succeeded(sibling)) {
      succeeded(sibling) == "two two"
    }
    let siblingChanged = runDagger(sibling.withNewFile("/repo/lib/greet/greeting.txt", "three"), "/repo", callerGreeting)
    assert("the caller returned a stale result after an included file changed: " + succeeded(siblingChanged)) {
      succeeded(siblingChanged) == "three three"
    }
    let control = runDagger(siblingChanged, "/repo", ["call", "include-control", "nonce"])
    let controlAgain = runDagger(control, "/repo", ["call", "include-control", "nonce"])
    assert("a module without files outside its directory did not reuse its result") {
      succeeded(controlAgain) == succeeded(control)
    }
    # Greeting starts importing a package that the generated sources do not return.
    let appMain = controlAgain.file("/repo/app/main.go").contents
      .replace("\"example.com/lib/greet\"\n", "\"example.com/lib/greet\"\n\t\"example.com/lib/words\"\n")
      .replace("{ return greet.Greeting() }", "{ return greet.Greeting() + words.Word() }")
    let stale = runDagger(controlAgain.withNewFile("/repo/app/main.go", appMain), "/repo", greeting)
    assert("a build that misses a file did not say to generate again:\n" + stale.stderr) {
      stale.exitCode != 0 and stale.stderr.contains("run dagger generate")
    }

    gitSourceCall(ws, cli)
  }

  """
  Run one dagger command from dir, as a session of its own: the checks of
  reuse across sessions need each command to be one.
  """
  let runDagger(client: Container!, dir: String!, args: [String!]!): Container! {
    client.withWorkdir(dir).withExec(["dagger"] + args, daggerInDaggerNewSession: true, expect: ReturnType.ANY)
  }

  let succeeded(run: Container!): String! {
    if (run.exitCode != 0) {
      raise "dagger failed:\n" + run.stdout + run.stderr
    }
    run.stdout.trimSpace
  }
}
