"""
End-to-end checks for the Go SDK module provider.
"""
type E2e {
  """
  Checks for manifest generation and dependency pins.
  """
  manifest: ManifestChecks! { ManifestChecks }

  let fixtureRoot: String! = ".dagger/modules/e2e/fixtures"
  let outputRoot: String! = ".dagger/modules/e2e/out"
  let clientTargetPath: String! = fixtureRoot + "/client/dep"
  let secondClientTargetPath: String! = fixtureRoot + "/client/app"
  # Dagger Go library source used by the generated-client compile check.
  let daggerSourceRef: String! = "44f87a32cf6aceb807c02bebde03ccb0e3fd014e"

  let exists(ws: Workspace!, path: String!): Boolean! {
    ws.directory(".", include: [path]).exists(path)
  }

  """
  Client root discovery returns the nearest parent Go module.
  """
  findClientRootCheck(ws: Workspace!): Void @check {
    let scopePath = fixtureRoot + "/client/existing"
    let nested = ws.withWorkdir(scopePath)

    let root = goSdk.findClientRoot(nested)
    assert("findClientRoot returned an unexpected root") {
      root == scopePath
    }
    assert("findClientRoot returned a root without a go.mod") {
      goSdk.findClientRoot(ws.withWorkdir(fixtureRoot + "/client/app")) == null
    }
    null
  }

  """
  A new module gets the current manifest, starter source, and generated Go code.
  The legacy manifest follows fat.
  """
  moduleInitCheck(ws: Workspace!): Void @check {
    let scopePath = outputRoot + "/module-init"
    let input = ws
      .withNewFile(scopePath + "/user.txt", "keep me\n")
      .withWorkdir(scopePath)
    let generated = goSdk.generateScope(
      ws: input,
      isModule: true,
      name: "module-init",
      clients: [],
    )

    assert("module manifest was not created") {
      exists(generated, "dagger-module.toml")
    }
    assert("legacy module manifest was created by default") {
      exists(generated, "dagger.json") == false
    }
    assert("starter source was not created") {
      exists(generated, "main.go")
    }
    assert("module adapter was not generated") {
      exists(generated, "dagger.gen.go")
    }
    assert("aggregate client package was not generated") {
      exists(generated, "internal/dagger/dagger.gen.go")
    }
    assert("manifest name is wrong") {
      generated.file("dagger-module.toml").contents.contains("name = \"module-init\"")
    }
    assert("manifest engine version is missing") {
      generated.file("dagger-module.toml").contents.contains("engineVersion = \"v")
    }
    assert("manifest runtime is wrong") {
      generated.file("dagger-module.toml").contents.contains("source = \"go\"")
    }
    assert("manifest has an unexpected module source") {
      generated.file("dagger-module.toml").contents.contains("source = \".\"") == false
    }
    assert("existing file was not preserved") {
      generated.file("user.txt").contents.contains("keep me")
    }

    let fat = goSdk(fat: true).generateScope(
      ws: generated,
      isModule: true,
      name: "module-init",
      clients: [],
    )
    assert("fat generation did not create the legacy module manifest") {
      exists(fat, "dagger.json")
    }
    assert("legacy manifest name is wrong") {
      fat.file("dagger.json").contents.contains("\"name\": \"module-init\"")
    }
    assert("legacy manifest engine version is missing") {
      fat.file("dagger.json").contents.contains("\"engineVersion\": \"v")
    }
    assert("legacy manifest runtime is wrong") {
      fat.file("dagger.json").contents.contains("\"source\": \"go\"")
    }
    assert("legacy manifest has an unexpected module source") {
      fat.file("dagger.json").contents.contains("\"source\": \".\"") == false
    }

    let thin = goSdk.generateScope(
      ws: fat,
      isModule: true,
      name: "module-init",
      clients: [],
    )
    assert("disabling fat retained the legacy module manifest") {
      exists(thin, "dagger.json") == false
    }
    assert("toggling fat changed the module manifest") {
      thin.file("dagger-module.toml").contents == generated.file("dagger-module.toml").contents
    }
    null
  }

  """
  Module clients become inputs to the existing module generator.
  Standalone clients follow dualClients.
  """
  moduleClientCheck(ws: Workspace!): Void @check {
    let goScopePath = fixtureRoot + "/go-scope"
    let scopePath = goScopePath + "/module-client"
    let input = ws
      .withNewDirectory(scopePath, directory)
      .withWorkdir(scopePath)
    let target = ws.moduleSource("/" + clientTargetPath)
    let initialized = goSdk(fat: true).generateScope(
      ws: input,
      isModule: true,
      name: "module-client",
      clients: [],
    )
    let generated = goSdk(fat: true).generateScope(
      ws: initialized,
      isModule: true,
      name: "module-client",
      clients: [target],
    )

    assert("module client binding was not generated") {
      exists(generated, "internal/dagger/client-dep.gen.go")
    }
    assert("standalone module client was generated without dualClients") {
      exists(
        generated.withWorkdir(goScopePath),
        "internal/dagger/clients/client-dep/client-dep.gen.go",
      ) == false
    }
    assert("module client was not saved in the manifest") {
      generated.file("dagger-module.toml").contents.contains("name = \"client-dep\"")
    }
    assert("module client source is wrong in the current manifest") {
      generated.file("dagger-module.toml").contents.contains("source = \"../../client/dep\"")
    }
    assert("module client source is wrong in the legacy manifest") {
      generated.file("dagger.json").contents.contains("\"source\": \"../../client/dep\"")
    }

    let dual = goSdk(fat: true, dualClients: true).generateScope(
      ws: initialized,
      isModule: true,
      name: "module-client",
      clients: [target],
    )
    assert("module client binding was not generated with dualClients") {
      exists(dual, "internal/dagger/client-dep.gen.go")
    }
    assert("standalone module client was not generated with dualClients") {
      exists(
        dual.withWorkdir(goScopePath),
        "internal/dagger/clients/client-dep/client-dep.gen.go",
      )
    }
    null
  }

  """
  A client batch preserves earlier outputs, requirements, and the caller's cwd.
  """
  standaloneClientCheck(ws: Workspace!): Void @check {
    # Use a published version so the generator can add the Go requirement.
    let publishedVersion = "v1.0.0-beta.11"
    let scopePath = fixtureRoot + "/go-scope"
    let input = ws
      .withNewFile(scopePath + "/go.mod", "module example.com/app\n\ngo 1.25\n")
      .withNewFile(scopePath + "/user.go", "package app\n")
      .withNewFile(scopePath + "/nested/keep.txt", "keep\n")
      .withWorkdir(scopePath + "/nested")
    let target = ws.moduleSource("/" + clientTargetPath).withEngineVersion(publishedVersion)
    # A later client must not downgrade the requirement added by the first.
    let secondTarget = ws.moduleSource("/" + secondClientTargetPath).withEngineVersion("v1.0.0-beta.10")
    # dualClients is false by default. Non-module scopes must ignore it.
    let result = goSdk.generateScope(
      ws: input,
      isModule: false,
      name: "standalone-client",
      clients: [target, secondTarget],
    )
    assert("client generation changed the caller's cwd") {
      result.cwd == input.cwd
    }
    let generated = result.withWorkdir(scopePath)
    let targetPath = "internal/dagger/clients/client-dep"
    let secondTargetPath = "internal/dagger/clients/client-app"

    assert("core client code was not generated") {
      exists(generated, targetPath + "/dagger.gen.go")
    }
    assert("target client code was not generated") {
      exists(generated, targetPath + "/client-dep.gen.go")
    }
    assert("dag package was not generated") {
      exists(generated, targetPath + "/dag/dag.gen.go")
    }
    assert("target client created a nested go.mod") {
      exists(generated, targetPath + "/go.mod") == false
    }
    assert("second target client was not generated") {
      exists(generated, secondTargetPath + "/client-app.gen.go")
    }
    assert("local target path was not preserved") {
      generated.file(targetPath + "/dagger.gen.go").contents.contains("ModuleSource(\"/" + clientTargetPath + "\")")
    }
    assert("scope go.mod was not updated") {
      generated.file("go.mod").contents.contains("dagger.io/dagger " + publishedVersion)
    }
    assert("user source was not preserved") {
      generated.file("user.go").contents == "package app\n"
    }
    assert("nested user file was not preserved") {
      generated.file("nested/keep.txt").contents == "keep\n"
    }

    let regenerated = goSdk.generateScope(
      ws: generated,
      isModule: false,
      name: "standalone-client",
      clients: [target, secondTarget],
    )
    assert("standalone client regeneration was not stable") {
      regenerated.changes(generated).isEmpty
    }
    null
  }

  """
  Two standalone target packages compile in one Go module.
  """
  standaloneClientCompilesCheck(ws: Workspace!): Void @check {
    let scopePath = fixtureRoot + "/go-scope"
    let input = ws
      .withNewFile(scopePath + "/go.mod", "module example.com/compile\n\ngo 1.25\n")
      .withNewFile(scopePath + "/main.go", "package compile\n")
      .withWorkdir(scopePath)
    let generated = goSdk.generateScope(
      ws: input,
      isModule: false,
      name: "standalone-compile",
      clients: [
        ws.moduleSource("/" + clientTargetPath),
        ws.moduleSource("/" + secondClientTargetPath),
      ],
    )
    let out = container
      .from("golang:1.26-alpine")
      .withoutEntrypoint
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withDirectory(
        "/dagger-sdk",
        git("https://github.com/dagger/dagger")
          .commit(daggerSourceRef)
          .tree
          .directory("sdk/go"),
      )
      .withDirectory("/src", generated.directory("."))
      .withWorkdir("/src")
      .withExec(["go", "mod", "edit", "-replace", "dagger.io/dagger=/dagger-sdk"])
      .withExec(["go", "mod", "tidy"])
      .withExec(["go", "build", "./..."])
      .stdout

    null
  }

  """
  Regeneration preserves existing generated and user-owned client packages.
  """
  standaloneClientPreservationCheck(ws: Workspace!): Void @check {
    let scopePath = fixtureRoot + "/go-scope"
    let input = ws
      .withNewFile(scopePath + "/go.mod", "module example.com/preservation\n\ngo 1.25\n")
      .withNewFile(scopePath + "/user.go", "package preservation\n")
      .withNewFile(scopePath + "/internal/dagger/clients/custom/user.go", "package custom\n")
      .withWorkdir(scopePath)
    let target = ws.moduleSource("/" + clientTargetPath)
    let withClient = goSdk.generateScope(
      ws: input,
      isModule: false,
      name: "standalone-preservation",
      clients: [target],
    )
    let withoutClient = goSdk.generateScope(
      ws: withClient,
      isModule: false,
      name: "standalone-preservation",
      clients: [],
    )

    assert("regeneration deleted generated client code") {
      exists(withoutClient, "internal/dagger/clients/client-dep/dagger.gen.go")
    }
    assert("regeneration deleted user-owned client code") {
      exists(withoutClient, "internal/dagger/clients/custom/user.go")
    }
    assert("regeneration deleted user source") {
      exists(withoutClient, "user.go")
    }
    null
  }

  """
  The client code generator unit tests pass.
  """
  helperTestsCheck(ws: Workspace!): Void @check {
    let out = container
      .from("golang:1.26-alpine")
      .withoutEntrypoint
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withDirectory("/src", ws.directory("cmd/dagger-go-sdk-codegen"))
      .withWorkdir("/src")
      .withExec(["go", "test", "./..."])
      .stdout

    null
  }
}
