"""
End-to-end checks for the Go SDK module provider.
"""
type E2e {
  """
  Checks for manifest generation and dependency pins.
  """
  manifest: ManifestChecks! { ManifestChecks }

  """
  Checks for modules generated with dangEntrypoint.
  """
  entrypoint: EntrypointChecks! { EntrypointChecks }

  """Checks that need the shared runtime SDK from the engine checkout."""
  unified(runtimeSdk: Directory!, legacyVersion: String! = "v0.21.7", packageMain: Boolean! = false): UnifiedChecks! {
    UnifiedChecks(runtimeSdk: runtimeSdk, legacyVersion: legacyVersion, packageMain: packageMain)
  }

  """Checks for modules whose build reads files outside the module directory."""
  sources: SourcesChecks! { SourcesChecks }

  """Checks for the release a module targets."""
  target: TargetChecks! { TargetChecks }

  """
  Checks for the names the engine gives a module's declarations. cli is the
  dagger CLI of the engine under test, for the checks that call the module.
  """
  naming(cli: File = null): NamingChecks! { NamingChecks(cli: cli) }

  let fixtureRoot: String! = ".dagger/modules/e2e/fixtures"
  let outputRoot: String! = ".dagger/modules/e2e/out"
  let clientTargetPath: String! = fixtureRoot + "/client/dep"
  let secondClientTargetPath: String! = fixtureRoot + "/client/app"
  # Dagger Go library source used by the generated-client compile check.
  let daggerSourceRef: String! = "0da36c8da9cb6a682c7d27eca9bd2c125de5ed09"
  """The release this Go SDK is built for: defaultTarget in go-sdk.dang."""
  let sdkTarget: String! = "v1.0.0-beta.25"

  let exists(ws: Workspace!, path: String!): Boolean! {
    ws.directory(".", include: [path]).exists(path)
  }

  """
  Client root discovery returns the nearest parent Go module.
  """
  findClientRootCheck(ws: Workspace!): Void @check {
    let scopePath = fixtureRoot + "/client/existing"
    let nested = ws.withWorkdir(scopePath)

    let root = goSdk.findClientRoot(nested)
    assert("findClientRoot returned an unexpected root") {
      root == scopePath
    }
    assert("findClientRoot returned a root without a go.mod") {
      goSdk.findClientRoot(ws.withWorkdir(fixtureRoot + "/client/app")) == null
    }
    null
  }

  """
  Explicit Go runtime mode gets the manifest, starter source, and embedded
  bindings. Generating again migrates a legacy dagger.json into
  dagger-module.toml and removes it.
  """
  moduleInitCheck(ws: Workspace!): Void @check {
    let scopePath = outputRoot + "/module-init"
    let input = ws
      .withNewFile(scopePath + "/user.txt", "keep me\n")
      .withWorkdir(scopePath)
    let generated = goSdk(dangEntrypoint: false, unifiedClients: false).generateScope(
      ws: input,
      isModule: true,
      name: "module-init",
      clients: [],
    )

    assert("module manifest was not created") {
      exists(generated, "dagger-module.toml")
    }
    assert("legacy module manifest was created by default") {
      exists(generated, "dagger.json") == false
    }
    assert("starter source was not created") {
      exists(generated, "main.go")
    }
    assert("module adapter was not generated") {
      exists(generated, "dagger.gen.go")
    }
    assert("aggregate client package was not generated") {
      exists(generated, "internal/dagger/dagger.gen.go")
    }
    assert("manifest name is wrong") {
      generated.file("dagger-module.toml").contents.contains("name = \"module-init\"")
    }
    assert("manifest engine version is missing") {
      generated.file("dagger-module.toml").contents.contains("engineVersion = \"v")
    }
    assert("manifest runtime is wrong") {
      generated.file("dagger-module.toml").contents.contains("source = \"go\"")
    }
    assert("manifest has an unexpected module source") {
      generated.file("dagger-module.toml").contents.contains("source = \".\"") == false
    }
    assert("existing file was not preserved") {
      generated.file("user.txt").contents.contains("keep me")
    }

    let legacyJSON = "{\n  \"name\": \"module-init\",\n  \"engineVersion\": \"v1.0.0-beta.20\",\n  \"sdk\": {\n    \"source\": \"go\"\n  }\n}\n"
    let migrated = goSdk(dangEntrypoint: false, unifiedClients: false).generateScope(
      ws: generated.withoutFile("dagger-module.toml").withNewFile("dagger.json", legacyJSON),
      isModule: true,
      name: "module-init",
      clients: [],
    )
    assert("regeneration retained the legacy module manifest") {
      exists(migrated, "dagger.json") == false
    }
    let toml = migrated.file("dagger-module.toml").contents
    assert("migrating dagger.json lost its name, engineVersion or runtime:\n" + toml) {
      toml.contains("name = \"module-init\"") and
        toml.contains("engineVersion = \"v1.0.0-beta.20\"") and
        toml.contains("source = \"go\"")
    }
    assert("migrating dagger.json changed the author source") {
      migrated.file("main.go").contents == generated.file("main.go").contents and
        migrated.file("user.txt").contents.contains("keep me")
    }
    null
  }

  """
  Module clients become inputs to the existing module generator.
  Standalone clients follow dualClients.
  """
  moduleClientCheck(ws: Workspace!): Void @check {
    let goScopePath = fixtureRoot + "/go-scope"
    let scopePath = goScopePath + "/module-client"
    let input = ws
      .withNewDirectory(scopePath, directory)
      .withWorkdir(scopePath)
    let target = ws.moduleSource("/" + clientTargetPath)
    let initialized = goSdk(dangEntrypoint: false, unifiedClients: false).generateScope(
      ws: input,
      isModule: true,
      name: "module-client",
      clients: [],
    )
    let generated = goSdk(dangEntrypoint: false, unifiedClients: false).generateScope(
      ws: initialized,
      isModule: true,
      name: "module-client",
      clients: [target],
    )

    assert("module client binding was not generated") {
      exists(generated, "internal/dagger/client-dep.gen.go")
    }
    assert("standalone module client was generated without dualClients") {
      exists(
        generated.withWorkdir(goScopePath),
        "internal/dagger/clients/client-dep/client-dep.gen.go",
      ) == false
    }
    assert("module client was not saved in the manifest") {
      generated.file("dagger-module.toml").contents.contains("name = \"client-dep\"")
    }
    assert("module client source is wrong in the current manifest") {
      generated.file("dagger-module.toml").contents.contains("source = \"../../client/dep\"")
    }
    assert("generation wrote the legacy manifest") {
      exists(generated, "dagger.json") == false
    }

    # The runtime generator creates a module-local go.mod as a workspace
    # edit. That becomes the nearest Go scope for standalone clients too.
    assert("generated module has no local Go root") {
      goSdk.findClientRoot(initialized) == scopePath
    }
    let dual = goSdk(dualClients: true, dangEntrypoint: false, unifiedClients: false).generateScope(
      ws: initialized,
      isModule: true,
      name: "module-client",
      clients: [target],
    )
    assert("module client binding was not generated with dualClients") {
      exists(dual, "internal/dagger/client-dep.gen.go")
    }
    assert("standalone module client was not generated in its nearest Go root") {
      exists(dual, "internal/dagger/clients/client-dep/client-dep.gen.go")
    }
    assert("standalone module client escaped into the parent Go root") {
      exists(
        dual.withWorkdir(goScopePath),
        "internal/dagger/clients/client-dep/client-dep.gen.go",
      ) == false
    }
    assert("dual client generation changed the parent go.mod") {
      dual.withWorkdir(goScopePath).file("go.mod").contents ==
        initialized.withWorkdir(goScopePath).file("go.mod").contents
    }
    null
  }

  """
  An embedded client batch preserves outputs, requirements, and the caller's cwd.
  """
  standaloneClientCheck(ws: Workspace!): Void @check {
    # Use a published version so the generator can add the Go requirement.
    let publishedVersion = "v1.0.0-beta.11"
    let scopePath = fixtureRoot + "/go-scope"
    let input = ws
      .withNewFile(scopePath + "/go.mod", "module example.com/app\n\ngo 1.25\n")
      .withNewFile(scopePath + "/user.go", "package app\n")
      .withNewFile(scopePath + "/nested/keep.txt", "keep\n")
      .withWorkdir(scopePath + "/nested")
    let target = ws.moduleSource("/" + clientTargetPath).withEngineVersion(publishedVersion)
    # A later client must not downgrade the requirement added by the first.
    let secondTarget = ws.moduleSource("/" + secondClientTargetPath).withEngineVersion("v1.0.0-beta.10")
    # dualClients is false by default. Non-module scopes must ignore it.
    let result = goSdk(dangEntrypoint: false, unifiedClients: false).generateScope(
      ws: input,
      isModule: false,
      name: "standalone-client",
      clients: [target, secondTarget],
    )
    assert("client generation changed the caller's cwd") {
      result.cwd == input.cwd
    }
    let generated = result.withWorkdir(scopePath)
    let targetPath = "internal/dagger/clients/client-dep"
    let secondTargetPath = "internal/dagger/clients/client-app"

    assert("core client code was not generated") {
      exists(generated, targetPath + "/dagger.gen.go")
    }
    assert("target client code was not generated") {
      exists(generated, targetPath + "/client-dep.gen.go")
    }
    assert("dag package was not generated") {
      exists(generated, targetPath + "/dag/dag.gen.go")
    }
    assert("target client created a nested go.mod") {
      exists(generated, targetPath + "/go.mod") == false
    }
    assert("second target client was not generated") {
      exists(generated, secondTargetPath + "/client-app.gen.go")
    }
    assert("target package was not named after its output directory") {
      generated.file(targetPath + "/dagger.gen.go").contents.contains("package clientdep\n") and
        generated.file(secondTargetPath + "/dagger.gen.go").contents.contains("package clientapp\n")
    }
    assert("local target path was not preserved") {
      generated.file(targetPath + "/dagger.gen.go").contents.contains("ModuleSource(\"/" + clientTargetPath + "\")")
    }
    assert("scope go.mod was not updated") {
      generated.file("go.mod").contents.contains("dagger.io/dagger " + publishedVersion)
    }
    assert("an embedded client without a target announces a release") {
      generated.file(targetPath + "/dagger.gen.go").contents.contains("WithVersionOverride(\"") == false
    }
    assert("user source was not preserved") {
      generated.file("user.go").contents == "package app\n"
    }
    assert("nested user file was not preserved") {
      generated.file("nested/keep.txt").contents == "keep\n"
    }

    let regenerated = goSdk(dangEntrypoint: false, unifiedClients: false).generateScope(
      ws: generated,
      isModule: false,
      name: "standalone-client",
      clients: [target, secondTarget],
    )
    assert("standalone client regeneration was not stable") {
      regenerated.changes(generated).isEmpty
    }

    # With a target, the clients pin the library to it and announce it when
    # they start a session.
    let targeted = goSdk(targetVersion: "v1.0.0-beta.26", dangEntrypoint: false, unifiedClients: false).generateScope(
      ws: generated,
      isModule: false,
      name: "standalone-client",
      clients: [target, secondTarget],
    ).withWorkdir(scopePath)
    assert("the target did not raise the scope go.mod:\n" + targeted.file("go.mod").contents) {
      targeted.file("go.mod").contents.contains("dagger.io/dagger v1.0.0-beta.26")
    }
    assert("the clients do not announce the target") {
      targeted.file(targetPath + "/dagger.gen.go").contents.contains("WithVersionOverride(\"v1.0.0-beta.26\")") and
        targeted.file(targetPath + "/dag/dag.gen.go").contents.contains("WithVersionOverride(\"v1.0.0-beta.26\")") and
        targeted.file(secondTargetPath + "/dagger.gen.go").contents.contains("WithVersionOverride(\"v1.0.0-beta.26\")")
    }
    null
  }

  """
  Two embedded standalone target packages compile in one Go module.
  """
  standaloneClientCompilesCheck(ws: Workspace!): Void @check {
    let sourceRef = if (ws.directory("/").exists(".dagger/modules/e2e/engine-commit")) {
      ws.file("/.dagger/modules/e2e/engine-commit").contents.trimSpace
    } else { daggerSourceRef }
    let scopePath = fixtureRoot + "/go-scope"
    let input = ws
      .withNewFile(scopePath + "/go.mod", "module example.com/compile\n\ngo 1.25\n")
      .withNewFile(scopePath + "/main.go", "package compile\n")
      .withWorkdir(scopePath)
    let generated = goSdk(unifiedClients: false).generateScope(
      ws: input,
      isModule: false,
      name: "standalone-compile",
      clients: [
        ws.moduleSource("/" + clientTargetPath),
        ws.moduleSource("/" + secondClientTargetPath),
      ],
    )
    let out = container
      .from("golang:1.26-alpine")
      .withoutEntrypoint
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withDirectory(
        "/dagger-sdk",
        git("https://github.com/dagger/dagger")
          .commit(sourceRef)
          .tree
          .directory("sdk/go"),
      )
      .withDirectory("/src", generated.directory("."))
      .withWorkdir("/src")
      .withExec(["go", "mod", "edit", "-replace", "dagger.io/dagger=/dagger-sdk"])
      .withExec(["go", "mod", "tidy"])
      .withExec(["go", "build", "./..."])
      .stdout

    null
  }

  """
  With unifiedClients unset, existing clients keep their binding style.
  Explicit true migrates embedded clients. Removing a client prunes generated
  files and preserves user files.
  """
  standaloneClientPreservationCheck(ws: Workspace!): Void @check {
    let scopePath = fixtureRoot + "/go-scope"
    let input = ws
      .withNewFile(scopePath + "/go.mod", "module example.com/preservation\n\ngo 1.25\n")
      .withNewFile(scopePath + "/user.go", "package preservation\n")
      .withNewFile(scopePath + "/internal/dagger/clients/custom/user.go", "package custom\n")
      .withWorkdir(scopePath)
    let target = ws.moduleSource("/" + clientTargetPath)
    let clientPath = "internal/dagger/clients/client-dep/dagger.gen.go"
    let embedded = goSdk(unifiedClients: false).generateScope(
      ws: input,
      isModule: false,
      name: "standalone-preservation",
      clients: [target],
    )
    assert("unifiedClients = false generated a unified client") {
      embedded.file(clientPath).contents.contains("dagger.ModuleGraphQLClient(") == false
    }
    let retained = goSdk.generateScope(
      ws: embedded, isModule: false, name: "standalone-preservation", clients: [target],
    )
    assert("unset unifiedClients changed the embedded client") {
      retained.changes(embedded).isEmpty
    }
    let withClient = goSdk(unifiedClients: true).generateScope(
      ws: embedded,
      isModule: false,
      name: "standalone-preservation",
      clients: [target],
    )
    assert("explicit unifiedClients did not migrate the embedded client") {
      withClient.file(clientPath).contents.contains("dagger.ModuleGraphQLClient(")
    }
    assert("the migration did not pin the library to the SDK's release:\n" + withClient.file("go.mod").contents) {
      withClient.file("go.mod").contents.contains("dagger.io/dagger " + sdkTarget + "\n")
    }
    let withoutClient = goSdk.generateScope(
      ws: withClient,
      isModule: false,
      name: "standalone-preservation",
      clients: [],
    )

    assert("regeneration kept stale generated client code") {
      exists(withoutClient, "internal/dagger/clients/client-dep/dagger.gen.go") == false
    }
    assert("regeneration deleted user-owned client code") {
      exists(withoutClient, "internal/dagger/clients/custom/user.go")
    }
    assert("regeneration deleted user source") {
      exists(withoutClient, "user.go")
    }
    null
  }

  """
  The CLI refuses the removed clientVersion and fat settings as arguments.
  Generation ignores them in the module settings and in a scope's settings
  of dagger.toml, where targetVersion keeps its pin. cli is this engine's
  dagger CLI: it runs nested in this session. No check calls it; run it
  from the repository root:

    dagger -m .dagger/modules/e2e call removed-settings-call --ws . --cli <the engine's dagger CLI>
  """
  removedSettingsCall(ws: Workspace!, cli: File!): Void {
    let base = container.from("alpine:3.22").withoutEntrypoint
      .withExec(["apk", "add", "--no-cache", "git"])
      .withFile("/usr/local/bin/dagger", cli, permissions: 755)
      .withDirectory("/go-sdk", ws.directory("/", exclude: ["**/.git", outputRoot]))
      .withFile("/go-sdk/dagger.toml", ws.file("/.dagger/modules/engine-e2e/workspace.toml"))
      .withWorkdir("/go-sdk")
      .withExec(["git", "init", "-q"])
    let initGo = ["dagger", "--auto-apply", "module", "init", "go"]
    let help = base.withExec(["dagger", "module", "init", "go", "--help"],
      experimentalPrivilegedNesting: true, expect: ReturnType.ANY)
    let flags = help.stdout + help.stderr
    assert("module init go does not list the SDK's settings as flags:\n" + flags) {
      help.exitCode == 0 and flags.contains("--target-version") and
        flags.contains("--client-version") == false and flags.contains("--fat") == false
    }
    [["--client-version", "v1.0.0-beta.20"], ["--fat"]].map { flag =>
      let refused = base.withExec(initGo + ["--name", "removed-flag", "--path", outputRoot + "/removed-flag"] + flag,
        experimentalPrivilegedNesting: true, expect: ReturnType.ANY)
      let output = refused.stdout + refused.stderr
      assert("the CLI accepted " + flag.join(" ") + ":\n" + output) {
        refused.exitCode != 0 and output.contains("unknown flag: " + (flag[0] ?? ""))
      }
    }

    let stale = "clientVersion = \"v1.0.0-beta.20\"\nfat = true\n"
    let modulePath = outputRoot + "/removed-module-settings"
    let scopePath = outputRoot + "/removed-scope-settings"
    let scope = "sdks.go.scopes." + JSON.encode(scopePath)
    let configured = base.withNewFile("dagger.toml", base.file("dagger.toml").contents +
      "\n[modules.go-sdk.settings]\n" + stale +
      "\n[" + scope + "]\nis-module = true\n\n[" + scope + ".settings]\n" + stale + "targetVersion = \"v1.0.0-beta.20\"\n")
    [[modulePath, sdkTarget], [scopePath, "v1.0.0-beta.20"]].map { expected =>
      let path = expected[0] ?? ""
      let release = expected[1] ?? ""
      let generated = configured.withExec(initGo + ["--name", "removed-settings", "--path", path],
        experimentalPrivilegedNesting: true, expect: ReturnType.ANY)
      assert("generation with stale settings failed for " + path + ":\n" + generated.stdout + generated.stderr) {
        generated.exitCode == 0
      }
      let module = generated.directory(path)
      assert("a stale fat wrote dagger.json in " + path) {
        module.exists("dagger.json") == false
      }
      assert("the library of " + path + " is not pinned to " + release + ":\n" + module.file("go.mod").contents) {
        module.file("go.mod").contents.contains("dagger.io/dagger " + release + "\n")
      }
    }
    null
  }

  """
  The unit tests of every helper pass. The entrypoint contract check embeds
  Dang, whose parser needs cgo.
  """
  helperTestsCheck(ws: Workspace!): Void @check {
    let base = container
      .from("golang:1.26-alpine")
      .withoutEntrypoint
      .withExec(["apk", "add", "--no-cache", "build-base"])
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withDirectory("/src", ws.directory("."))
    let out = ["cmd/dagger-go-sdk-codegen", "helpers/module-codegen", "helpers/render-template", "helpers/entrypoint-contract"].reduce(base) { ctr, helper =>
      ctr
        .withWorkdir("/src/" + helper)
        .withExec(["go", "test", "./..."])
    }.stdout

    null
  }
}
