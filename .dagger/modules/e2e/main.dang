"""End-to-end checks for the Go SDK module provider."""
type E2e {
  let fixtureRoot: String! = ".dagger/modules/e2e/fixtures"
  let outputRoot: String! = ".dagger/modules/e2e/out"
  let clientTargetPath: String! = fixtureRoot + "/client/dep"
  let secondClientTargetPath: String! = fixtureRoot + "/client/app"
  # Dagger Go library source used by the generated-client compile check.
  let daggerSourceRef: String! = "44f87a32cf6aceb807c02bebde03ccb0e3fd014e"

  let assert(condition: Boolean!, message: String!): Void {
    if (condition == false) {
      raise message
    }
    null
  }

  let assertContains(value: String!, want: String!, message: String!): Void {
    assert(value.contains(want), message)
  }

  let exists(ws: Workspace!, path: String!): Boolean! {
    ws.directory(".", include: [path]).exists(path)
  }

  """Scope detection returns the nearest parent Go module."""
  detectScopeCheck(ws: Workspace!): Void @check {
    let scopePath = fixtureRoot + "/client/existing"
    let nested = ws.withWorkdir(scopePath)

    let detected = goSdk.detectScope(nested)
    assert(detected == scopePath, "detectScope returned " + detected + ", expected " + scopePath)
    null
  }

  """A new module gets current and legacy manifests, starter source, and generated Go code."""
  moduleInitCheck(ws: Workspace!): Void @check {
    let scopePath = outputRoot + "/module-init"
    let input = ws
      .withNewFile(scopePath + "/user.txt", "keep me\n")
      .withWorkdir(scopePath)
    let generated = goSdk.generateScope(
      ws: input,
      isModule: true,
      name: "module-init",
      clients: [],
    )

    assert(exists(generated, "dagger-module.toml"), "module manifest was not created")
    assert(exists(generated, "dagger.json"), "legacy module manifest was not created")
    assert(exists(generated, "main.go"), "starter source was not created")
    assert(exists(generated, "dagger.gen.go"), "module adapter was not generated")
    assert(exists(generated, "internal/dagger/dagger.gen.go"), "aggregate client package was not generated")
    assertContains(generated.file("dagger-module.toml").contents, "name = \"module-init\"", "manifest name is wrong")
    assertContains(generated.file("dagger-module.toml").contents, "engineVersion = \"v", "manifest engine version is missing")
    assertContains(generated.file("dagger-module.toml").contents, "source = \"go\"", "manifest runtime is wrong")
    assert(generated.file("dagger-module.toml").contents.contains("source = \".\"") == false, "manifest has an unexpected module source")
    assertContains(generated.file("dagger.json").contents, "\"name\": \"module-init\"", "legacy manifest name is wrong")
    assertContains(generated.file("dagger.json").contents, "\"engineVersion\": \"v", "legacy manifest engine version is missing")
    assertContains(generated.file("dagger.json").contents, "\"source\": \"go\"", "legacy manifest runtime is wrong")
    assert(generated.file("dagger.json").contents.contains("\"source\": \".\"") == false, "legacy manifest has an unexpected module source")
    assertContains(generated.file("user.txt").contents, "keep me", "existing file was not preserved")
    null
  }

  """Module clients become inputs to the existing module generator."""
  moduleClientCheck(ws: Workspace!): Void @check {
    let goScopePath = fixtureRoot + "/go-scope"
    let scopePath = goScopePath + "/module-client"
    let input = ws
      .withNewDirectory(scopePath, directory)
      .withWorkdir(scopePath)
    let target = ws.moduleSource("/" + clientTargetPath)
    let initialized = goSdk.generateScope(
      ws: input,
      isModule: true,
      name: "module-client",
      clients: [],
    )
    let generated = goSdk.generateScope(
      ws: initialized,
      isModule: true,
      name: "module-client",
      clients: [target],
    )

    assert(
      exists(generated, "internal/dagger/client-dep.gen.go"),
      "module client binding was not generated",
    )
    assert(
      exists(
        generated.withWorkdir(goScopePath),
        "internal/dagger/clients/client-dep/client-dep.gen.go",
      ),
      "standalone module client was not generated",
    )
    assertContains(
      generated.file("dagger-module.toml").contents,
      "name = \"client-dep\"",
      "module client was not saved in the manifest",
    )
    assertContains(
      generated.file("dagger-module.toml").contents,
      "source = \"../../client/dep\"",
      "module client source is wrong in the current manifest",
    )
    assertContains(
      generated.file("dagger.json").contents,
      "\"source\": \"../../client/dep\"",
      "module client source is wrong in the legacy manifest",
    )
    null
  }

  """The generate skip marker protects codegen but not generated manifests."""
  moduleSkipCheck(ws: Workspace!): Void @check {
    let scopePath = fixtureRoot + "/skip/app"
    let input = ws
      .withNewFile(scopePath + "/dagger-module.toml", "name = \"module-skip\"\nengineVersion = \"latest\"\ndisableDefaultFunctionCaching = true\n\n[runtime]\nsource = \"go\"\n")
      .withNewFile(scopePath + "/internal/dagger/clients/keep.txt", "keep me\n")
      .withWorkdir(scopePath)
    let generated = goSdk.generateScope(
      ws: input,
      isModule: true,
      name: "module-skip",
      clients: [],
    )

    assert(exists(generated, "internal/dagger/clients/keep.txt"), "skip marker removed existing files")
    assert(exists(generated, "dagger.gen.go") == false, "skip marker generated module code")
    assert(exists(generated, "dagger.json"), "manifest builder did not create the legacy manifest")
    assertContains(generated.file("dagger-module.toml").contents, "engineVersion = \"v", "manifest engine version was not regenerated")
    assert(generated.file("dagger-module.toml").contents.contains("disableDefaultFunctionCaching") == false, "manifest preserved an old setting")
    null
  }

  """A client-only scope writes one target package under internal/dagger/clients."""
  standaloneClientCheck(ws: Workspace!): Void @check {
    let scopePath = fixtureRoot + "/go-scope"
    let input = ws
      .withNewFile(scopePath + "/go.mod", "module example.com/app\n\ngo 1.25\n")
      .withNewFile(scopePath + "/user.go", "package app\n")
      .withWorkdir(scopePath)
    let target = ws.moduleSource("/" + clientTargetPath)
    let secondTarget = ws.moduleSource("/" + secondClientTargetPath)
    let generated = goSdk.generateScope(
      ws: input,
      isModule: false,
      name: "standalone-client",
      clients: [target, secondTarget],
    )
    let targetPath = "internal/dagger/clients/client-dep"
    let secondTargetPath = "internal/dagger/clients/client-app"

    assert(exists(generated, targetPath + "/dagger.gen.go"), "core client code was not generated")
    assert(exists(generated, targetPath + "/client-dep.gen.go"), "target client code was not generated")
    assert(exists(generated, targetPath + "/dag/dag.gen.go"), "dag package was not generated")
    assert(exists(generated, targetPath + "/go.mod") == false, "target client created a nested go.mod")
    assert(exists(generated, secondTargetPath + "/client-app.gen.go"), "second target client was not generated")
    assertContains(
      generated.file(targetPath + "/dagger.gen.go").contents,
      "ModuleSource(\"/" + clientTargetPath + "\")",
      "local target path was not preserved",
    )
    assertContains(generated.file("go.mod").contents, "dagger.io/dagger", "scope go.mod was not updated")
    assert(exists(generated, "user.go"), "user source was not preserved")

    let regenerated = goSdk.generateScope(
      ws: generated,
      isModule: false,
      name: "standalone-client",
      clients: [target, secondTarget],
    )
    assert(regenerated.changes(generated).isEmpty, "standalone client regeneration was not stable")
    null
  }

  """Two standalone target packages compile in one Go module."""
  standaloneClientCompilesCheck(ws: Workspace!): Void @check {
    let scopePath = fixtureRoot + "/go-scope"
    let input = ws
      .withNewFile(scopePath + "/go.mod", "module example.com/compile\n\ngo 1.25\n")
      .withNewFile(scopePath + "/main.go", "package compile\n")
      .withWorkdir(scopePath)
    let generated = goSdk.generateScope(
      ws: input,
      isModule: false,
      name: "standalone-compile",
      clients: [
        ws.moduleSource("/" + clientTargetPath),
        ws.moduleSource("/" + secondClientTargetPath),
      ],
    )
    let out = container
      .from("golang:1.26-alpine")
      .withoutEntrypoint
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withDirectory(
        "/dagger-sdk",
        git("https://github.com/dagger/dagger")
          .commit(daggerSourceRef)
          .tree
          .directory("sdk/go"),
      )
      .withDirectory("/src", generated.directory("."))
      .withWorkdir("/src")
      .withExec(["go", "mod", "edit", "-replace", "dagger.io/dagger=/dagger-sdk"])
      .withExec(["go", "mod", "tidy"])
      .withExec(["go", "build", "./..."])
      .stdout

    null
  }

  """Regeneration preserves existing generated and user-owned client packages."""
  standaloneClientPreservationCheck(ws: Workspace!): Void @check {
    let scopePath = fixtureRoot + "/go-scope"
    let input = ws
      .withNewFile(scopePath + "/go.mod", "module example.com/preservation\n\ngo 1.25\n")
      .withNewFile(scopePath + "/user.go", "package preservation\n")
      .withNewFile(scopePath + "/internal/dagger/clients/custom/user.go", "package custom\n")
      .withWorkdir(scopePath)
    let target = ws.moduleSource("/" + clientTargetPath)
    let withClient = goSdk.generateScope(
      ws: input,
      isModule: false,
      name: "standalone-preservation",
      clients: [target],
    )
    let withoutClient = goSdk.generateScope(
      ws: withClient,
      isModule: false,
      name: "standalone-preservation",
      clients: [],
    )

    assert(exists(withoutClient, "internal/dagger/clients/client-dep/dagger.gen.go"), "regeneration deleted generated client code")
    assert(exists(withoutClient, "internal/dagger/clients/custom/user.go"), "regeneration deleted user-owned client code")
    assert(exists(withoutClient, "user.go"), "regeneration deleted user source")
    null
  }

  """The client code generator unit tests pass."""
  helperTestsCheck(ws: Workspace!): Void @check {
    let out = container
      .from("golang:1.25-alpine")
      .withoutEntrypoint
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withDirectory("/helpers", ws.directory("helpers"))
      .withWorkdir("/helpers/codegen")
      .withExec(["go", "test", "./..."])
      .stdout

    null
  }
}
