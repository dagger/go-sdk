"""
Exercise the SDK directly against a host Workspace. Before beta.25 the
engine's SDK provider loader imports the whole workspace before calling it,
so `dagger generate` cannot isolate SDK upload behavior on the floor engine.
"""
type UploadDriver {
  generate(
    ws: Workspace!, scope: String! = ".", name: String! = "ignored-app",
    isModule: Boolean! = false, entrypoint: Boolean! = true, clients: [String!]! = [],
  ): Changeset! {
    let generated = goSdk(dangEntrypoint: entrypoint, unifiedClients: false).generateScope(
      ws: ws.withWorkdir(scope), isModule: isModule, name: name,
      clients: clients.map { path => ws.moduleSource(path) },
    )
    generated.withWorkdir(".").changes(ws.withWorkdir("."))
  }
}
