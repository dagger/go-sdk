"""Check automatic Go compilation input discovery and required workspaces."""
type WorkspaceInputsChecks {
  let root: String! = ".dagger/modules/e2e/fixtures/include"
  let appPath: String! = root + "/app"

  let generated(ws: Workspace!): Workspace! {
    goSdk(dangEntrypoint: true).generateScope(
      ws: ws.withWorkdir(appPath), isModule: true, name: "include-app", clients: [],
    )
  }

  generateCheck(ws: Workspace!): Void @check {
    let ready = generated(ws)
    let entrypoint = ready.file("internal/dagger/entrypoint/main.dang").contents
    assert("entrypoint still declares resources") { !entrypoint.contains("pub resources") }
    ["workspace.glob", "include: selected", "--inventory", "dispatch(workspace)"].each { text =>
      assert("entrypoint lacks " + text) { entrypoint.contains(text) }
    }
    assert("author source changed") {
      ready.file("main.go").contents == ws.file("/" + appPath + "/main.go").contents
    }
    let repeated = generated(ready.withWorkdir("."))
    assert("generation is not idempotent") { repeated.changes(ready).isEmpty }
    null
  }

  refusalsCheck(ws: Workspace!): Void @check {
    let main = "/" + appPath + "/main.go"
    let missing = ws.withNewFile(main, ws.file(main).contents.replace("Greeting(ws *dagger.Workspace)", "Greeting()"))
    let message = generated(missing).file("dagger.gen.go").contents rescue { err: Error => err.message }
    assert("missing workspace was accepted: " + message) { message.contains("required ws *dagger.Workspace") }
    null
  }

  fixture(ws: Workspace!): Directory! {
    generated(ws).directory("/" + root)
  }
}
