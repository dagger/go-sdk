"""
The release a module's generated code targets: the SDK's own release by
default, or the older release the targetVersion setting pins.
"""
type TargetChecks {
  let outputRoot: String! = ".dagger/modules/e2e/out"
  let dependencyPath: String! = ".dagger/modules/e2e/fixtures/target/dep"
  let probePath: String! = ".dagger/modules/e2e/fixtures/target/probe/main.go"
  let floor: String! = "v1.0.0-beta.18"

  """The release this Go SDK is built for: defaultTarget in go-sdk.dang."""
  let sdkTarget: String! = "v1.0.0-beta.24"

  let pins(ws: Workspace!, release: String!): Boolean! {
    ws.file("go.mod").contents.contains("dagger.io/dagger " + release + "\n")
  }

  """The generated entrypoint declares the release to the module's process."""
  let declares(ws: Workspace!, release: String!): Boolean! {
    ws.file("internal/dagger/entrypoint/main.dang").contents.contains(
      "\n      .withEnvVariable(\"DAGGER_MODULE_CALL_DIGEST\", callDigest ?? \"\")\n      .withEnvVariable(\"DAGGER_CLIENT_VERSION\", " + JSON.encode(release) + ")\n      .withExec(\n")
  }

  """
  Serve the generated module from a nested client and return the data of
  one query, so the engine runs the module's generated code.
  """
  let called(ws: Workspace!, scopePath: String!, query: String!): String! {
    let ran = container.from("golang:1.26-alpine").withoutEntrypoint
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withDirectory("/workspace", ws.directory("/", exclude: ["**/.git"]))
      .withFile("/probe/main.go", ws.file("/" + probePath))
      .withWorkdir("/workspace/" + scopePath)
      .withEnvVariable("GOFLAGS", "-mod=mod")
      .withEnvVariable("MODULE_PATH", scopePath)
      .withEnvVariable("QUERY", query)
      .withExec(["go", "run", "-buildvcs=false", "/probe/main.go"],
        experimentalPrivilegedNesting: true, expect: ReturnType.ANY)
    if (ran.exitCode != 0) {
      raise "the generated module failed:\n" + ran.stdout + ran.stderr
    }
    ran.stdout
  }

  """
  A first generation targets the SDK's release whatever engine runs it,
  pins the library to that release, declares it to the module's process,
  writes no version into the manifest, and changes nothing when run again.
  The engine runs the starter, which builds on the release's core types.
  """
  defaultCheck(ws: Workspace!): Void @check {
    let name = "target-default"
    let scopePath = outputRoot + "/" + name
    let input = ws.withNewDirectory(scopePath, directory).withWorkdir(scopePath)
    let first = goSdk.generateScope(ws: input, isModule: true, name: name, clients: [])
    assert("the library is not pinned to the SDK's release:\n" + first.file("go.mod").contents) {
      pins(first, sdkTarget)
    }
    assert("the entrypoint does not declare the SDK's release:\n" + first.file("internal/dagger/entrypoint/main.dang").contents) {
      declares(first, sdkTarget)
    }
    assert("the target reached the manifest") {
      first.file("dagger-module.toml").contents.contains("engineVersion") == false
    }
    let again = goSdk.generateScope(ws: first, isModule: true, name: name, clients: [])
    assert("generating again changed files") { again.changes(first).isEmpty }
    let out = called(first, scopePath, "query($ws:ID!){targetDefault(ws:$ws){container{withExec(args:[\"cat\",\"/etc/alpine-release\"]){stdout}}}}")
    assert("the starter did not run on the SDK's release: " + out) { out.contains("\"stdout\":\"3.21.") }
    null
  }

  """
  The setting pins an older release, in the v form without build metadata,
  and the running engine plays no part: generating again with the same
  setting changes nothing. Without the setting, the module returns to the
  SDK's release; nothing of the pin is read back from the generated code.
  """
  pinCheck(ws: Workspace!): Void @check {
    let name = "target-pin"
    let scopePath = outputRoot + "/" + name
    let input = ws.withNewDirectory(scopePath, directory).withWorkdir(scopePath)
    let pinned = goSdk(targetVersion: "1.0.0-beta.20+0123abcd").generateScope(ws: input, isModule: true, name: name, clients: [])
    assert("the library is not pinned to the setting:\n" + pinned.file("go.mod").contents) {
      pins(pinned, "v1.0.0-beta.20") and declares(pinned, "v1.0.0-beta.20")
    }
    let kept = goSdk(targetVersion: "v1.0.0-beta.20").generateScope(ws: pinned, isModule: true, name: name, clients: [])
    assert("generating again with the same pin changed files") { kept.changes(pinned).isEmpty }
    let unpinned = goSdk.generateScope(ws: kept, isModule: true, name: name, clients: [])
    assert("removing the setting did not return to the SDK's release:\n" + unpinned.file("go.mod").contents) {
      pins(unpinned, sdkTarget) and declares(unpinned, sdkTarget)
    }
    null
  }

  """
  A dependency client aliases the core types of the targeted release, read
  from the running engine's view of the dependency, and compiles against
  the pinned library; generating again on the same engine changes nothing.
  On the SDK's release, the engine runs the module, which calls the
  dependency and returns its core object. An older pin aliases the same way.
  """
  dependencyCheck(ws: Workspace!): Void @check {
    let name = "target-dependency"
    let scopePath = outputRoot + "/" + name
    let input = ws
      .withNewFile(scopePath + "/go.mod", "module example.com/target-dependency\n\ngo 1.26.1\n")
      .withNewFile(scopePath + "/main.go", "package target_dependency\n\nimport (\n\t\"context\"\n\n\t\"dagger.io/dagger/core\"\n\tdep \"example.com/target-dependency/internal/dagger/clients/target-dep\"\n)\n\ntype TargetDependency struct{}\n\nfunc (*TargetDependency) Greet(ctx context.Context) (string, error) {\n\treturn dep.New().Greet(ctx, \"target\")\n}\n\nfunc (*TargetDependency) Box() *core.Container {\n\treturn dep.New().Box(\"target\")\n}\n")
      .withWorkdir(scopePath)
    let dependency = ws.moduleSource("/" + dependencyPath)
    let generated = goSdk.generateScope(ws: input, isModule: true, name: name, clients: [dependency])
    assert("the library is not pinned to the SDK's release:\n" + generated.file("go.mod").contents) {
      pins(generated, sdkTarget)
    }
    let clientPath = "internal/dagger/clients/target-dep/dagger.gen.go"
    let client = generated.file(clientPath).contents
    assert("the dependency client does not alias core:\n" + client) {
      client.contains("type Container = core.Container\n")
    }
    let again = goSdk.generateScope(ws: generated, isModule: true, name: name, clients: [dependency])
    assert("generating again changed files") { again.changes(generated).isEmpty }
    let out = called(generated, scopePath, "{targetDependency{greet box{file(path:\"/value\"){contents}}}}")
    assert("the module did not call its dependency on the SDK's release: " + out) {
      out.contains("\"greet\":\"hello target\"") and out.contains("\"contents\":\"target\"")
    }

    let pinned = goSdk(targetVersion: "v1.0.0-beta.20").generateScope(ws: generated, isModule: true, name: name, clients: [dependency])
    assert("the library is not pinned to the setting:\n" + pinned.file("go.mod").contents) {
      pins(pinned, "v1.0.0-beta.20")
    }
    assert("the pinned dependency client does not alias core:\n" + pinned.file(clientPath).contents) {
      pinned.file(clientPath).contents.contains("type Container = core.Container\n")
    }
    null
  }

  """
  The library is pinned to exactly the target: a go.mod requirement that
  needs a later library is refused with that requirement named, until the
  target is raised to what it needs.
  """
  mismatchCheck(ws: Workspace!): Void @check {
    let name = "target-mismatch"
    let root = outputRoot + "/" + name
    let scopePath = root + "/app"
    let input = ws
      .withNewFile(scopePath + "/go.mod", "module example.com/app\n\ngo 1.26.1\n\nrequire example.com/lib v0.0.0\n\nreplace example.com/lib => ./lib\n\nreplace dagger.io/dagger v1.0.0-beta.20 => dagger.io/dagger v1.0.0-beta.20\n")
      .withNewFile(scopePath + "/main.go", "package app\n\nimport \"example.com/lib/greet\"\n\ntype App struct{}\n\nfunc (*App) Greeting() string { return greet.Greeting() }\n")
      .withNewFile(scopePath + "/lib/go.mod", "module example.com/lib\n\ngo 1.26.1\n\nrequire dagger.io/dagger " + sdkTarget + "\n")
      .withNewFile(scopePath + "/lib/greet/greet.go", "package greet\n\nfunc Greeting() string { return \"hello\" }\n")
      .withWorkdir(scopePath)
    let mismatch = " targets Dagger v1.0.0-beta.20, and example.com/lib v0.0.0 requires dagger.io/dagger " + sdkTarget +
      ": set targetVersion to " + sdkTarget + " or later in the scope's settings in dagger.toml, or require a version of example.com/lib that needs dagger.io/dagger v1.0.0-beta.20 or earlier"
    expectRefusal(goSdk(targetVersion: "v1.0.0-beta.20"), input, name, "module " + JSON.encode(name) + mismatch)
    let raised = goSdk.generateScope(ws: input, isModule: true, name: name, clients: [])
    assert("the library is not pinned to the raised target:\n" + raised.file("go.mod").contents) {
      pins(raised, sdkTarget)
    }

    # A scope without a module pins its clients' library the same way, and
    # checks it after its own tidy.
    let scope = goSdk(targetVersion: "v1.0.0-beta.20", dangEntrypoint: false, unifiedClients: false).generateScope(
      ws: input, isModule: false, name: name, clients: [ws.moduleSource("/" + dependencyPath)],
    ).file("go.mod").contents rescue { err: Error => err.message }
    assert("a scope without a module did not refuse the raised library:\n" + scope) {
      scope.contains("scope " + JSON.encode(scopePath) + mismatch)
    }
    null
  }

  """
  A Dang entrypoint with embedded bindings targets the SDK's release
  whatever engine runs it, as unified bindings do, and declares it to the
  module's process; generating again changes nothing. The targetVersion
  setting pins an older release the same way. The generated module loads.
  """
  embeddedCheck(ws: Workspace!): Void @check {
    let name = "target-embedded"
    let scopePath = outputRoot + "/" + name
    let input = ws.withNewDirectory(scopePath, directory).withWorkdir(scopePath)
    let first = goSdk(unifiedClients: false).generateScope(ws: input, isModule: true, name: name, clients: [])
    assert("the bindings are not embedded") {
      first.file("internal/dagger/dagger.gen.go").contents.contains("GraphQLClient() graphql.Client")
    }
    assert("the embedded entrypoint does not declare the SDK's release:\n" + first.file("internal/dagger/entrypoint/main.dang").contents) {
      declares(first, sdkTarget)
    }
    let again = goSdk(unifiedClients: false).generateScope(ws: first, isModule: true, name: name, clients: [])
    assert("generating again changed files") { again.changes(first).isEmpty }
    let loaded = first.withWorkdir(".").moduleSource("/" + scopePath).introspectionSchemaJSON.contents
    assert("the generated module did not load") { loaded.contains("\"__schema\"") }
    let pinned = goSdk(unifiedClients: false, targetVersion: "v1.0.0-beta.20").generateScope(ws: first, isModule: true, name: name, clients: [])
    assert("the embedded entrypoint does not declare the setting:\n" + pinned.file("internal/dagger/entrypoint/main.dang").contents) {
      declares(pinned, "v1.0.0-beta.20")
    }
    null
  }

  """
  A new Go runtime manifest declares the SDK's release, not the running
  engine's; an existing manifest keeps the engineVersion it declares.
  """
  runtimeCheck(ws: Workspace!): Void @check {
    let name = "target-runtime"
    let scopePath = outputRoot + "/" + name
    let input = ws.withNewDirectory(scopePath, directory).withWorkdir(scopePath)
    let sdk = goSdk(dangEntrypoint: false, unifiedClients: false)
    let first = sdk.generateScope(ws: input, isModule: true, name: name, clients: [])
    assert("a new manifest does not declare the SDK's release:\n" + first.file("dagger-module.toml").contents) {
      first.file("dagger-module.toml").contents.contains("engineVersion = \"" + sdkTarget + "\"\n")
    }
    let declared = "name = \"" + name + "\"\nengineVersion = \"v1.0.0-beta.20\"\n\n[runtime]\n  source = \"go\"\n"
    let kept = sdk.generateScope(ws: first.withNewFile("dagger-module.toml", declared), isModule: true, name: name, clients: [])
    assert("an existing manifest did not keep its engineVersion:\n" + kept.file("dagger-module.toml").contents) {
      kept.file("dagger-module.toml").contents == declared
    }
    null
  }

  """
  Generation refuses a target the SDK cannot generate for and says how to
  fix it: a setting below the floor, above the SDK's release, or not a
  release; and a setting on a Go runtime module.
  """
  refusalsCheck(ws: Workspace!): Void @check {
    let name = "target-refusals"
    let scopePath = outputRoot + "/" + name
    let input = ws.withNewDirectory(scopePath, directory).withWorkdir(scopePath)
    let subject = "module " + JSON.encode(name) + " pins targetVersion "
    let fix = "Set targetVersion between " + floor + " and " + sdkTarget + " in the scope's settings in dagger.toml, or remove it"
    expectRefusal(goSdk(targetVersion: "v1.0.0-beta.17"), input, name,
      subject + "v1.0.0-beta.17, which this release of the Go SDK cannot generate for: it is below " + floor + ", the oldest engine the generated entrypoint loads on. " + fix)
    let above = ", which this release of the Go SDK cannot generate for: it targets " + sdkTarget + " at most. " + fix + ", or install the SDK release built for "
    expectRefusal(goSdk(targetVersion: "v1.0.0-beta.25"), input, name, subject + "v1.0.0-beta.25" + above + "v1.0.0-beta.25")
    expectRefusal(goSdk(targetVersion: "99.0.0"), input, name, subject + "v99.0.0" + above + "v99.0.0")
    let malformed = ", which is not a Dagger release such as " + sdkTarget + ". " + fix
    expectRefusal(goSdk(targetVersion: "latest"), input, name, subject + "\"latest\"" + malformed)
    expectRefusal(goSdk(targetVersion: "v1.0.0-beta..1"), input, name, subject + "\"v1.0.0-beta..1\"" + malformed)
    expectRefusal(goSdk(targetVersion: "v1.0.0-beta.21+???"), input, name, subject + "\"v1.0.0-beta.21+???\"" + malformed)
    expectRefusal(goSdk(targetVersion: sdkTarget, dangEntrypoint: false, unifiedClients: false), input, name,
      "targetVersion applies to a module with a Dang entrypoint; the Go runtime generates this module's code for the engineVersion of its manifest: set dangEntrypoint = true in the module's dagger.toml settings to migrate, or remove targetVersion")
    null
  }

  let expectRefusal(sdk: GoSdk!, input: Workspace!, name: String!, want: String!): Void {
    let got = sdk.generateScope(ws: input, isModule: true, name: name, clients: []).file("dagger-module.toml").contents rescue {
      err: Error => err.message
    }
    assert("generation did not refuse with " + want + ":\n" + got) { got.contains(want) }
    null
  }
}
